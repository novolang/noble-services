// src/battery.nv — the Battery Service (0x180F).
//
// The service holds one characteristic, Battery Level (0x2A19): one octet
// from 0 to 100, the charge left in percent.  A client reads it and may
// configure notifications through the Client Characteristic Configuration
// descriptor that follows the value.
//
//   service declaration
//   Battery Level declaration   (Read, Notify)
//   Battery Level value         (readable, not writable)
//   Client Characteristic Configuration
//
// `add_battery_service` adds the service to a `GattServer` and answers the
// handles; `set_battery_level` stores a new level and answers the
// notification PDU when the client asked for it.  These two are the face the
// BTP session of orbit/ble calls.
//
// `battery_service` is the other face: a value that implements `noble.Service`,
// for a product that hands the Adapter of the package noble a list of services
// (`Adapter.plug`).  The product keeps the value and calls `set_level` on it; the
// pump asks the service for a read of the level, and the service notifies every
// subscriber when the level has changed.

use gatt_server
use noble
use profile_builder

const UUID_BATTERY_SERVICE = 0x180F
const UUID_BATTERY_LEVEL = 0x2A19

// Battery Level is a percentage ([Bluetooth Assigned Numbers]): values
// above 100 are not levels.
const BATTERY_LEVEL_MAX = 100

// The configuration of the service.  `level` is the level the value starts
// at, cut to 100.  `read` is the access a client needs to read the level,
// and `cccd` the access it needs to read and to write the Client
// Characteristic Configuration descriptor; the level is notified only
// while the link grants the write of that descriptor.
struct BatteryConfig
    level: Int
    read: gatt_server.Access
    cccd: gatt_server.Permissions

// A level that any client reads and subscribes to.
fn default_battery_config(level: Int) -> BatteryConfig
    BatteryConfig { level: level,
        read: gatt_server.Access.Open,
        cccd: gatt_server.open_permissions() }

// A level that needs `access` to read and to subscribe to; the descriptor
// stays readable on any link.
fn secured_battery_config(level: Int, access: gatt_server.Access) -> BatteryConfig
    BatteryConfig {
        level: level, read: access,
        cccd: gatt_server.Permissions { read: gatt_server.Access.Open, write: access } }

// The handles of the service: `service` is the declaration, `level` the
// Battery Level value an application passes to `set_battery_level` and
// `cccd` the client's configuration descriptor.
struct BatteryHandles
    service: Int
    level: Int
    cccd: Int

fn cut_level(level: Int) -> Int
    if level < 0
        0
    else
        if level > BATTERY_LEVEL_MAX
            BATTERY_LEVEL_MAX
        else
            level

// Add the Battery Service after the last attribute of `server`.
fn add_battery_service(var db: GattDb,
                       config: BatteryConfig) -> Result<BatteryHandles, profile_builder.ProfileError>
    let service = profile_builder.start_service(var db, gatt_server.le16(UUID_BATTERY_SERVICE))!
    let level = profile_builder.add_value(var db, gatt_server.PROP_READ | gatt_server.PROP_NOTIFY, profile_builder.read_only(config.read),
        gatt_server.le16(UUID_BATTERY_LEVEL), [cut_level(config.level) as u8])!
    let cccd = profile_builder.add_cccd(var db, config.cccd)!
    Ok(BatteryHandles { service: service, level: level, cccd: cccd })

// Store `level` (cut to 100) as the Battery Level and answer the PDUs to
// send: the notification when the client enabled it, none otherwise.
fn set_battery_level(var db: GattDb, var link: AttLink, handles: BatteryHandles, level: Int,
                     now_ms: Int) -> [[u8]]
    let _ = gatt_server.set_value(var db, handles.level, [cut_level(level) as u8])
    gatt_server.send_value(var db, var link, handles.level, now_ms)

// ── The service as a value of the Adapter's list ───────────────────────────

// The service as `Adapter.plug` takes it.  A struct and not a `@value` struct: the Adapter holds it behind `dyn`, which needs the
// tag of a plain struct, and the product keeps the same value to call `set_level` on it.  `sent` is the level a client last
// heard of, so `tick` notifies once for each change.
struct BatteryService
    var attr: noble.Attr
    var level: Int
    var sent: Int

// A Battery Service that reports `level`, cut to 100.
@tier(embedded)
pub fn battery_service(level: Int) -> BatteryService
    let l = cut_level(level)
    BatteryService { attr: noble.Attr { handle: 0, props: 0, cccd: 0 }, level: l, sent: l }

impl BatteryService
    // The new level, cut to 100.  A client that reads gets it at once; a subscriber is notified in the next turn of the pump.
    @tier(embedded)
    fn set_level(var self, level: Int)
        self.level = cut_level(level)

// The one octet of the level, as a value of the API.
@tier(embedded)
fn level_value(level: Int) -> noble.Value
    var v: noble.Value = Vec.new()
    let _ = v.push(level as u8)
    v

impl noble.Service[] for BatteryService
    // The service, with Battery Level readable by any client and notified to those that subscribe.  The level is answered from
    // the module's state (`bind_event`), so the Host holds no copy to keep up to date.
    @tier(embedded)
    fn attach(var self, var h: noble.Host) -> noble.Status [mutate]
        let s = h.add_service(noble.uuid16(UUID_BATTERY_SERVICE))
        if not s.status.is_ok()
            return s.status
        let c = h.add_char(noble.uuid16(UUID_BATTERY_LEVEL), noble.PROP_READ | noble.PROP_NOTIFY,
            noble.Permissions { read: noble.Access.Open, write: noble.Access.Denied }, noble.Access.Open, 1)
        if not c.status.is_ok()
            return c.status
        self.attr = c.attr
        h.bind_event(c.attr)

    // A read of Battery Level is answered with the level; no other event is the service's.
    @tier(embedded)
    fn on_event(var self, ev: noble.Event, var out: noble.Outbox) -> Bool [mutate]
        match ev
            AttrRead(conn, attr, svc) =>
                if attr != self.attr.handle
                    return false
                let _ = out.push(noble.Out.Respond(conn, attr, 0, level_value(self.level)))
                true
            _ => false

    // A level that changed since the last turn is notified to every subscriber.
    @tier(embedded)
    fn tick(var self, now_ms: Int, var out: noble.Outbox) [mutate]
        if self.level == self.sent
            return
        self.sent = self.level
        let _ = out.push(noble.Out.NotifyAll(self.attr, level_value(self.level)))
