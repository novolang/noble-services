// src/generic_health_sensor_client.nv — the Collector side of the Generic
// Health Sensor Service (0x1840): the decoders of its characteristics, the reassembly of
// segmented observations, the requests of the two control points, and the client session.
//
//   Health Sensor Features       0x2BF3   decoded by `ghc_decode_features`
//   Live Health Observations     0x2B8B   segments put together by `ghc_segment_push`, the body
//                                         decoded by `ghc_decode_body`
//   Stored Health Observations   0x2BDD   the same, with a record number: `ghc_decode_stored`
//   Record Access Control Point  0x2A52   requests built by `ghc_racp_request`, indications
//                                         decoded by `ghc_decode_racp`
//   GHS Control Point            0x2BF4   `ghc_start_request`, `ghc_stop_request`,
//                                         `ghc_decode_control_response`
//   Observation Schedule Changed 0x2BF1   decoded by `ghc_decode_schedule`, as is the Observation
//                                         Schedule descriptor; `ghc_decode_range` reads the Valid
//                                         Range and Accuracy descriptor
//
// Features ([GHSS] 3.1) is the Flags octet (bit 0 says the Supported Device Specializations field
// follows; bits 1 to 7 are reserved and `GhcFeatures.reserved` tells them), the Supported
// Observation Types (a count of 1 or more and that many 4-octet MDC codes) and the optional
// specializations (a count of 1 or more and 3-octet entries: a 2-octet code and a version).  The
// value is exactly that long.  The spec's examples of Tables 3.5 and 3.7 are tests.
//
// An observation arrives in segments ([GHSS] 3.2.2.1), each a Segmentation Header (bit 0 First
// Segment, bit 1 Last Segment, bits 2 to 7 the Rolling Segment Counter, which runs on across
// observations) and a part of the body.  `ghc_segment_push` puts the parts together in a
// `GhcAssembly` exactly as the Physical Activity Monitor client does: a first segment is taken at any
// counter, inside an observation each segment has the counter after the one before it (63 to 0), and
// a segment out of sequence, a first segment inside an observation, a segment that is not first when
// none is open and a body over `GHC_BODY_MAX` octets end it with `GHC_SEG_ERROR`.
//
// The Health Observation Body ([GHSS] Table 3.10) is checked octet by octet with
// `generic_health_sensor.ghs_body_error`, which checks the class, the Length, the Flags, every field
// in the order of its table, the Observation Value of the class and the trailing octets; its tests
// carry the five examples of [GHSS] Annex A.  `ghc_decode_body` answers `None` for a body that check
// refuses and otherwise the fields: the class, the Observation Type, the Time Stamp (nine octets of
// Elapsed Time, kept as octets), the duration and the status, the id, the patient, the three code
// lists, the TLV attributes and the Observation Value as octets.  A FLOAT stays the raw 32-bit value.
// The Numeric, Simple discrete and String values have decoders; the Sample array, Compound, TLV and
// bundle values are checked by the body check and handed on as octets.
//
// The Record Access Control Point ([GHSS] 3.4, [GSS] 3.177) is built and answered with the operators
// and the Record Number filter; `ghc_racp_request` refuses an operator or operand the procedure does
// not take.  The errors 0x81 (Command Not Supported), 0xFD, 0xFE and the others arrive as the status of
// a write; `ghc_error_kind` names them.
//
// The decoders keep no state; the ones that return lists allocate and are `@tier(app)`.  The session
// (`ghc_client_*`) runs on `sensor_client.nv`: discover the service, read the Features (required),
// enable the indication of the Features, of the GHS Control Point, the Record Access Control Point and
// the Observation Schedule Changed, and the notification or indication of the Live and the Stored
// Health Observations as the program asks.  The session reads no descriptor, so the schedule and range
// descriptors are decoded from octets the program reads itself.
//
// Satisfies: REQ-BLE-PRFC-021.

use gatt_client
use links
use generic_health_sensor
use sensor_client
use wire

// The longest body a collector puts together, in octets.
const GHC_BODY_MAX = 1024

// What `ghc_segment_push` answers.
const GHC_SEG_MORE = 0
const GHC_SEG_DONE = 1
const GHC_SEG_ERROR = 2

// The kinds of a Record Access Control Point indication.
const GHC_RACP_NUMBER = 1
const GHC_RACP_COMBINED = 2
const GHC_RACP_CODE = 3

// What an ATT error of a write means.
const GHC_ERR_NONE = 0
const GHC_ERR_COMMAND_NOT_SUPPORTED = 1
const GHC_ERR_CCCD = 2
const GHC_ERR_IN_PROGRESS = 3
const GHC_ERR_OUT_OF_RANGE = 4
const GHC_ERR_OTHER = 5

// The Health Sensor Features: the observation types as MDC codes, and the device specializations with their
// versions (empty when the field is not there).  `reserved` says a reserved Flags bit is set.
struct GhcFeatures
    types: [Int]
    spec_codes: [Int]
    spec_versions: [Int]
    reserved: Bool

// The Features in `b`, `None` for a value that is not whole or has a count of 0.
@tier(app)
fn ghc_decode_features(b: [u8]) -> ?GhcFeatures
    if list.len(b) < 2
        return None
    let flags = b[0] as Int
    let n = b[1] as Int
    if n == 0 or list.len(b) < 2 + 4 * n
        return None
    var types: [Int] = []
    for i in 0..n
        list.push(types, wire.get(b, 2 + 4 * i, 4))
    var at = 2 + 4 * n
    var codes: [Int] = []
    var versions: [Int] = []
    if (flags & 1) != 0
        if at >= list.len(b)
            return None
        let m = b[at] as Int
        if m == 0 or list.len(b) < at + 1 + 3 * m
            return None
        for i in 0..m
            list.push(codes, wire.get(b, at + 1 + 3 * i, 2))
            list.push(versions, b[at + 3 + 3 * i] as Int)
        at = at + 1 + 3 * m
    if at != list.len(b)
        return None
    Some(GhcFeatures { types: types, spec_codes: codes, spec_versions: versions, reserved: (flags & 0xFE) != 0 })

// The reassembly of one characteristic's values.
struct GhcAssembly
    var data: [u8]
    var open: Bool
    var next: Int

@tier(app)
fn ghc_assembly_new() -> GhcAssembly
    GhcAssembly { data: [], open: false, next: 0 }

// Take a value `seg` of the Live or the Stored Health Observations: `GHC_SEG_DONE` when it ends an
// observation, whose octets are then `a.data`, `GHC_SEG_MORE` when more follow, `GHC_SEG_ERROR` as the
// header says.
@tier(app)
fn ghc_segment_push(var a: GhcAssembly, seg: [u8]) -> Int
    if list.len(seg) < 2
        a.open = false
        a.data = []
        return GHC_SEG_ERROR
    let header = seg[0] as Int
    let first = (header & 1) != 0
    let last = (header & 2) != 0
    let counter = header >> 2
    if first == a.open or (a.open and counter != a.next)
        a.open = false
        a.data = []
        return GHC_SEG_ERROR
    if first
        a.data = []
    if list.len(a.data) + list.len(seg) - 1 > GHC_BODY_MAX
        a.open = false
        a.data = []
        return GHC_SEG_ERROR
    for k in 1..list.len(seg)
        list.push(a.data, seg[k])
    a.next = (counter + 1) & 63
    a.open = not last
    if last
        return GHC_SEG_DONE
    GHC_SEG_MORE

// One decoded Health Observation Body.  A field that is not in the body is -1 (or empty).  `time_stamp`
// holds the nine octets of the Elapsed Time; `duration` is a raw FLOAT; `value` holds the octets of the
// Observation Value of the class.
struct GhcObservation
    var class_type: Int
    var flags: Int
    var observation_type: Int
    var time_stamp: [u8]
    var duration: Int
    var status: Int
    var observation_id: Int
    var patient: Int
    var supplemental: [Int]
    var derived_from: [Int]
    var member_of: [Int]
    var tlvs: [generic_health_sensor.GhsTlv]
    var value: [u8]

// The count and the 4-octet codes at `at` in `b`.
@tier(app)
fn ghc_codes_at(b: [u8], at: Int) -> [Int]
    var out: [Int] = []
    for i in 0..(b[at] as Int)
        list.push(out, wire.get(b, at + 1 + 4 * i, 4))
    out

// The Health Observation Body in `b`, `None` for a body that `ghs_body_error` refuses.
@tier(app)
fn ghc_decode_body(b: [u8]) -> ?GhcObservation
    if generic_health_sensor.ghs_body_error(b) != generic_health_sensor.BODY_OK
        return None
    let flags = wire.get(b, 3, 2)
    var at = 5
    var o = GhcObservation {
        class_type: b[0] as Int, flags: flags, observation_type: -1, time_stamp: [], duration: -1, status: -1,
        observation_id: -1, patient: -1, supplemental: [], derived_from: [], member_of: [], tlvs: [], value: [] }
    if (flags & generic_health_sensor.FLAG_TYPE) != 0
        o.observation_type = wire.get(b, at, 4)
        at = at + 4
    if (flags & generic_health_sensor.FLAG_TIME_STAMP) != 0
        o.time_stamp = b[at:at + generic_health_sensor.TIME_STAMP_OCTETS]
        at = at + generic_health_sensor.TIME_STAMP_OCTETS
    if (flags & generic_health_sensor.FLAG_DURATION) != 0
        o.duration = wire.get(b, at, 4)
        at = at + 4
    if (flags & generic_health_sensor.FLAG_STATUS) != 0
        o.status = wire.get(b, at, 2)
        at = at + 2
    if (flags & generic_health_sensor.FLAG_ID) != 0
        o.observation_id = wire.get(b, at, 4)
        at = at + 4
    if (flags & generic_health_sensor.FLAG_PATIENT) != 0
        o.patient = b[at] as Int
        at = at + 1
    if (flags & generic_health_sensor.FLAG_SUPPLEMENTAL) != 0
        o.supplemental = ghc_codes_at(b, at)
        at = at + 1 + 4 * (b[at] as Int)
    if (flags & generic_health_sensor.FLAG_DERIVED_FROM) != 0
        o.derived_from = ghc_codes_at(b, at)
        at = at + 1 + 4 * (b[at] as Int)
    if (flags & generic_health_sensor.FLAG_MEMBER_OF) != 0
        o.member_of = ghc_codes_at(b, at)
        at = at + 1 + 4 * (b[at] as Int)
    if (flags & generic_health_sensor.FLAG_TLVS) != 0
        let count = b[at] as Int
        at = at + 1
        for _ in 0..count
            let n = wire.get(b, at + 4, 2)
            list.push(o.tlvs, generic_health_sensor.GhsTlv {
                observation_type: wire.get(b, at, 4), format: b[at + 6] as Int, value: b[at + 7:at + 7 + n] })
            at = at + 7 + n
    o.value = b[at:list.len(b)]
    Some(o)

// A stored observation: its record number and the body.
struct GhcStored
    number: Int
    observation: GhcObservation

// The Stored Health Observations Body in `b`: the 4-octet record number and a Health Observation Body.
@tier(app)
fn ghc_decode_stored(b: [u8]) -> ?GhcStored
    if list.len(b) < 4 + 5
        return None
    match ghc_decode_body(b[4:list.len(b)])
        None => None
        Some(o) => Some(GhcStored { number: wire.get(b, 0, 4), observation: o })

// The Numeric observation value ([GHSS] Table 3.19): `(unit code, raw FLOAT)`; `None` for another length
// and for the FLOAT value reserved for future use.
@tier(embedded)
@no_alloc
fn ghc_decode_numeric(v: [u8]) -> ?(Int, Int)
    if list.len(v) != 6
        return None
    let raw = wire.get(v, 2, 4)
    if not generic_health_sensor.ghs_float_sendable(raw)
        return None
    Some((wire.get(v, 0, 2), raw))

// The Simple discrete observation value (Table 3.20): the MDC code, 4 octets.
@tier(embedded)
@no_alloc
fn ghc_decode_discrete(v: [u8]) -> ?Int
    if list.len(v) != 4
        return None
    Some(wire.get(v, 0, 4))

// The String observation value (Table 3.21): the text, whose 2-octet length is the rest of the value.
@tier(app)
fn ghc_decode_string(v: [u8]) -> ?[u8]
    if list.len(v) < 2 or wire.get(v, 0, 2) != list.len(v) - 2
        return None
    Some(v[2:list.len(v)])

// An Observation Schedule: the MDC code, and the measurement period and the update interval as raw FLOATs
// in seconds (0 for unspecified).
@value
struct GhcSchedule
    observation_type: Int
    period: Int
    interval: Int

// The Observation Schedule Changed value and the Observation Schedule descriptor ([GHSS] Table 3.36):
// 12 octets, the two FLOATs numbers and not negative; `None` otherwise.
@tier(embedded)
@no_alloc
fn ghc_decode_schedule(b: [u8]) -> ?GhcSchedule
    if list.len(b) != 12
        return None
    let period = wire.get(b, 4, 4)
    let interval = wire.get(b, 8, 4)
    if not generic_health_sensor.ghs_float_period(period) or not generic_health_sensor.ghs_float_period(interval)
        return None
    Some(GhcSchedule { observation_type: wire.get(b, 0, 4), period: period, interval: interval })

// The value to write to an Observation Schedule descriptor for `observation_type`; `None` for a period or an
// interval that is not a FLOAT number of 0 or more.
@tier(app)
fn ghc_schedule_value(observation_type: Int, period: Int, interval: Int) -> ?[u8]
    if observation_type < 0 or observation_type > 0xFFFFFFFF
        return None
    if not generic_health_sensor.ghs_float_period(period) or not generic_health_sensor.ghs_float_period(interval)
        return None
    Some(generic_health_sensor.ghs_schedule_value(observation_type, period, interval))

// A Valid Range and Accuracy descriptor: the MDC code of the observation, the unit code, the lower and the
// upper limit and, when `has_accuracy`, the accuracy, as raw FLOATs.
@value
struct GhcRange
    observation_type: Int
    unit_code: Int
    lower: Int
    upper: Int
    has_accuracy: Bool
    accuracy: Int

// The Valid Range and Accuracy descriptor in `b` ([GHSS] Table 3.38): 14 octets, 18 with the accuracy, the
// FLOATs numbers and the lower limit not above the upper one; `None` otherwise.
@tier(embedded)
@no_alloc
fn ghc_decode_range(b: [u8]) -> ?GhcRange
    let n = list.len(b)
    if n != 14 and n != 18
        return None
    let lower = wire.get(b, 6, 4)
    let upper = wire.get(b, 10, 4)
    if not generic_health_sensor.ghs_float_number(lower) or not generic_health_sensor.ghs_float_number(upper)
        return None
    if wire.float_scaled(lower, 6) > wire.float_scaled(upper, 6)
        return None
    var accuracy = 0
    if n == 18
        accuracy = wire.get(b, 14, 4)
        if not generic_health_sensor.ghs_float_number(accuracy)
            return None
    Some(GhcRange {
        observation_type: wire.get(b, 0, 4), unit_code: wire.get(b, 4, 2), lower: lower, upper: upper,
        has_accuracy: n == 18, accuracy: accuracy })

// The GHS Control Point request Start sending live observations, and Stop.
@tier(app)
fn ghc_start_request() -> [u8]
    [generic_health_sensor.OP_START as u8]

@tier(app)
fn ghc_stop_request() -> [u8]
    [generic_health_sensor.OP_STOP as u8]

// Whether `b` is the success indication of the GHS Control Point: the one octet 0x80.
@tier(embedded)
@no_alloc
fn ghc_decode_control_response(b: [u8]) -> Bool
    list.len(b) == 1 and (b[0] as Int) == generic_health_sensor.RESULT_CONTROL_POINT_SUCCESS

// The Record Access Control Point request for the Op Code `op` (Combined Report 7, Report Number of Stored
// Records 4, Delete Stored Records 2 or Abort Operation 3) and the operator `operator` (1 All records, 2 Less
// than or equal to, 3 Greater than or equal to, 4 Within range, 5 First record, 6 Last record; 0 for Abort).
// `low` is the Record Number operand of the operators 2 to 4, `high` the upper bound of 4.  `None` for an
// Op Code or operator the procedure does not take, a record number outside 32 bits and a range of a low
// bound above the high one.
@tier(app)
fn ghc_racp_request(op: Int, operator: Int, low: Int, high: Int) -> ?[u8]
    if op != generic_health_sensor.RACP_COMBINED_REPORT and op != generic_health_sensor.RACP_REPORT_NUMBER and op != generic_health_sensor.RACP_DELETE and op != generic_health_sensor.RACP_ABORT
        return None
    if op == generic_health_sensor.RACP_ABORT
        if operator != generic_health_sensor.OPERATOR_NULL
            return None
        return Some([op as u8, 0])
    if operator < generic_health_sensor.OPERATOR_ALL or operator > generic_health_sensor.OPERATOR_LAST
        return None
    var out: [u8] = [op as u8, operator as u8]
    if operator == generic_health_sensor.OPERATOR_ALL or operator == generic_health_sensor.OPERATOR_FIRST or operator == generic_health_sensor.OPERATOR_LAST
        return Some(out)
    if low < 0 or low > 0xFFFFFFFF
        return None
    list.push(out, generic_health_sensor.FILTER_RECORD_NUMBER as u8)
    wire.put(var out, low, 4)
    if operator == generic_health_sensor.OPERATOR_WITHIN
        if high < low or high > 0xFFFFFFFF
            return None
        wire.put(var out, high, 4)
    Some(out)

// A Record Access Control Point indication: `kind` is one of the `GHC_RACP_` values; `count` the number of
// records of a count response; `request` and `code` the request Op Code and the Response Code Value of a
// response code (1 Success to 10 Server Busy).
@value
struct GhcRacp
    kind: Int
    count: Int
    request: Int
    code: Int

// The Record Access Control Point indication in `b`: Number of Stored Records Response (0x05) and Combined
// Report Response (0x08) with a 4-octet count, Response Code (0x06) for the request Op Codes 2, 3, 4 and 7;
// the operator is 0 in all.  `None` otherwise, a Response Code Value outside 1 to 10 included.
@tier(embedded)
@no_alloc
fn ghc_decode_racp(b: [u8]) -> ?GhcRacp
    if list.len(b) < 2 or (b[1] as Int) != generic_health_sensor.OPERATOR_NULL
        return None
    let op = b[0] as Int
    if op == generic_health_sensor.RACP_NUMBER_RESPONSE or op == generic_health_sensor.RACP_COMBINED_RESPONSE
        if list.len(b) != 6
            return None
        let k = if op == generic_health_sensor.RACP_NUMBER_RESPONSE then GHC_RACP_NUMBER else GHC_RACP_COMBINED
        return Some(GhcRacp { kind: k, count: wire.get(b, 2, 4), request: 0, code: 0 })
    if op == generic_health_sensor.RACP_RESPONSE_CODE
        if list.len(b) != 4
            return None
        let request = b[2] as Int
        let code = b[3] as Int
        if request != generic_health_sensor.RACP_DELETE and request != generic_health_sensor.RACP_ABORT and request != generic_health_sensor.RACP_REPORT_NUMBER and request != generic_health_sensor.RACP_COMBINED_REPORT
            return None
        if code < generic_health_sensor.RESULT_SUCCESS or code > generic_health_sensor.RESULT_SERVER_BUSY
            return None
        return Some(GhcRacp { kind: GHC_RACP_CODE, count: 0, request: request, code: code })
    None

// What the ATT error `status` of a write means: one of the `GHC_ERR_` values.
@tier(embedded)
@no_alloc
fn ghc_error_kind(status: Int) -> Int
    if status == 0
        return GHC_ERR_NONE
    if status == generic_health_sensor.ERR_COMMAND_NOT_SUPPORTED
        return GHC_ERR_COMMAND_NOT_SUPPORTED
    if status == 0xFD
        return GHC_ERR_CCCD
    if status == 0xFE
        return GHC_ERR_IN_PROGRESS
    if status == 0xFF
        return GHC_ERR_OUT_OF_RANGE
    GHC_ERR_OTHER

// A session on `link`: the table row is the program's.
@tier(app)
fn ghc_client_new(link: links.LinkId) -> sensor_client.SensorClient
    sensor_client.sc_new(link, generic_health_sensor.UUID_GENERIC_HEALTH_SENSOR_SERVICE)

// Discover the service, read the Features (required), and enable the indications of the Features, the GHS
// Control Point, the Record Access Control Point and the Observation Schedule Changed and the Live and Stored
// Health Observations by indication (`live_indicate`, `stored_indicate`) or by notification, each optional but
// the Features.  A server sends one way only; the program picks the one its server has.
@tier(app)
fn ghc_client_start(var t: gatt_client.ClientTable, var c: sensor_client.SensorClient, live_indicate: Bool, stored_indicate: Bool, now_ms: Int) -> sensor_client.ScStep
    sensor_client.sc_queue_read(var c, generic_health_sensor.UUID_HEALTH_SENSOR_FEATURES, true)
    sensor_client.sc_queue_subscribe(var c, generic_health_sensor.UUID_HEALTH_SENSOR_FEATURES, gatt_client.CCCD_INDICATE, false)
    sensor_client.sc_queue_subscribe(var c, generic_health_sensor.UUID_GHS_CONTROL_POINT, gatt_client.CCCD_INDICATE, false)
    sensor_client.sc_queue_subscribe(var c, generic_health_sensor.UUID_RECORD_ACCESS_CONTROL_POINT, gatt_client.CCCD_INDICATE, false)
    sensor_client.sc_queue_subscribe(var c, generic_health_sensor.UUID_OBSERVATION_SCHEDULE_CHANGED, gatt_client.CCCD_INDICATE, false)
    sensor_client.sc_queue_subscribe(var c, generic_health_sensor.UUID_STORED_HEALTH_OBSERVATIONS, if stored_indicate then gatt_client.CCCD_INDICATE else gatt_client.CCCD_NOTIFY, false)
    sensor_client.sc_queue_subscribe(var c, generic_health_sensor.UUID_LIVE_HEALTH_OBSERVATIONS, if live_indicate then gatt_client.CCCD_INDICATE else gatt_client.CCCD_NOTIFY, false)
    sensor_client.sc_start(var t, var c, now_ms)

// Write the GHS Control Point (`ghc_start_request`, `ghc_stop_request`).  The session must have finished its plan.
@tier(app)
fn ghc_client_control(var t: gatt_client.ClientTable, var c: sensor_client.SensorClient, request: [u8], now_ms: Int) -> sensor_client.ScStep
    sensor_client.sc_queue_write(var c, generic_health_sensor.UUID_GHS_CONTROL_POINT, request)
    sensor_client.sc_kick(var t, var c, now_ms)

// Write the Record Access Control Point (`ghc_racp_request`).  The session must have finished its plan.
@tier(app)
fn ghc_client_racp(var t: gatt_client.ClientTable, var c: sensor_client.SensorClient, request: [u8], now_ms: Int) -> sensor_client.ScStep
    sensor_client.sc_queue_write(var c, generic_health_sensor.UUID_RECORD_ACCESS_CONTROL_POINT, request)
    sensor_client.sc_kick(var t, var c, now_ms)
