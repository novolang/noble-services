// src/object_list.nv — the list of objects the Object Transfer
// Service presents to a client: the Object List Filter values, the sort orders of
// the Object List Control Point and the Directory Listing Object.
//
// Its builders run at start-up and allocate, so the functions that build lists
// or records carry `@tier(app)`; the others are `@tier(embedded)` and `@no_alloc`.
//
// A client sees the objects of the store through a list: the objects that pass
// its filters, in the order it asked for.  This module holds the rules of that
// list as functions of `ObjectMeta` values, so the rules are tested without a
// service or a store behind them.
//
//   Filters      Three Object List Filter characteristics (OTS 3.5), combined by
//                a logical AND.  A value is a Filter octet and its parameter:
//                0x00 No Filter, 0x01 to 0x04 a name that starts with, ends with,
//                contains or is exactly a UTF-8 string, 0x05 an Object Type
//                UUID, 0x06 and 0x07 created or modified between two Date Time
//                values, 0x08 and 0x09 current or allocated size between two
//                uint32 values, 0x0A the marked objects.  A name is compared
//                byte for byte, so the comparison is case-sensitive.  The two
//                ends of a range are inclusive, the first is at most the second,
//                and an object whose timestamp is not known is not excluded by
//                a timestamp filter.
//   Orders       The List Sort Order of the Order procedure (OTS Table 3.23): by
//                name, type, current size, first-created or last-modified
//                timestamp, 0x01 to 0x05 ascending and 0x11 to 0x15 descending.
//                Names are ordered by the octets of their UTF-8 encoding; the
//                collation of ISO/IEC 14651 that OTS 3.4.1 recommends is NOT
//                IMPLEMENTED.  Two objects that tie come in the order of their
//                Object IDs, whichever way the order runs.
//   Directory    The contents of the Directory Listing Object (OTS 4.1): one
//                Object Record for each object, then the optional fields the
//                service has, with a Length of Object Record that includes
//                its own two octets.
//
// Specification checked against: Object Transfer Service 1.0, Sections 3.4.1,
// 3.5 and 4.1.
//
// Satisfies: REQ-BLE-OTS-004.

use gatt_server
use object_store
use wire

// The Filter values of OTS Table 3.28.
const FILTER_NONE = 0x00
const FILTER_NAME_STARTS = 0x01
const FILTER_NAME_ENDS = 0x02
const FILTER_NAME_CONTAINS = 0x03
const FILTER_NAME_EXACT = 0x04
const FILTER_TYPE = 0x05
const FILTER_CREATED = 0x06
const FILTER_MODIFIED = 0x07
const FILTER_SIZE = 0x08
const FILTER_ALLOCATED = 0x09
const FILTER_MARKED = 0x0A

// The List Sort Order values of OTS Table 3.23; 0x10 is added for descending.
const ORDER_STORE = 0x00
const ORDER_NAME = 0x01
const ORDER_TYPE = 0x02
const ORDER_SIZE = 0x03
const ORDER_CREATED = 0x04
const ORDER_MODIFIED = 0x05
const ORDER_DESCENDING = 0x10

// The Application Error Code of a value the service rejects (OTS 1.10).
const ERR_WRITE_REQUEST_REJECTED = 0x80

// The ATT Error Code of a value of the wrong length.
const ERR_INVALID_LENGTH = 0x0D

// The bits of the Flags octet of an Object Record (OTS Table 4.2).
const RECORD_TYPE_128 = 0x01
const RECORD_CURRENT_SIZE = 0x02
const RECORD_ALLOCATED_SIZE = 0x04
const RECORD_FIRST_CREATED = 0x08
const RECORD_LAST_MODIFIED = 0x10
const RECORD_PROPERTIES = 0x20

// The name of the Directory Listing Object, as OTS 4.1 recommends.
const DIRECTORY_NAME = "Directory"

// ── Filters ─────────────────────────────────────────────────────────

// The Error Code a write of `value` to an Object List Filter characteristic
// gets, 0 when the value may be written: an Invalid Attribute Value Length for
// a parameter of the wrong size, Write Request Rejected for a Filter value that
// is reserved, a range that runs backward, a Date Time out of range or a name
// that is not UTF-8.
@tier(app)
fn filter_write_error(value: [u8]) -> Int
    let n = list.len(value)
    if n == 0
        return ERR_INVALID_LENGTH
    let t = value[0] as Int
    let p = value[1:n]
    let plen = n - 1
    if t == FILTER_NONE or t == FILTER_MARKED
        return if plen == 0 then 0 else ERR_INVALID_LENGTH
    if t >= FILTER_NAME_STARTS and t <= FILTER_NAME_EXACT
        if plen < 1 or plen > NAME_MAX
            return ERR_INVALID_LENGTH
        return if object_store.utf8_valid(p) then 0 else ERR_WRITE_REQUEST_REJECTED
    if t == FILTER_TYPE
        return if object_store.uuid_ok(p) then 0 else ERR_INVALID_LENGTH
    if t == FILTER_CREATED or t == FILTER_MODIFIED
        if plen != 14
            return ERR_INVALID_LENGTH
        let a = p[0:7]
        let b = p[7:14]
        if not object_store.date_time_ok(a) or not object_store.date_time_ok(b)
            return ERR_WRITE_REQUEST_REJECTED
        return if object_store.date_time_key(a) <= object_store.date_time_key(b) then 0 else ERR_WRITE_REQUEST_REJECTED
    if t == FILTER_SIZE or t == FILTER_ALLOCATED
        if plen != 8
            return ERR_INVALID_LENGTH
        return if wire.get(p, 0, 4) <= wire.get(p, 4, 4) then 0 else ERR_WRITE_REQUEST_REJECTED
    ERR_WRITE_REQUEST_REJECTED

// Whether the object `m` passes the filter `f`.  `marked` says whether the
// client has marked the object.  A filter value that is empty or not valid
// passes everything: `filter_write_error` keeps such a value from being stored.
@tier(app)
fn filter_matches(f: [u8], m: ObjectMeta, marked: Bool) -> Bool
    let n = list.len(f)
    if n == 0
        return true
    let t = f[0] as Int
    let p = f[1:n]
    if t == FILTER_NAME_STARTS
        return object_store.starts_with(m.name, p)
    if t == FILTER_NAME_ENDS
        return object_store.ends_with(m.name, p)
    if t == FILTER_NAME_CONTAINS
        return object_store.contains(m.name, p)
    if t == FILTER_NAME_EXACT
        return gatt_server.same_bytes(m.name, p)
    if t == FILTER_TYPE
        return gatt_server.uuid_equal(m.kind, p)
    if t == FILTER_CREATED or t == FILTER_MODIFIED
        if list.len(p) != 14
            return true
        let at = if t == FILTER_CREATED then m.created else m.modified
        if not object_store.date_time_known(at)
            return true
        let k = object_store.date_time_key(at)
        return k >= object_store.date_time_key(p[0:7]) and k <= object_store.date_time_key(p[7:14])
    if t == FILTER_SIZE or t == FILTER_ALLOCATED
        if list.len(p) != 8
            return true
        let s = if t == FILTER_SIZE then m.size else m.allocated
        return s >= wire.get(p, 0, 4) and s <= wire.get(p, 4, 4)
    if t == FILTER_MARKED
        return marked
    true

// Whether the object `m` passes all the filters in `filters`.
@tier(app)
fn filters_match(filters: [[u8]], m: ObjectMeta, marked: Bool) -> Bool
    for f in filters
        if not filter_matches(f, m, marked)
            return false
    true

// ── Orders ──────────────────────────────────────────────────────────

// Whether `order` is a List Sort Order of OTS Table 3.23.
@tier(embedded)
@no_alloc
fn order_valid(order: Int) -> Bool
    (order >= ORDER_NAME and order <= ORDER_MODIFIED) or (order >= ORDER_DESCENDING + ORDER_NAME and order <= ORDER_DESCENDING + ORDER_MODIFIED)

@tier(embedded)
@no_alloc
fn compare_int(a: Int, b: Int) -> Int
    if a < b then -1 else if a > b then 1 else 0

// Whether the object `a` comes before the object `b` in the order `order`.  The
// order of the store (`ORDER_STORE`) puts nothing before anything.
@tier(app)
fn meta_before(a: ObjectMeta, b: ObjectMeta, order: Int) -> Bool
    if order == ORDER_STORE
        return false
    let key = order & 0x0F
    var c = 0
    if key == ORDER_NAME
        c = object_store.bytes_compare(a.name, b.name)
    elif key == ORDER_TYPE
        c = object_store.uuid_compare(a.kind, b.kind)
    elif key == ORDER_SIZE
        c = compare_int(a.size, b.size)
    elif key == ORDER_CREATED
        c = compare_int(object_store.date_time_key(a.created), object_store.date_time_key(b.created))
    elif key == ORDER_MODIFIED
        c = compare_int(object_store.date_time_key(a.modified), object_store.date_time_key(b.modified))
    if c == 0
        return a.id < b.id
    if (order & ORDER_DESCENDING) != 0
        return c > 0
    c < 0

// Put `metas` in the order `order`, stable.  The order of the store leaves the
// list as it is.
@tier(app)
fn sort_metas(var metas: [ObjectMeta], order: Int)
    if order == ORDER_STORE
        return
    let n = list.len(metas)
    for i in 1..n
        let x = metas[i]
        var j = i
        while j > 0 and meta_before(x, metas[j - 1], order)
            metas[j] = metas[j - 1]
            j = j - 1
        metas[j] = x

// ── The Directory Listing Object ────────────────────────────────────

// The Object Record of `m` (OTS Table 4.1): the Length of Object Record, the
// Object ID, the Object Name Length and the name, the Flags, the Object Type,
// then the Current Size, the Allocated Size, the Object First-Created and
// Last-Modified timestamps (when `first_created` and `last_modified` say the
// service has them) and the Object Properties.  The Extension is empty.
@tier(app)
fn directory_record(m: ObjectMeta, first_created: Bool, last_modified: Bool) -> [u8]
    var flags = RECORD_CURRENT_SIZE | RECORD_ALLOCATED_SIZE | RECORD_PROPERTIES
    if list.len(m.kind) == 16
        flags = flags | RECORD_TYPE_128
    if first_created
        flags = flags | RECORD_FIRST_CREATED
    if last_modified
        flags = flags | RECORD_LAST_MODIFIED
    var body: [u8] = []
    wire.put(var body, m.id, 6)
    wire.put(var body, list.len(m.name), 1)
    list.append(body, m.name)
    wire.put(var body, flags, 1)
    list.append(body, m.kind)
    wire.put(var body, m.size, 4)
    wire.put(var body, m.allocated, 4)
    if first_created
        list.append(body, m.created)
    if last_modified
        list.append(body, m.modified)
    wire.put(var body, m.properties, 4)
    var record: [u8] = []
    wire.put(var record, list.len(body) + 2, 2)
    list.append(record, body)
    record

// The contents of the Directory Listing Object for `metas`, in their order:
// the Object Records one after the other.
@tier(app)
fn directory_contents(metas: [ObjectMeta], first_created: Bool, last_modified: Bool) -> [u8]
    var out: [u8] = []
    for m in metas
        list.append(out, directory_record(m, first_created, last_modified))
    out
