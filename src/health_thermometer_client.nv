// src/health_thermometer_client.nv — the Collector side of the Health
// Thermometer Service (0x1809): the decoders of its characteristics and the client
// session.
//
//   Temperature Measurement   0x2A1C   decoded by `ht_decode`; indicated
//   Intermediate Temperature  0x2A1E   decoded by `ht_decode`; notified
//   Temperature Type          0x2A1D   decoded by `ht_decode_type`
//   Measurement Interval      0x2A21   decoded by `ht_decode_interval`, written by
//                                      `ht_client_set_interval`
//   Valid Range               0x2906   decoded by `ht_decode_valid_range`
//
// Layout of a measurement ([GSS] 3.215 and [HTS] 3.1): the flags octet (bit 0 the
// unit, Celsius when clear and Fahrenheit when set; bit 1 a time stamp present; bit 2
// a Temperature Type present; bits 3 to 7 reserved and ignored), the temperature as a
// 32-bit IEEE-11073 FLOAT, then the time stamp as a seven-octet Date Time ([GSS] 3.70)
// and the Temperature Type as one octet, each when its flag is set.  Intermediate
// Temperature has the same layout.
//
// A decoder takes the octets of a value and answers `None` for a value too short for
// the fields its flags name, for a time stamp that is not a Date Time with a month and a
// day ([HTS] 3.1.1.3), and for a length other than the one a fixed-size characteristic
// has.  It allocates nothing and keeps no state.  The temperature stays the raw FLOAT in
// the struct; `ht_temperature_kind` tells a number from a special value (NaN for a
// reading that is not valid) and `ht_milli_celsius` converts a number to thousandths of
// a degree Celsius whatever unit the flag names.  Octets after the fields are not read.
//
// The session (`ht_client_*`) runs on `sensor_client.nv`: discover the service, enable
// the indication of the measurement, enable the notification of the intermediate
// temperature, read the Temperature Type and the Measurement Interval, and enable the
// indication of the interval, each optional where the service makes it so.  The
// session reads no descriptor, so the Valid Range is decoded from octets the program
// reads itself.
//
// Satisfies: REQ-BLE-PRFC-009.

use gatt_client
use links
use health_thermometer
use sensor_client
use wire

// The Temperature Type values are 1 to 9 ([GSS] Table 3.331).
const HT_TYPE_FIRST = 1
const HT_TYPE_LAST = 9

// The size of a time stamp, of a Valid Range and of an interval, in octets.
const HT_TIME_SIZE = 7
const HT_RANGE_SIZE = 4
const HT_INTERVAL_SIZE = 2

// One decoded measurement.  `temperature` is the raw FLOAT, `fahrenheit` the unit of the
// flag.  `time` is the time stamp when `has_time`; `temperature_type` is the octet of the
// value when `has_type` and 0 otherwise.
@value
struct HtMeasurement
    temperature: Int
    fahrenheit: Bool
    has_time: Bool
    time: wire.DateTime
    has_type: Bool
    temperature_type: Int

// The measurement in `b`, `None` when `b` is not a whole measurement.
@tier(embedded)
@no_alloc
fn ht_decode(b: [u8]) -> ?HtMeasurement
    if list.len(b) < 5
        return None
    let flags = b[0] as Int
    var at = 5
    let has_time = (flags & health_thermometer.FLAG_TIME_STAMP) != 0
    let has_type = (flags & health_thermometer.FLAG_TEMPERATURE_TYPE) != 0
    var stamp = wire.date_time_unknown()
    if has_time
        if list.len(b) < at + HT_TIME_SIZE
            return None
        stamp = wire.get_date_time(b, at)
        if not wire.date_time_valid(stamp) or stamp.month == 0 or stamp.day == 0
            return None
        at = at + HT_TIME_SIZE
    var kind = 0
    if has_type
        if list.len(b) < at + 1
            return None
        kind = b[at] as Int
    Some(HtMeasurement {
        temperature: wire.get(b, 1, 4), fahrenheit: (flags & health_thermometer.FLAG_FAHRENHEIT) != 0,
        has_time: has_time, time: stamp, has_type: has_type, temperature_type: kind })

// What the temperature of `m` holds: one of the `wire.KIND_` values.
@tier(embedded)
@no_alloc
fn ht_temperature_kind(m: HtMeasurement) -> Int
    wire.float_kind(m.temperature)

// `n / d` rounded once, halves away from zero.
@tier(embedded)
@no_alloc
fn ht_div_round(n: Int, d: Int) -> Int
    if n < 0
        return -((-n + d / 2) / d)
    (n + d / 2) / d

// The temperature of `m` in thousandths of a degree Celsius; a Fahrenheit value is converted.
// 0 for a special value, which `ht_temperature_kind` tells apart.
@tier(embedded)
@no_alloc
fn ht_milli_celsius(m: HtMeasurement) -> Int
    let milli = wire.float_scaled(m.temperature, 3)
    if not m.fahrenheit
        return milli
    ht_div_round((milli - 32000) * 5, 9)

// Whether the measurement holds a reading: the temperature is a number.
@tier(embedded)
@no_alloc
fn ht_has_reading(m: HtMeasurement) -> Bool
    wire.float_kind(m.temperature) == wire.KIND_NUMBER

// The Temperature Type in `b`: one octet of 1 to 9, `None` otherwise.
@tier(embedded)
@no_alloc
fn ht_decode_type(b: [u8]) -> ?Int
    if list.len(b) != 1
        return None
    let t = b[0] as Int
    if t < HT_TYPE_FIRST or t > HT_TYPE_LAST
        return None
    Some(t)

// The Measurement Interval in `b`, in seconds (0 for no periodic measurement): two octets, `None` otherwise.
@tier(embedded)
@no_alloc
fn ht_decode_interval(b: [u8]) -> ?Int
    if list.len(b) != HT_INTERVAL_SIZE
        return None
    Some(wire.get(b, 0, 2))

// The Valid Range of the interval ([GSS] 3.126): the lower and the upper bound in seconds, four
// octets, `None` for another length or a lower bound above the upper one.
@tier(embedded)
@no_alloc
fn ht_decode_valid_range(b: [u8]) -> ?(Int, Int)
    if list.len(b) != HT_RANGE_SIZE
        return None
    let lo = wire.get(b, 0, 2)
    let hi = wire.get(b, 2, 2)
    if lo > hi
        return None
    Some((lo, hi))

// The value to write to the Measurement Interval for `seconds`, limited to 0 to 65535.
@tier(app)
fn ht_interval_value(seconds: Int) -> [u8]
    var out: [u8] = []
    wire.put(var out, wire.clamp(seconds, 0, 65535), 2)
    out

// A session on `link`: the table row is the program's.
@tier(app)
fn ht_client_new(link: links.LinkId) -> sensor_client.SensorClient
    sensor_client.sc_new(link, health_thermometer.UUID_HEALTH_THERMOMETER_SERVICE)

// Discover the service, enable the indication of the measurement (required), the notification of the
// intermediate temperature (optional), read the type and the interval (optional) and enable the
// indication of the interval (optional).
@tier(app)
fn ht_client_start(var t: gatt_client.ClientTable, var c: sensor_client.SensorClient, now_ms: Int) -> sensor_client.ScStep
    sensor_client.sc_queue_subscribe(var c, health_thermometer.UUID_TEMPERATURE_MEASUREMENT, gatt_client.CCCD_INDICATE, true)
    sensor_client.sc_queue_subscribe(var c, health_thermometer.UUID_INTERMEDIATE_TEMPERATURE, gatt_client.CCCD_NOTIFY, false)
    sensor_client.sc_queue_read(var c, health_thermometer.UUID_TEMPERATURE_TYPE, false)
    sensor_client.sc_queue_read(var c, health_thermometer.UUID_MEASUREMENT_INTERVAL, false)
    sensor_client.sc_queue_subscribe(var c, health_thermometer.UUID_MEASUREMENT_INTERVAL, gatt_client.CCCD_INDICATE, false)
    sensor_client.sc_start(var t, var c, now_ms)

// Write the Measurement Interval.  The session must have finished its plan.
@tier(app)
fn ht_client_set_interval(var t: gatt_client.ClientTable, var c: sensor_client.SensorClient, seconds: Int, now_ms: Int) -> sensor_client.ScStep
    sensor_client.sc_queue_write(var c, health_thermometer.UUID_MEASUREMENT_INTERVAL, ht_interval_value(seconds))
    sensor_client.sc_kick(var t, var c, now_ms)
