// tests/bond_management_client_tests.nv — the unit tests of src/bond_management_client.nv.
//
//   novo test tests/bond_management_client_tests.nv

use std.test
use fixtures
use gatt_client
use gatt_server
use links
use bond_management
use device_information_client
use fixtures.{ peer }
use sensor_client
use wire
use bond_management_client.{ BM_ERR_AUTHORIZATION, BM_ERR_NONE, BM_ERR_OPERATION_FAILED, BM_ERR_OP_CODE_NOT_SUPPORTED, BM_ERR_OTHER, BmFeature, bm_client_delete, bm_client_new, bm_client_start, bm_decode_feature, bm_error_kind, bm_feature_needs_code, bm_feature_reserved, bm_feature_supports, bm_request, bm_request_for }

@tier(app)
fn octets(v: [Int]) -> [u8]
    wire.octets(v)

@tier(app)
fn must(b: [u8]) -> BmFeature
    match bm_decode_feature(b)
        Some(f) => f
        None =>
            test.fail("a feature")
            BmFeature { bits: 0, octets: 0 }

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_every_feature_bit_of_table_3_5_maps_to_its_operation()
    // Octet, bit, Op Code, with a code: the rows of Table 3.5 in order.
    let rows = [
        [0, 0, 1, 0], [0, 1, 1, 1], [0, 2, 2, 0], [0, 3, 2, 1], [0, 4, 3, 0], [0, 5, 3, 1],
        [0, 6, 4, 0], [0, 7, 4, 1], [1, 0, 5, 0], [1, 1, 5, 1], [1, 2, 6, 0], [1, 3, 6, 1],
        [1, 4, 7, 0], [1, 5, 7, 1], [1, 6, 8, 0], [1, 7, 8, 1], [2, 0, 9, 0], [2, 1, 9, 1]]
    for r in rows
        var v: [Int] = [0, 0, 0]
        v[r[0]] = 1 << r[1]
        let f = must(octets(v[0:r[0] + 1]))
        for op in 1..10
            test.assert_eq(bm_feature_supports(f, op), op == r[2])
            test.assert_eq(bm_feature_needs_code(f, op), op == r[2] and r[3] == 1)
        test.assert(not bm_feature_reserved(f))

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_the_feature_of_the_default_server_and_its_lengths()
    // The default server of bond_management.nv: LE operations without a code.
    let f = must(octets([0x10, 0x04, 0x01]))
    test.assert(bm_feature_supports(f, 3))
    test.assert(bm_feature_supports(f, 6))
    test.assert(bm_feature_supports(f, 9))
    test.assert(not bm_feature_supports(f, 1))
    test.assert(not bm_feature_needs_code(f, 3))
    test.assert_eq(f.octets, 3)
    // A single octet is a whole value; the missing octets read as 0.
    let one = must(octets([0x20]))
    test.assert(bm_feature_needs_code(one, 3))
    test.assert(not bm_feature_supports(one, 6))
    test.assert_eq(one.octets, 1)
    // Octets past the third are kept in the length and not read.
    let long = must(octets([0x10, 0x04, 0x01, 0xFF, 0xFF]))
    test.assert_eq(long.bits, 0x010410)
    test.assert_eq(long.octets, 5)
    test.assert_eq(bm_decode_feature([]), None)

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_reserved_feature_bits_and_op_codes()
    test.assert(bm_feature_reserved(must(octets([0, 0, 0x04]))))
    test.assert(bm_feature_reserved(must(octets([0, 0, 0x80]))))
    test.assert(not bm_feature_reserved(must(octets([0xFF, 0xFF, 0x03]))))
    let all = must(octets([0xFF, 0xFF, 0x03]))
    test.assert(not bm_feature_supports(all, 0))
    test.assert(not bm_feature_supports(all, 10))
    test.assert(not bm_feature_supports(all, 255))
    test.assert(not bm_feature_needs_code(all, 0))
    test.assert(not bm_feature_needs_code(all, 10))

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_a_request_is_the_op_code_and_a_utf8_code()
    test.assert_eq(bm_request(3, []), Some(octets([3])))
    test.assert_eq(bm_request(6, wire.text("1234")), Some(octets([6, 0x31, 0x32, 0x33, 0x34])))
    test.assert_eq(bm_request(9, []), Some(octets([9])))
    // Reserved Op Codes.
    test.assert_eq(bm_request(0, []), None)
    test.assert_eq(bm_request(10, []), None)
    test.assert_eq(bm_request(255, []), None)
    // 511 octets is the longest code; 512 is refused.
    var big: [u8] = []
    for _ in 0..511
        list.push(big, 0x37)
    test.assert_eq(list.len(bm_request(1, big)!), 512)
    list.push(big, 0x37)
    test.assert_eq(bm_request(1, big), None)
    // A code that is not UTF-8: a lone continuation octet, a truncated sequence, and a NUL tail.
    test.assert_eq(bm_request(1, octets([0x80])), None)
    test.assert_eq(bm_request(1, octets([0xC3])), None)
    test.assert_eq(bm_request(1, octets([0x31, 0])), None)
    // A well-formed multi-octet character is a code.
    test.assert_eq(bm_request(1, octets([0xC3, 0xA9])), Some(octets([1, 0xC3, 0xA9])))

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_a_request_checked_against_the_feature()
    // Operation 6 with a code, operation 9 without.
    let f = must(octets([0x00, 0x08, 0x01]))
    test.assert_eq(bm_request_for(f, 6, wire.text("42")), Some(octets([6, 0x34, 0x32])))
    test.assert_eq(bm_request_for(f, 6, []), None)
    test.assert_eq(bm_request_for(f, 9, []), Some(octets([9])))
    test.assert_eq(bm_request_for(f, 3, []), None)
    test.assert_eq(bm_request_for(f, 0, []), None)

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_the_errors_of_a_request_are_named()
    test.assert_eq(bm_error_kind(0), BM_ERR_NONE)
    test.assert_eq(bm_error_kind(0x80), BM_ERR_OP_CODE_NOT_SUPPORTED)
    test.assert_eq(bm_error_kind(0x08), BM_ERR_AUTHORIZATION)
    test.assert_eq(bm_error_kind(0x81), BM_ERR_OPERATION_FAILED)
    test.assert_eq(bm_error_kind(0x03), BM_ERR_OTHER)
    test.assert_eq(bm_error_kind(0x100), BM_ERR_OTHER)

// The policy of the test server: it records the scopes and answers `accept`.
struct Tag
    var scopes: [Int]
    var accept: Bool

impl bond_management.BmsPolicy[] for Tag
    @tier(app)
    fn delete_bonds(var self, peer: links.LinkId, scope: Int) -> Bool
        list.push(self.scopes, scope)
        self.accept

// Carry `first` to the server through `bms_receive`, which evaluates the Control Point writes; the
// answers go back to the session.  The events are or-ed.
@tier(app)
fn bms_pump(var t: gatt_client.ClientTable, var c: sensor_client.SensorClient, var s: gatt_server.GattServer, h: bond_management.BmsHandles, config: bond_management.BmsConfig, var tag: Tag, first: sensor_client.ScStep) -> Int [mutate]
    var all = first.event
    var pending = first.pdus[:]
    for _ in 0..60
        if list.len(pending) == 0
            break
        var next: [[u8]] = []
        for item in pending
            for a in bond_management.bms_receive(var s.db, var s.link, h, config, var tag, peer(), item[:], 0)
                let step = sensor_client.sc_on_pdu(var t, var c, a, 0)
                list.append(next, step.pdus[:])
                all = all | step.event
        pending = next
    all

@tier(app)
fn test_server(config: bond_management.BmsConfig) -> (gatt_server.GattServer, bond_management.BmsHandles)
    var s = gatt_server.new_server([], 65)
    let h = bond_management.add_bms_service(var s.db, config)!
    gatt_server.set_security(var s.link, gatt_server.link_security(true, 3, 16, true))
    (s, h)

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_session_reads_the_feature_and_writes_requests()
    if not fixtures.client_engine_present()
        return
    let config = bond_management.default_bms_config()
    var built = test_server(config)
    var s = built.0
    let h = built.1
    let both = sensor_client.test_open(bond_management.UUID_BOND_MANAGEMENT_SERVICE)
    var t = both.0
    var c = bm_client_new(sensor_client.test_link())
    var tag = Tag { scopes: [], accept: true }
    let all = bms_pump(var t, var c, var s, h, config, var tag, bm_client_start(var t, var c, 0))
    test.assert((all & sensor_client.SE_DONE) != 0)
    test.assert_eq((all & sensor_client.SE_FAILED), 0)
    test.assert_eq(sensor_client.sc_handle(var t, c, bond_management.UUID_BOND_MANAGEMENT_FEATURE), h.feature as Int)
    test.assert_eq(sensor_client.sc_handle(var t, c, bond_management.UUID_BOND_MANAGEMENT_CONTROL_POINT), h.control_point as Int)
    let f = must(sensor_client.sc_value(c))
    test.assert(bm_feature_supports(f, 3) and bm_feature_supports(f, 6) and bm_feature_supports(f, 9))
    // A request the Feature allows reaches the policy with its scope.
    let w = bms_pump(var t, var c, var s, h, config, var tag, bm_client_delete(var t, var c, 6, [], 0))
    test.assert((w & sensor_client.SE_DONE) != 0)
    test.assert_eq(tag.scopes, [bond_management.SCOPE_ALL])
    // A reserved Op Code is not written.
    let bad = bm_client_delete(var t, var c, 0x0A, [], 0)
    test.assert((bad.event & sensor_client.SE_FAILED) != 0)
    test.assert_eq(list.len(bad.pdus), 0)
    test.assert_eq(list.len(tag.scopes), 1)

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_the_errors_of_the_server_reach_the_session()
    if not fixtures.client_engine_present()
        return
    let config = bond_management.BmsConfig {
        delete_all: false, delete_all_but_active: false, authorization_code: wire.text("1234"),
        access: gatt_server.Access.Authenticated }
    var built = test_server(config)
    var s = built.0
    let h = built.1
    let both = sensor_client.test_open(bond_management.UUID_BOND_MANAGEMENT_SERVICE)
    var t = both.0
    var c = bm_client_new(sensor_client.test_link())
    var tag = Tag { scopes: [], accept: false }
    let _ = bms_pump(var t, var c, var s, h, config, var tag, bm_client_start(var t, var c, 0))
    test.assert(bm_feature_needs_code(must(sensor_client.sc_value(c)), 3))
    // An Op Code the server does not support.
    let a = bms_pump(var t, var c, var s, h, config, var tag, bm_client_delete(var t, var c, 6, wire.text("1234"), 0))
    test.assert((a & sensor_client.SE_FAILED) != 0)
    test.assert_eq(bm_error_kind(sensor_client.sc_status(c)), BM_ERR_OP_CODE_NOT_SUPPORTED)
    // A code that does not match.
    let b = bms_pump(var t, var c, var s, h, config, var tag, bm_client_delete(var t, var c, 3, wire.text("1235"), 0))
    test.assert((b & sensor_client.SE_FAILED) != 0)
    test.assert_eq(bm_error_kind(sensor_client.sc_status(c)), BM_ERR_AUTHORIZATION)
    // The right code, and the policy declines.
    let d = bms_pump(var t, var c, var s, h, config, var tag, bm_client_delete(var t, var c, 3, wire.text("1234"), 0))
    test.assert((d & sensor_client.SE_FAILED) != 0)
    test.assert_eq(bm_error_kind(sensor_client.sc_status(c)), BM_ERR_OPERATION_FAILED)
    test.assert_eq(tag.scopes, [bond_management.SCOPE_REQUESTING])

@test
@satisfies("REQ-BLE-PRFC-018")
fn test_a_peer_without_the_service_ends_the_plan_not_found()
    var empty = gatt_server.new_server([], 65)
    let both = sensor_client.test_open(bond_management.UUID_BOND_MANAGEMENT_SERVICE)
    var t = both.0
    var c = bm_client_new(sensor_client.test_link())
    var seen: [Int] = []
    let all = sensor_client.test_pump(var t, var c, var empty, bm_client_start(var t, var c, 0), var seen)
    test.assert((all & sensor_client.SE_FAILED) != 0)
    test.assert_eq(sensor_client.sc_status(c), sensor_client.SC_NOT_FOUND)
