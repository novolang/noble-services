    test.assert_eq(list.len(late.pdus), 1)
    test.assert_eq(late.pdus[0][3], 0x03)

@test
fn test_responses_of_the_server_are_classified_as_rap_asks()
    if not fixtures.client_engine_present()
        return
    var p = paired(false)
    var t = p.0
    var c = p.1
    // Procedure Not Completed goes to the application, not as a fatal error; Invalid Parameter closes the link.
    let h = p.3
    let ind = fn_cp_indication(h, [0x02, 0x06])
    let a = ranging_client.ras_client_on_pdu(var t, var c, ind, 0)
    test.assert((a.event & ranging_client.RE_ERROR) != 0)
    test.assert_eq(c.error, 6)
    test.assert_eq(c.fatal, false)
    let b = ranging_client.ras_client_on_pdu(var t, var c, fn_cp_indication(h, [0x02, 0x03]), 0)
    test.assert((b.event & ranging_client.RE_ERROR) != 0)
    test.assert_eq(c.fatal, true)
    // A Response Code Value reserved for future use is ignored.
    c.fatal = false
    c.error = 0
    let r = ranging_client.ras_client_on_pdu(var t, var c, fn_cp_indication(h, [0x02, 0x20]), 0)
    test.assert_eq(r.event & ranging_client.RE_ERROR, 0)

@tier(app)
fn fn_cp_indication(h: ranging_service.RasHandles, value: [Int]) -> [u8]
    var pdu: [u8] = [0x1D, (h.control_point & 0xFF) as u8, (h.control_point >>> 8) as u8]
    for v in value
        list.push(pdu, v as u8)
    pdu

@test
fn test_an_overwritten_indication_reaches_the_application()
    if not fixtures.client_engine_present()
        return
    var p = paired(false)
    var t = p.0
    var c = p.1
    let h = p.3
    var pdu: [u8] = [0x1D, (h.overwritten & 0xFF) as u8, (h.overwritten >>> 8) as u8, 0x34, 0x02]
    let step = ranging_client.ras_client_on_pdu(var t, var c, pdu, 0)
    test.assert((step.event & ranging_client.RE_OVERWRITTEN) != 0)
    test.assert_eq(c.overwritten_counter, 0x234)

@test
fn test_a_peer_without_the_service_ends_the_session_not_found()
    var empty = gatt_server.new_server([], 65)
    var t = gatt_client.new_table()
    test.assert(gatt_client.open(var t, sensor_client.test_link()))
    var c = ranging_client.ras_client_new(sensor_client.test_link(), false)
    let first = ranging_client.ras_client_start(var t, var c, 0)
    var all = first.event
    var pending = first.pdus[:]
    for _ in 0..30
        if list.len(pending) == 0
            break
        var next: [[u8]] = []
        for p in pending
            for a in gatt_server.receive(var empty.db, var empty.link, p[:], 0)
                let step = ranging_client.ras_client_on_pdu(var t, var c, a[:], 0)
                all = all | step.event
                for q in step.pdus
                    list.push(next, q[:])
        pending = next
    test.assert((all & ranging_client.RE_ERROR) != 0)
    test.assert_eq(c.error, sensor_client.SC_NOT_FOUND)

// ── The profile ─────────────────────────────────────────────────────

@test
fn test_the_responder_adds_the_service_and_advertises_its_uuid()
    var s = gatt_server.new_server([], 65)
    let r = ranging_profile.rrsp_new(var s.db, open_config())!
    test.assert_eq(gatt_server.handle_of_type(s.db, gatt_server.le16(ranging_service.UUID_RAS_FEATURES)), r.h.features)
    // A Complete List of 16-bit Service UUIDs with 0x185B.
    test.assert_eq(ranging_profile.rrsp_advertising_data(), [3, 0x03, 0x5B, 0x18])
    test.assert_eq(ranging_profile.RAP_MTU_MIN, 247)

@test
fn test_the_responder_answers_the_writes_the_link_took()
    var s = gatt_server.new_server([], 65)
    var r = ranging_profile.rrsp_new(var s.db, open_config())!
    fixtures.subscribe(var s, r.h.ondemand_cccd, 2)
    fixtures.subscribe(var s, r.h.ready_cccd, 2)
    fixtures.subscribe(var s, r.h.control_point_cccd, 2)
    let ready = ranging_profile.rrsp_on_result(var r, var s.db, var s.link, result_of(0x234, false, 2), 0, 0)
    test.assert_eq(list.len(ready), 1)
    let _ = confirm_all(var s, ready)
    let _ = write_cp(var s, r.h, [0x00, 0x34, 0x02])
    let out = confirm_all(var s, ranging_profile.rrsp_on_write(var r, var s.db, var s.link, 5))
    test.assert(list.len(out) >= 2)
    // Nothing more was written.
    test.assert_eq(list.len(ranging_profile.rrsp_on_write(var r, var s.db, var s.link, 6)), 0)
    test.assert_eq(ranging_profile.rrsp_tick(var r, 5000), -1)
    test.assert_eq(ranging_profile.rrsp_tick(var r, 16000), 0x234)

@test
fn test_the_two_results_of_a_procedure_are_paired_step_for_step()
    let local = result_of(0x234, true, 4)
    let body = ranging_data.ras_body_build(result_of(0x234, false, 4), -2)
    var pair = ranging_profile.rap_pair_new()
    test.assert_eq(ranging_profile.rap_pair(local, body, false, false, var pair), ranging_profile.PAIR_OK)
    test.assert_eq(pair.common, 5)
    test.assert_eq(pair.hdr.selected_tx_power, -2)
    // The peer's steps take the channels of the local ones.
    test.assert_eq(pair.peer.steps[0].channel, 4)
    test.assert_eq(pair.peer.steps[1].channel, 6)
    test.assert_eq(pair.peer.steps[4].channel, 12)
    test.assert_eq(pair.peer.steps[2].mode, 2)

@test
fn test_a_pair_is_refused_for_another_procedure_or_other_steps()
    let local = result_of(0x234, true, 4)
    var pair = ranging_profile.rap_pair_new()
    // Another Ranging Counter.
    test.assert_eq(ranging_profile.rap_pair(local, ranging_data.ras_body_build(result_of(0x235, false, 4), 0), false, false, var pair), ranging_profile.PAIR_COUNTER_MISMATCH)
    // A body that does not read.
    test.assert_eq(ranging_profile.rap_pair(local, [1, 2, 3], false, false, var pair), ranging_profile.PAIR_BODY_UNREADABLE)
    // A peer with fewer steps pairs on the steps both have.
    test.assert_eq(ranging_profile.rap_pair(local, ranging_data.ras_body_build(result_of(0x234, false, 2), 0), false, false, var pair), ranging_profile.PAIR_OK)
    test.assert_eq(pair.common, 3)

@test
fn test_the_requester_checks_the_level_against_the_two_records()
    let none = hci_cs.cs_caps_none()
    test.assert_eq(ranging_profile.rreq_level_ok(1, none, none), true)
    test.assert_eq(ranging_profile.rreq_level_ok(2, none, none), false)

@tier(app)
fn result_of_two(initiator: Bool, first: Int, second: Int) -> hci_cs.HciCsProcResult
    var res = hci_cs.cs_proc_result_new()
    var ev = hci_cs.cs_result_event_new()
    test.assert_eq(hci_cs.cs_read_result(result_event(0x234, initiator, first, false), var ev), true)
    test.assert_eq(hci_cs.cs_proc_add(var res, ev), 0)
    test.assert_eq(hci_cs.cs_read_result(result_event(0x234, initiator, second, true), var ev), true)
    test.assert_eq(hci_cs.cs_proc_add(var res, ev), 0)
    res

@test
fn test_the_pair_is_made_subevent_by_subevent()
    // The local Controller ran 4 tone steps in each of two subevents, the peer only 2 in the first.
    let local = result_of_two(true, 4, 4)
    let body = ranging_data.ras_body_build(result_of_two(false, 2, 4), 0)
    var pair = ranging_profile.rap_pair_new()
    test.assert_eq(ranging_profile.rap_pair(local, body, false, false, var pair), ranging_profile.PAIR_OK)
    test.assert_eq(pair.local.n_sub, 2)
    test.assert_eq(pair.peer.n_sub, 2)
    // The mode 0 step and 2 tones of the first subevent, the mode 0 step and 4 of the second.
    test.assert_eq(pair.common, 3 + 5)
    // The peer's second subevent starts at its fourth step and takes the channels of the local second subevent, which starts at its sixth.
    test.assert_eq(pair.peer.subs[1].first, 3)
    test.assert_eq(pair.local.subs[1].first, 5)
    test.assert_eq(pair.peer.steps[3].channel, pair.local.steps[5].channel)
    test.assert_eq(pair.peer.steps[7].channel, pair.local.steps[9].channel)
