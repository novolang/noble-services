// ── The client against the server ───────────────────────────────────

// Carry PDUs between the client and the server until neither has more; the events the client saw are or-ed together.  `drop` is the position, among the
// server's data PDUs of the on-demand characteristic, of one to lose on the way (-1 for none).
@tier(app)
fn exchange(var t: gatt_client.ClientTable, var c: ranging_client.RasClient, var s: gatt_server.GattServer, h: ranging_service.RasHandles,
            from_client: [[u8]], from_server: [[u8]], drop: Int, now_ms: Int) -> Int [mutate]
    var events = 0
    var to_server = from_client[:]
    var to_client = from_server[:]
    var data_seen = 0
    for _ in 0..200
        if list.len(to_server) == 0 and list.len(to_client) == 0
            break
        var next_server: [[u8]] = []
        var next_client: [[u8]] = []
        for p in to_server
            for a in gatt_server.receive(var s.db, var s.link, p[:], now_ms)
                list.push(next_client, a[:])
        for p in to_client
            var lost = false
            if (p[0] == 0x1B or p[0] == 0x1D) and ((p[1] as Int) | ((p[2] as Int) << 8)) == h.ondemand
                if data_seen == drop
                    lost = true
                data_seen = data_seen + 1
            if not lost
                let step = ranging_client.ras_client_on_pdu(var t, var c, p[:], now_ms)
                events = events | step.event
                for q in step.pdus
                    list.push(next_server, q[:])
        to_server = next_server
        to_client = next_client
    events

// A client and a server with the setup done.
@tier(app)
fn paired(realtime: Bool) -> (gatt_client.ClientTable, ranging_client.RasClient, gatt_server.GattServer, ranging_service.RasHandles, ranging_service.RasServer)
    var built = server_with(open_config())
    var s = built.0
    let h = built.1
    var t = gatt_client.new_table()
    test.assert(gatt_client.open(var t, sensor_client.test_link()))
    var c = ranging_client.ras_client_new(sensor_client.test_link(), realtime)
    let first = ranging_client.ras_client_start(var t, var c, 0)
    let ev = exchange(var t, var c, var s, h, first.pdus, [], -1, 0) | first.event
    test.assert((ev & ranging_client.RE_SETUP) != 0)
    test.assert_eq(ev & ranging_client.RE_ERROR, 0)
    (t, c, s, h, ranging_service.ras_server_new(open_config()))

@test
fn test_the_client_discovers_reads_the_features_and_subscribes()
