    test.assert_eq(confirm_all(var s, cp_response(var srv, var s, h, [0x02, 0x34, 0x02, 0, 0], 5))[0][3:], [0x02, 0x03])

@test
fn test_the_control_point_answers_what_it_does_not_take()
    var built = on_demand_server()
    var s = built.0
    let h = built.1
    var srv = built.2
    // Set_Filter: not supported.  Another op code: not supported.  A wrong length: invalid parameter.  Abort: success.
    test.assert_eq(confirm_all(var s, cp_response(var srv, var s, h, [0x04, 0x01, 0x00], 0))[0][3:], [0x02, 0x02])
    test.assert_eq(confirm_all(var s, cp_response(var srv, var s, h, [0x09], 0))[0][3:], [0x02, 0x02])
    test.assert_eq(confirm_all(var s, cp_response(var srv, var s, h, [0x00, 0x34], 0))[0][3:], [0x02, 0x03])
    test.assert_eq(confirm_all(var s, cp_response(var srv, var s, h, [0x03], 0))[0][3:], [0x02, 0x01])
    test.assert_eq(confirm_all(var s, cp_response(var srv, var s, h, [0x03, 0x00], 0))[0][3:], [0x02, 0x03])
    test.assert_eq(srv.aborted, true)

@test
fn test_a_command_while_indications_are_pending_is_answered_server_busy()
    var built = on_demand_server()
    var s = built.0
    let h = built.1
    var srv = built.2
    let _ = confirm_all(var s, ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, result_of(0x234, false, 6), 0, 0))
    // The segments are sent and not confirmed: a second Get finds the server busy.
    let first = cp_response(var srv, var s, h, [0x00, 0x34, 0x02], 0)
    test.assert_eq(list.len(first) >= 1, true)
    let busy = cp_response(var srv, var s, h, [0x00, 0x34, 0x02], 1)
    test.assert_eq(list.len(busy), 0)
    let all = confirm_all(var s, first)
    // The Server Busy response is queued behind the transfer.
    var found = false
    for p in all
        if list.len(p) == 5 and p[3] == 0x02 and p[4] == 0x07
            found = true
    test.assert_eq(found, true)

@test
fn test_a_procedure_stored_over_the_limit_deletes_the_oldest_and_announces_it()
    var built = on_demand_server()
    var s = built.0
    let h = built.1
    var srv = built.2
    let _ = confirm_all(var s, ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, result_of(1, false, 1), 0, 0))
    let _ = confirm_all(var s, ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, result_of(2, false, 1), 0, 0))
    test.assert_eq(ranging_service.ras_stored(srv), [1, 2])
    // The third has no room: the first, unread, is overwritten, and the client hears of it before the new Ready.
    let all = confirm_all(var s, ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, result_of(3, false, 1), 0, 0))
    test.assert_eq(list.len(all), 2)
    test.assert_eq(all[0][1] as Int | ((all[0][2] as Int) << 8), h.overwritten)
    test.assert_eq(all[0][3:], [1, 0])
    test.assert_eq(all[1][1] as Int | ((all[1][2] as Int) << 8), h.ready)
    test.assert_eq(all[1][3:], [3, 0])
    test.assert_eq(ranging_service.ras_stored(srv), [2, 3])
    // A body that was fetched is deleted without the announcement.
    let _ = confirm_all(var s, cp_response(var srv, var s, h, [0x00, 0x02, 0x00], 0))
    let again = confirm_all(var s, ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, result_of(4, false, 1), 0, 0))
    test.assert_eq(list.len(again), 1)
    test.assert_eq(again[0][3:], [4, 0])
    test.assert_eq(ranging_service.ras_stored(srv), [3, 4])

@test
fn test_the_server_deletes_what_the_client_did_not_acknowledge_after_ten_seconds()
    var built = on_demand_server()
    var s = built.0
    let h = built.1
    var srv = built.2
    let _ = confirm_all(var s, ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, result_of(5, false, 1), 0, 0))
    let _ = confirm_all(var s, cp_response(var srv, var s, h, [0x00, 0x05, 0x00], 1000))
    test.assert_eq(ranging_service.ras_tick(var srv, 5000), -1)
    test.assert_eq(ranging_service.ras_tick(var srv, 11000), -1)
    test.assert_eq(ranging_service.ras_tick(var srv, 11001), 5)
    test.assert_eq(list.len(ranging_service.ras_stored(srv)), 0)
    // A closed link flushes everything.
    let _ = ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, result_of(6, false, 1), 0, 0)
    ranging_service.ras_flush(var srv)
    test.assert_eq(list.len(ranging_service.ras_stored(srv)), 0)

