    test.assert_eq(ranging_client.ras_client_supports(p.1, ranging_service.RAS_FEATURE_RETRIEVE_LOST), true)
    test.assert_eq(ranging_client.ras_client_supports(p.1, ranging_service.RAS_FEATURE_FILTER), false)
    test.assert_eq(ranging_service.ras_mode(p.2.db, p.2.link, p.3), ranging_service.RAS_MODE_ONDEMAND)
    test.assert_eq(gatt_server.configuration(p.2.link, p.3.ready_cccd), 2)
    test.assert_eq(gatt_server.configuration(p.2.link, p.3.overwritten_cccd), 2)
    test.assert_eq(gatt_server.configuration(p.2.link, p.3.control_point_cccd), 2)

@test
fn test_a_ready_indication_makes_the_client_write_get_ranging_data()
    if not fixtures.client_engine_present()
        return
    var p = paired(false)
    var t = p.0
    var c = p.1
    var s = p.2
    let h = p.3
    var srv = p.4
    let sent = ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, result_of(0x234, false, 6), -4, 10)
    let ev = exchange(var t, var c, var s, h, [], sent, -1, 10)
    test.assert((ev & ranging_client.RE_DATA_READY) != 0)
    test.assert_eq(ev & ranging_client.RE_ERROR, 0)
    test.assert_eq(c.ready_counter, 0x234)
    // The Get_Ranging_Data for that counter is the write the server took.
    let changed = gatt_server.take_changed(var s.link)
    test.assert_eq(ranging_service.ras_control_point_written(h, changed), true)
    test.assert_eq(ranging_service.written(s.db, s.link, h.control_point), [0x00, 0x34, 0x02])

// The server handles the writes the client made: the Get_Ranging_Data after the Ready, and the ACK after the body.
@tier(app)
fn serve(var t: gatt_client.ClientTable, var c: ranging_client.RasClient, var s: gatt_server.GattServer, h: ranging_service.RasHandles,
         var srv: ranging_service.RasServer, first: [[u8]], drop: Int, now_ms: Int) -> Int [mutate]
    var events = exchange(var t, var c, var s, h, [], first, drop, now_ms)
    for _ in 0..8
        let changed = gatt_server.take_changed(var s.link)
        if not ranging_service.ras_control_point_written(h, changed)
            break
        let out = ranging_service.ras_handle_control_point(var srv, var s.db, var s.link, h, now_ms)
        events = events | exchange(var t, var c, var s, h, [], out, drop, now_ms)
    events

@test
fn test_a_full_on_demand_session_with_the_server_handling_the_writes()
    if not fixtures.client_engine_present()
        return
    var p = paired(false)
    var t = p.0
    var c = p.1
    var s = p.2
    let h = p.3
    var srv = p.4
    let res = result_of(0x234, false, 8)
    let body = ranging_data.ras_body_build(res, -4)
    let sent = ranging_service.ras_procedure_result(var srv, var s.db, var s.link, h, res, -4, 10)
    let ev = serve(var t, var c, var s, h, var srv, sent, -1, 10)
    test.assert((ev & ranging_client.RE_BODY) != 0)
    test.assert((ev & ranging_client.RE_ACKED) != 0)
    test.assert_eq(ev & ranging_client.RE_ERROR, 0)
    test.assert_eq(ranging_client.ras_client_body(c), body)
    test.assert_eq(list.len(ranging_service.ras_stored(srv)), 0)
    // The body reads as the reflector's ranging data.
    var hdr = ranging_data.RasHeader { ranging_counter: 0, config_id: 0, selected_tx_power: 0, antenna_paths_mask: 0 }
    var back = hci_cs.cs_proc_result_new()
    test.assert_eq(ranging_client.ras_client_take_result(c, false, false, var hdr, var back), true)
    test.assert_eq(hdr.selected_tx_power, -4)
    test.assert_eq(back.n_steps, 9)

@test
fn test_the_client_asks_for_a_lost_segment_and_gets_the_whole_body()
    if not fixtures.client_engine_present()
        return
    var p = paired(false)
    var t = p.0
