    test.assert_eq(list.len(first), 1)
    test.assert_eq(first[0][0], 0x52)
    let early = ranging_client.ras_client_tick(var t, var c, 5000)
    test.assert_eq(early.event & ranging_client.RE_ERROR, 0)
    let late = ranging_client.ras_client_tick(var t, var c, 5101)
    test.assert((late.event & ranging_client.RE_ERROR) != 0)
    test.assert_eq(c.error, ranging_client.RC_TIMEOUT)
