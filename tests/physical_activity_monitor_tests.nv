    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    test.assert_eq(refusal(var t, h, config, var st, [4, 1]), ERR_NO_SESSION_RUNNING)
    test.assert_eq(refusal(var t, h, config, var st, [4, 2]), ERR_INVALID_TYPE)
    test.assert_eq(refusal(var t, h, config, var st, [4, 0xFF]), ERR_INVALID_TYPE)
    // The type is checked first when both apply.
