    test.assert_eq(st.current, -1)
    let _ = run(var t, h, config, var st, [4, 0])
    test.assert_eq(refusal(var t, h, config, var st, [4, 7]), ERR_INVALID_TYPE)
    test.assert_eq(refusal(var t, h, config, var st, [4, 1]), 0)
    test.assert_eq(st.current_sub, 1)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_enquire_sessions_describes_every_session_and_then_counts_them()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    test.assert_eq(refusal(var t, h, config, var st, [1]), ERR_NO_SESSIONS_AVAILABLE)
    three_sessions(var t, h, config, var st)
    let out = run(var t, h, config, var st, [1])
    test.assert_eq(list.len(out), 5)
    test.assert_eq(out[0], [0x13])
    // One descriptor for each session, including the running one, then the count.
    test.assert_eq(out[1], req(0x1D, h.descriptor, [0x01, 0, 0, 0xE8, 0x03, 0, 0, 0x3C, 0, 0xB8, 0x0B, 0, 0, 0x3C, 0]))
    test.assert_eq(out[2], req(0x1D, h.descriptor, [0x01, 1, 0, 0xB8, 0x0B, 0, 0, 0x3C, 0, 0xA0, 0x0F, 0, 0, 0x3C, 0]))
    test.assert_eq(out[3], req(0x1D, h.descriptor, [0x03, 2, 0, 0x88, 0x13, 0, 0, 0x3C, 0]))
    test.assert_eq(out[4], req(0x1D, h.control_point, [0xFC, 3, 0]))
    // A negative offset is two's complement.
    pams_set_time(var st, 6000, -60)
    let _ = run(var t, h, config, var st, [5])
    let again = run(var t, h, config, var st, [1])
    test.assert_eq(again[3], req(0x1D, h.descriptor, [0x01, 2, 0, 0x88, 0x13, 0, 0, 0x3C, 0, 0x70, 0x17, 0, 0, 0xC4, 0xFF]))

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_enquire_sub_sessions_describes_the_sub_sessions_of_one_session()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    three_sessions(var t, h, config, var st)
    let out = run(var t, h, config, var st, [2, 0, 0])
    test.assert_eq(list.len(out), 4)
    test.assert_eq(out[1], req(0x1D, h.descriptor, [0x00, 0, 0, 0, 0, 0xE8, 0x03, 0, 0, 0x3C, 0, 0xD0, 0x07, 0, 0, 0x3C, 0]))
    test.assert_eq(out[2], req(0x1D, h.descriptor, [0x00, 0, 0, 1, 0, 0xD0, 0x07, 0, 0, 0x3C, 0, 0xB8, 0x0B, 0, 0, 0x3C, 0]))
    test.assert_eq(out[3], req(0x1D, h.control_point, [0xFB, 2, 0]))
    // The running session: its sub-session has the running bit and no end.
    let running = run(var t, h, config, var st, [2, 2, 0])
    test.assert_eq(list.len(running), 3)
    test.assert_eq(running[1], req(0x1D, h.descriptor, [0x02, 2, 0, 0, 0, 0x88, 0x13, 0, 0, 0x3C, 0]))
    test.assert_eq(running[2], req(0x1D, h.control_point, [0xFB, 1, 0]))
    // A session the monitor does not have, and the reserved 0xFFFF.
    test.assert_eq(refusal(var t, h, config, var st, [2, 9, 0]), ERR_INVALID_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [2, 0xFF, 0xFF]), ERR_INVALID_SESSION_ID)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_delete_ended_session_deletes_it_and_indicates_its_descriptor_as_deleted()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    three_sessions(var t, h, config, var st)
    test.assert_eq(refusal(var t, h, config, var st, [6, 2, 0]), ERR_SESSION_STILL_RUNNING)
    test.assert_eq(refusal(var t, h, config, var st, [6, 9, 0]), ERR_INVALID_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [6, 0xFF, 0xFF]), ERR_INVALID_SESSION_ID)
    let out = run(var t, h, config, var st, [6, 0, 0])
    test.assert_eq(list.len(out), 2)
    // Describes Session and Deleted Session, not running, with its end.
    test.assert_eq(out[1], req(0x1D, h.descriptor, [0x05, 0, 0, 0xE8, 0x03, 0, 0, 0x3C, 0, 0xB8, 0x0B, 0, 0, 0x3C, 0]))
    test.assert_eq(list.len(st.sessions), 2)
    test.assert_eq(pams_sub_count(st, 0), 0)
    test.assert_eq(pams_find_session(st, 0), -1)
    // It is gone: no sub-session, no data, no second deletion.
    test.assert_eq(refusal(var t, h, config, var st, [2, 0, 0]), ERR_INVALID_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [6, 0, 0]), ERR_INVALID_SESSION_ID)
    let all = run(var t, h, config, var st, [1])
    test.assert_eq(all[3], req(0x1D, h.control_point, [0xFC, 2, 0]))
    // The session that ran last was deleted: the current session names none until the running one stops.
    test.assert_eq(st.last, 1)
    let _ = run(var t, h, config, var st, [6, 1, 0])
    test.assert_eq(st.last, -1)
    test.assert_eq(list.len(pams_current_value(st)), 17)
    test.assert_eq(read(var t, h.current), [0x0B, 1, 2, 0, 0x88, 0x13, 0, 0, 0x3C, 0, 0, 0, 0x88, 0x13, 0, 0, 0x3C, 0])

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_a_session_id_is_not_reused_after_the_session_is_deleted_and_wraps_after_0xfffe()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    let _ = run(var t, h, config, var st, [4, 0])
    let _ = run(var t, h, config, var st, [5])
    let _ = run(var t, h, config, var st, [6, 0, 0])
    let _ = run(var t, h, config, var st, [4, 0])
    test.assert_eq(st.current, 1)
    // After 0xFFFE the number is 0 again, and a number in use is skipped.
    st.next_session = 0xFFFF
    test.assert_eq(pams_new_session_id(st), 0)
    st.next_session = 1
    test.assert_eq(pams_new_session_id(st), 2)
    st.next_session = 0xFFFE
    test.assert_eq(pams_new_session_id(st), 0xFFFE)
    // The sub-session IDs of a session run 0, 1, 2.
    let _ = run(var t, h, config, var st, [4, 1])
    let _ = run(var t, h, config, var st, [4, 1])
    test.assert_eq(st.current_sub, 2)
    test.assert_eq(pams_find_sub(st, 1, 0), 0)
    test.assert_eq(pams_find_sub(st, 1, 2), 2)
    test.assert_eq(pams_find_sub(st, 1, 3), -1)
    test.assert_eq(pams_find_sub(st, 7, 0), -1)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_the_table_of_sessions_has_the_room_the_configuration_gives()
    var config = full_config()
    config.max_sessions = 2
    config.max_sub_sessions = 2
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    test.assert_eq(refusal(var t, h, config, var st, [4, 0]), 0)
    test.assert_eq(refusal(var t, h, config, var st, [4, 1]), 0)
    // A third sub-session does not fit; the request is refused and nothing changes.
    test.assert_eq(refusal(var t, h, config, var st, [4, 1]), ERR_OPERATION_FAILED)
    test.assert_eq(st.current_sub, 1)
    test.assert_eq(refusal(var t, h, config, var st, [4, 0]), 0)
    // Two sessions are the most; the third is refused until one is deleted.
    test.assert_eq(refusal(var t, h, config, var st, [4, 0]), ERR_OPERATION_FAILED)
    test.assert_eq(st.current, 1)
    test.assert_eq(list.len(pams_start(var t.db, var t.link, h, config, var st, false, 0)), 0)
    let _ = run(var t, h, config, var st, [5])
    test.assert_eq(refusal(var t, h, config, var st, [6, 0, 0]), 0)
    test.assert_eq(refusal(var t, h, config, var st, [4, 0]), 0)
    test.assert_eq(list.len(st.sessions), 2)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_the_monitor_starts_and_stops_a_session_itself()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    pams_set_time(var st, 1000, 60)
    // No session: a sub-session and a stop do nothing.
    test.assert_eq(list.len(pams_start(var t.db, var t.link, h, config, var st, true, 0)), 0)
    test.assert_eq(list.len(pams_stop(var t.db, var t.link, h, var st, 0)), 0)
    let a = pams_start(var t.db, var t.link, h, config, var st, false, 0)
    test.assert_eq(list.len(a), 1)
    test.assert_eq(a[0], req(0x1D, h.current, current_value(1, 0, 1000, 0, 1000)))
    let _ = confirm_all(var t)
    pams_set_time(var st, 2000, 60)
    let b = pams_start(var t.db, var t.link, h, config, var st, true, 0)
    test.assert_eq(b[0], req(0x1D, h.current, current_value(1, 0, 1000, 1, 2000)))
    let _ = confirm_all(var t)
    // A new session while one runs: the stopped one is indicated first, and the second waits for the confirmation.
    pams_set_time(var st, 3000, 60)
    let c = pams_start(var t.db, var t.link, h, config, var st, false, 0)
    test.assert_eq(list.len(c), 1)
    test.assert_eq(c[0], req(0x1D, h.current, current_value(0, 0, 1000, 1, 2000)))
    let rest = confirm_all(var t)
    test.assert_eq(list.len(rest), 1)
    test.assert_eq(rest[0], req(0x1D, h.current, current_value(1, 1, 3000, 0, 3000)))
    let d = pams_stop(var t.db, var t.link, h, var st, 0)
    test.assert_eq(d[0], req(0x1D, h.current, current_value(0, 1, 3000, 0, 3000)))
    // The average activity type of a sub-session: monitor-defined low, user-defined high; a reserved value is refused.
    test.assert(pams_set_monitor_type(var st, 1, 0, 0x07))
    test.assert_eq(pams_average_activity_type(st, 1, 0), 0x0007)
    test.assert(not pams_set_monitor_type(var st, 1, 0, 0x20))
    test.assert(not pams_set_monitor_type(var st, 1, 9, 0x07))
    test.assert(not pams_set_monitor_type(var st, 9, 0, 0x07))
    test.assert_eq(pams_average_activity_type(st, 9, 0), 0)
    test.assert_eq(pams_average_activity_type(st, 1, 0), 0x0007)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_get_ended_session_data_sends_the_kept_records_and_then_counts_them()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    pams_set_time(var st, 1000, 60)
    let _ = run(var t, h, config, var st, [4, 0])
    for n in 0..2
        var rec = pams_record(0, 0, 0, 1 + n)
        pams_set_field(var rec, 0, 0x100 + n)
        let _ = pams_send_record(var t.db, var t.link, h, config, var st, rec, 0)
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, floors(0, 0, 5), 0)
    let _ = confirm_all(var t)
    let _ = run(var t, h, config, var st, [4, 1])
    var last = pams_record(0, 0, 1, 3)
    pams_set_field(var last, 0, 0x102)
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, last, 0)
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, floors(0, 1, 6), 0)
    let _ = confirm_all(var t)
    let _ = run(var t, h, config, var st, [5])
    test.assert_eq(list.len(st.records), 5)
    // All the sub-sessions: the three instantaneous records as notifications, the counter going on, then the count (uint24).
    let all = run(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 0])
    let data = pdus_of(all, h.data[0])
    test.assert_eq(list.len(data), 3)
    test.assert_eq(data[0][0] as Int, 0x1B)
    test.assert_eq(value_of(data[0])[0] as Int, (3 << 2) | 3)
    test.assert_eq(value_of(data[1])[0] as Int, (4 << 2) | 3)
    test.assert_eq(value_of(data[2])[0] as Int, (5 << 2) | 3)
    test.assert_eq(value_of(data[0])[1:18], st.records[0].data)
    test.assert_eq(value_of(data[2])[1:18], st.records[3].data)
    test.assert_eq(all[0], [0x13])
    test.assert_eq(all[list.len(all) - 1], req(0x1D, h.control_point, [0xFA, 3, 0, 0]))
    test.assert_eq(list.len(all), 5)
    // One sub-session: its record; the two summaries as indications, one for each sub-session.
    let one = run(var t, h, config, var st, [3, 0, 0, 1, 0, 0])
    test.assert_eq(list.len(pdus_of(one, h.data[0])), 1)
    test.assert_eq(one[list.len(one) - 1], req(0x1D, h.control_point, [0xFA, 1, 0, 0]))
    let sums = run(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 1])
    let sdata = pdus_of(sums, h.data[1])
    test.assert_eq(list.len(sdata), 2)
    test.assert_eq(sdata[0][0] as Int, 0x1D)
    test.assert_eq(sdata[0][20] as Int, 5)
    test.assert_eq(sdata[1][20] as Int, 6)
    test.assert_eq(sums[list.len(sums) - 1], req(0x1D, h.control_point, [0xFA, 2, 0, 0]))
    // The data records come before the control point's indication, which closes the procedure.
    test.assert_eq(gatt_server.read_le16(sums[1], 1), h.data[1])
    test.assert_eq(gatt_server.read_le16(sums[2], 1), h.data[1])
    test.assert_eq(gatt_server.read_le16(sums[3], 1), h.control_point)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_a_long_record_is_sent_in_segments_by_get_ended_session_data()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    let _ = run(var t, h, config, var st, [4, 0])
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, every_field(1), 0)
    let _ = confirm_all(var t)
    let _ = run(var t, h, config, var st, [5])
    // The record was sent for session 0x0102 by the test; keep it for session 0 for the request.
    st.records[0] = PamsStored { kind: 1, session: 0, sub: 0, data: st.records[0].data }
    let all = run(var t, h, config, var st, [3, 0, 0, 0, 0, 1])
    let data = pdus_of(all, h.data[1])
    test.assert_eq(list.len(data), 4)
    test.assert_eq(value_of(data[0])[0] as Int, (4 << 2) | 1)
    test.assert_eq(value_of(data[3])[0] as Int, (7 << 2) | 2)
    var joined: [u8] = []
    for p in data
        list.append(joined, value_of(p)[1:20])
    test.assert_eq(joined, st.records[0].data)
    test.assert_eq(all[list.len(all) - 1], req(0x1D, h.control_point, [0xFA, 1, 0, 0]))

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_get_ended_session_data_refuses_in_the_order_of_the_specification()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    three_sessions(var t, h, config, var st)
    var rec = pams_record(0, 0, 0, 1)
    pams_set_field(var rec, 0, 5)
    st.records = [PamsStored { kind: 0, session: 0, sub: 0, data: pams_encode(config.features, rec, 0) }]
    // A session the monitor does not have, or the reserved 0xFFFF: Invalid Session ID, whatever the rest.
    test.assert_eq(refusal(var t, h, config, var st, [3, 9, 0, 0xFF, 0xFF, 0]), ERR_INVALID_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0xFF, 0xFF, 0, 0, 0]), ERR_INVALID_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [3, 9, 0, 9, 0, 7]), ERR_INVALID_SESSION_ID)
    // A sub-session the session does not have.
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 5, 0, 0]), ERR_INVALID_SUB_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 5, 0, 7]), ERR_INVALID_SUB_SESSION_ID)
    // The running session, with a valid and with the "all" sub-session.
    test.assert_eq(refusal(var t, h, config, var st, [3, 2, 0, 0, 0, 0]), ERR_SESSION_STILL_RUNNING)
    test.assert_eq(refusal(var t, h, config, var st, [3, 2, 0, 0xFF, 0xFF, 0]), ERR_SESSION_STILL_RUNNING)
    test.assert_eq(refusal(var t, h, config, var st, [3, 2, 0, 5, 0, 0]), ERR_INVALID_SUB_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [3, 2, 0, 0, 0, 9]), ERR_SESSION_STILL_RUNNING)
    // A data characteristic above 6: Operation Failed.
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 7]), ERR_OPERATION_FAILED)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 0xFF]), ERR_OPERATION_FAILED)
    // No record matches: No Data Available, for another sub-session, another kind.
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 1, 0, 0]), ERR_NO_DATA_AVAILABLE)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 3]), ERR_NO_DATA_AVAILABLE)
    test.assert_eq(refusal(var t, h, config, var st, [3, 1, 0, 0xFF, 0xFF, 0]), ERR_NO_DATA_AVAILABLE)
    // A match is accepted.
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 0]), 0)
    // A kind the monitor lacks has nothing to send.
    let small = default_pams_config(FEATURE_ACTIVITY_TYPE)
    let (u, g) = live_server(small)
    var v = u
    var sst = fresh(small)
    let _ = run(var v, g, small, var sst, [4, 0])
    let _ = run(var v, g, small, var sst, [5])
    test.assert_eq(refusal(var v, g, small, var sst, [3, 0, 0, 0xFF, 0xFF, 2]), ERR_NO_DATA_AVAILABLE)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_the_descriptors_of_the_procedures_must_be_configured_after_the_parameters_are_checked()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    three_sessions(var t, h, config, var st)
    var rec = pams_record(0, 0, 0, 1)
    pams_set_field(var rec, 0, 5)
    st.records = [PamsStored { kind: 0, session: 0, sub: 0, data: pams_encode(config.features, rec, 0) }]
    let improperly = 0xFD
    // The Session Descriptor indication is off: Enquire Sessions, Enquire Sub-sessions and Delete Ended Session are refused with 0xFD ...
    subscribe(var t, h.descriptor_cccd, 0)
    test.assert_eq(refusal(var t, h, config, var st, [1]), improperly)
    test.assert_eq(refusal(var t, h, config, var st, [2, 0, 0]), improperly)
    test.assert_eq(refusal(var t, h, config, var st, [6, 0, 0]), improperly)
    // ... but a wrong Session ID is still Invalid Session ID, and a running session still Session Still Running.
    test.assert_eq(refusal(var t, h, config, var st, [2, 9, 0]), ERR_INVALID_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [6, 9, 0]), ERR_INVALID_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [6, 2, 0]), ERR_SESSION_STILL_RUNNING)
    test.assert_eq(st.sessions[0].id, 0)
    // The other procedures do not need it.
    test.assert_eq(refusal(var t, h, config, var st, [4, 0]), 0)
    subscribe(var t, h.descriptor_cccd, 2)
    // The data characteristic is off: 0xFD for a match and for no data, but a wrong Session ID is Invalid Session ID.
    subscribe(var t, h.data_cccd[0], 0)
    subscribe(var t, h.data_cccd[3], 0)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 0]), improperly)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 3]), improperly)
    test.assert_eq(refusal(var t, h, config, var st, [3, 9, 0, 0xFF, 0xFF, 0]), ERR_INVALID_SESSION_ID)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 7]), ERR_OPERATION_FAILED)
    // The kind needs its own kind of subscription: a notification of a summary characteristic is not an indication.
    subscribe(var t, h.data_cccd[1], 0)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 1]), improperly)
    subscribe(var t, h.data_cccd[0], 1)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 0]), 0)
    // The control point's own indication is off: 0xFD before anything else, even for an unknown opcode.
    subscribe(var t, h.control_point_cccd, 0)
    test.assert_eq(refusal(var t, h, config, var st, [1]), improperly)
    test.assert_eq(refusal(var t, h, config, var st, [0x77]), improperly)
    test.assert_eq(refusal(var t, h, config, var st, [5]), improperly)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_a_request_for_a_data_record_waits_for_the_consent_of_a_multiple_users_monitor()
    let config = default_pams_config(all_features())
    let (s, h) = live_server(config)
    var t = s
    var st = new_pams_state(config)
    let _ = run(var t, h, config, var st, [4, 0])
    var rec = pams_record(0, 0, 0, 1)
    pams_set_field(var rec, 0, 5)
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, rec, 0)
    let _ = run(var t, h, config, var st, [5])
    test.assert_eq(list.len(st.records), 1)
    // No consent: Operation Failed; the sessions can still be listed and managed.
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 0]), ERR_OPERATION_FAILED)
    test.assert_eq(refusal(var t, h, config, var st, [1]), 0)
    pams_set_consent(var st, true)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 0]), 0)

// A General Activity Summary record with the Floors (field 16) and the Average
// Activity Type (field 23, zero) for the session `session` and sub-session `sub`.
@tier(app)
fn avg(session: Int, sub: Int) -> PamsRecord
    var rec = pams_record(1, session, sub, 10)
    pams_set_field(var rec, 16, 3)
    pams_set_field(var rec, 23, 0)
    rec

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_set_average_activity_type_sets_the_user_sub_field_of_the_sub_sessions_and_their_kept_summaries()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    let _ = run(var t, h, config, var st, [4, 0])
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, avg(0, 0), 0)
    let _ = confirm_all(var t)
    let _ = run(var t, h, config, var st, [4, 1])
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, avg(0, 1), 0)
    let _ = confirm_all(var t)
    // Records of another session and of the whole session are not the sub-sessions' own.
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, avg(5, 0), 0)
    let _ = confirm_all(var t)
    let _ = pams_send_record(var t.db, var t.link, h, config, var st, avg(0, 0xFFFF), 0)
    let _ = confirm_all(var t)
    test.assert_eq(list.len(st.records), 4)
    test.assert_eq(pams_average_activity_type(st, 0, 0), 0)
    // The Average Activity Type is after the Floors: field 23 starts at octet 17, its user-defined sub-field is the second.
    test.assert_eq(st.records[0].data[17] as Int, 0)
    test.assert_eq(st.records[0].data[18] as Int, 0)
    // Scope 1: all the sub-sessions of the running session; the answer is the Write Response alone.
    let out = run(var t, h, config, var st, [7, 1, 0x0E])
    test.assert_eq(list.len(out), 1)
    test.assert_eq(out[0], [0x13])
    test.assert_eq(pams_average_activity_type(st, 0, 0), 0x0E00)
    test.assert_eq(pams_average_activity_type(st, 0, 1), 0x0E00)
    test.assert_eq(st.records[0].data[18] as Int, 0x0E)
    test.assert_eq(st.records[1].data[18] as Int, 0x0E)
    test.assert_eq(st.records[2].data[18] as Int, 0)
    test.assert_eq(st.records[3].data[18] as Int, 0)
    test.assert_eq(st.records[0].data[17] as Int, 0)
    // Scope 0: the current sub-session only, with the value 0xFF (unknown).
    let _ = run(var t, h, config, var st, [4, 1])
    test.assert_eq(refusal(var t, h, config, var st, [7, 0, 0xFF]), 0)
    test.assert_eq(pams_average_activity_type(st, 0, 2), 0xFF00)
    test.assert_eq(pams_average_activity_type(st, 0, 0), 0x0E00)
    test.assert_eq(pams_average_activity_type(st, 0, 1), 0x0E00)
    // The monitor-defined sub-field is the monitor's.
    test.assert(pams_set_monitor_type(var st, 0, 2, 0x07))
    test.assert_eq(pams_average_activity_type(st, 0, 2), 0xFF07)
    test.assert_eq(refusal(var t, h, config, var st, [7, 0, 0x00]), 0)
    test.assert_eq(pams_average_activity_type(st, 0, 2), 0x0007)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_set_average_activity_type_refuses_a_scope_a_session_and_a_type_in_that_order()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    // No session: Invalid Type for a scope above 1 first, then No Session Running, then Activity Type Out Of Range.
    test.assert_eq(refusal(var t, h, config, var st, [7, 2, 0x0F]), ERR_INVALID_TYPE)
    test.assert_eq(refusal(var t, h, config, var st, [7, 0xFF, 0x0E]), ERR_INVALID_TYPE)
    test.assert_eq(refusal(var t, h, config, var st, [7, 0, 0x0F]), ERR_NO_SESSION_RUNNING)
    test.assert_eq(refusal(var t, h, config, var st, [7, 1, 0x0E]), ERR_NO_SESSION_RUNNING)
    let _ = run(var t, h, config, var st, [4, 0])
    test.assert_eq(refusal(var t, h, config, var st, [7, 2, 0x0E]), ERR_INVALID_TYPE)
    test.assert_eq(refusal(var t, h, config, var st, [7, 0, 0x0F]), ERR_ACTIVITY_TYPE_OUT_OF_RANGE)
    test.assert_eq(refusal(var t, h, config, var st, [7, 1, 0xFE]), ERR_ACTIVITY_TYPE_OUT_OF_RANGE)
    test.assert_eq(refusal(var t, h, config, var st, [7, 1, 0x10]), ERR_ACTIVITY_TYPE_OUT_OF_RANGE)
    for v in [0x00, 0x05, 0x0E, 0xFF]
        test.assert_eq(refusal(var t, h, config, var st, [7, 0, v]), 0)
        test.assert_eq(refusal(var t, h, config, var st, [7, 1, v]), 0)
    // A session that has stopped has no sub-session to set.
    let _ = run(var t, h, config, var st, [5])
    test.assert_eq(refusal(var t, h, config, var st, [7, 0, 0x0E]), ERR_NO_SESSION_RUNNING)
    // A monitor without the Activity Type feature does not define the opcode, and a request of the wrong length is refused.
    let bare = default_pams_config(FEATURE_DEVICE_WORN)
    let (u, g) = live_server(bare)
    var v = u
    var bst = fresh(bare)
    test.assert_eq(refusal(var v, g, bare, var bst, [7, 0, 0x0E]), ERR_OP_CODE_NOT_SUPPORTED)
    test.assert_eq(refusal(var v, g, bare, var bst, [7]), ERR_OP_CODE_NOT_SUPPORTED)
    test.assert_eq(refusal(var t, h, config, var st, [7]), att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    test.assert_eq(refusal(var t, h, config, var st, [7, 1]), att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)
    test.assert_eq(refusal(var t, h, config, var st, [7, 1, 2, 3]), att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_the_user_sub_field_is_written_where_the_flags_put_the_average_activity_type()
    let f = all_features()
    // Without the field the record is as it was.
    let plain = pams_encode(f, one_field(1, 16, 3), 0)
    test.assert_eq(pams_with_user_type(plain, 0x0E), plain)
    // With earlier fields (Normal Walking Energy Expenditure, 4 octets) the field moves by their size.
    var rec = pams_record(1, 1, 2, 3)
    pams_set_field(var rec, 0, 0x01020304)
    pams_set_field(var rec, 23, 0x0007)
    let data = pams_encode(f, rec, 0)
    test.assert_eq(list.len(data), 16 + 4 + 2)
    let patched = pams_with_user_type(data, 0x0E)
    test.assert_eq(patched[20] as Int, 0x07)
    test.assert_eq(patched[21] as Int, 0x0E)
    test.assert_eq(patched[0:20], data[0:20])
    // The original record is not changed, and a record that is too short for its flags is left alone.
    test.assert_eq(data[21] as Int, 0)
    test.assert_eq(pams_with_user_type(data[0:21], 0x0E), data[0:21])
    test.assert_eq(list.len(pams_with_user_type([], 0x0E)), 0)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_an_opcode_the_service_does_not_define_is_not_supported_and_changes_nothing()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    for op in [0x00, 0x08, 0x09, 0x20, 0x7F, 0xF9, 0xFA, 0xFB, 0xFC, 0xFD, 0xFE, 0xFF]
        test.assert_eq(refusal(var t, h, config, var st, [op]), ERR_OP_CODE_NOT_SUPPORTED)
        test.assert_eq(refusal(var t, h, config, var st, [op, 1, 2, 3]), ERR_OP_CODE_NOT_SUPPORTED)
    // A write of no octet has no opcode.
    test.assert_eq(error_of(receive_default(var t, h, config, var st, req(0x12, h.control_point, []), 0)), ERR_OP_CODE_NOT_SUPPORTED)
    test.assert_eq(st.current, -1)
    test.assert_eq(list.len(st.sessions), 0)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_a_request_of_the_wrong_length_is_invalid_attribute_value_length()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    let wrong = att.ATT_ERR_INVALID_ATTRIBUTE_VALUE_LEN
    test.assert_eq(refusal(var t, h, config, var st, [1, 0]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [2]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [2, 0]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [2, 0, 0, 0]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [3]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0, 0]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0, 0, 0, 0]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [4]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [4, 0, 0]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [5, 0]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [6]), wrong)
    test.assert_eq(refusal(var t, h, config, var st, [6, 0]), wrong)
    test.assert_eq(st.current, -1)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_a_procedure_in_progress_refuses_the_next_write_until_its_indications_are_confirmed()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    three_sessions(var t, h, config, var st)
    // Enquire Sessions: the first descriptor is out, the others and the count wait.
    let first = receive_default(var t, h, config, var st, req(0x12, h.control_point, [1]), 0)
    test.assert_eq(list.len(first), 2)
    let blocked = receive_default(var t, h, config, var st, req(0x12, h.control_point, [5]), 0)
    test.assert_eq(list.len(blocked), 1)
    test.assert_eq(error_of(blocked), att.ATT_ERR_PROCEDURE_ALREADY_IN_PROGRESS)
    test.assert_eq(error_of(blocked), 0xFE)
    test.assert_eq(st.current, 2)
    // Still blocked while only the descriptors are confirmed; free after the count's confirmation.
    let one = gatt_server.receive(var t.db, var t.link, [0x1E], 1)
    test.assert_eq(list.len(one), 1)
    test.assert_eq(error_of(receive_default(var t, h, config, var st, req(0x12, h.control_point, [5]), 0)), 0xFE)
    let _ = confirm_all(var t)
    let free = receive_default(var t, h, config, var st, req(0x12, h.control_point, [5]), 0)
    test.assert_eq(free[0], [0x13])
    test.assert_eq(st.current, -1)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_a_long_write_is_refused_a_write_command_does_nothing_and_other_pdus_are_the_att_servers()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    let long = receive_default(var t, h, config, var st, req(0x16, h.control_point, [0, 0, 4, 0]), 0)
    test.assert_eq(error_of(long), att.ATT_ERR_REQUEST_NOT_SUPPORTED)
    test.assert_eq(list.len(long), 1)
    test.assert_eq(list.len(receive_default(var t, h, config, var st, req(0x52, h.control_point, [4, 0]), 0)), 0)
    test.assert_eq(st.current, -1)
    test.assert_eq(receive_default(var t, h, config, var st, req(0x0A, h.features, []), 0)[0], [0x0B, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x7F, 0x00])
    test.assert_eq(error_of(receive_default(var t, h, config, var st, req(0x0A, h.control_point, []), 0)), att.ATT_ERR_READ_NOT_PERMITTED)
    test.assert_eq(error_of(receive_default(var t, h, config, var st, req(0x12, h.features, [1]), 0)), att.ATT_ERR_WRITE_NOT_PERMITTED)

// A policy that starts nothing and remembers what it was asked.
@value
struct Quiet
    asked: Int
    last: Int

impl PamsPolicy[] for Quiet
    @tier(app)
    fn start_session(var self, _peer: links.LinkId, what: Int) -> Bool
        self.asked = self.asked + 1
        self.last = what
        false

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_the_policy_is_asked_for_a_start_session_the_service_accepts_and_a_refusal_is_operation_failed()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    var st = new_pams_state(config)
    var no = Quiet { asked: 0, last: -1 }
    let refused = pams_receive(var t.db, var t.link, h, config, var st, var no, peer(), req(0x12, h.control_point, [4, 0]), 0)
    test.assert_eq(error_of(refused), ERR_OPERATION_FAILED)
    test.assert_eq(st.current, -1)
    // A sub-session with no session running is the service's refusal and the policy is not asked.
    let sub = pams_receive(var t.db, var t.link, h, config, var st, var no, peer(), req(0x12, h.control_point, [4, 1]), 0)
    test.assert_eq(error_of(sub), ERR_NO_SESSION_RUNNING)
    test.assert_eq(no.asked, 1)
    test.assert_eq(no.last, 0)
    // Stop and the other procedures are not the policy's.
    let stop = pams_receive(var t.db, var t.link, h, config, var st, var no, peer(), req(0x12, h.control_point, [5]), 0)
    test.assert_eq(error_of(stop), ERR_NOTHING_TO_STOP)
    test.assert_eq(no.asked, 1)
    test.assert_eq(no.last, 0)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_a_procedure_that_fails_after_the_write_response_reports_an_undetermined_error()
    let config = full_config()
    let (s, h) = live_server(config)
    var t = s
    let a = pams_report_failure(var t.db, var t.link, h, OP_ENQUIRE_SESSIONS, 0)
    test.assert_eq(list.len(a), 1)
    test.assert_eq(a[0], req(0x1D, h.control_point, [0xFF, 0xFF]))
    let _ = confirm_all(var t)
    test.assert_eq(pams_report_failure(var t.db, var t.link, h, OP_ENQUIRE_SUB_SESSIONS, 0)[0], req(0x1D, h.control_point, [0xFE, 0xFF]))
    let _ = confirm_all(var t)
    test.assert_eq(pams_report_failure(var t.db, var t.link, h, OP_GET_ENDED_SESSION_DATA, 0)[0], req(0x1D, h.control_point, [0xFD, 0xFF]))
    let _ = confirm_all(var t)
    // The other procedures end with the Write Response, and nothing goes to a client that did not enable the indication.
    test.assert_eq(list.len(pams_report_failure(var t.db, var t.link, h, OP_START_SESSION, 0)), 0)
    test.assert_eq(list.len(pams_report_failure(var t.db, var t.link, h, 0, 0)), 0)
    subscribe(var t, h.control_point_cccd, 0)
    test.assert_eq(list.len(pams_report_failure(var t.db, var t.link, h, OP_ENQUIRE_SESSIONS, 0)), 0)

@test
@satisfies("REQ-BLE-PAMS-001")
fn test_a_monitor_that_keeps_no_records_has_no_data_to_send()
    var config = full_config()
    config.max_records = 0
    let (s, h) = live_server(config)
    var t = s
    var st = fresh(config)
    let _ = run(var t, h, config, var st, [4, 0])
    test.assert_eq(list.len(pams_send_record(var t.db, var t.link, h, config, var st, pams_record(0, 0, 0, 1), 0)), 1)
    let _ = run(var t, h, config, var st, [5])
    test.assert_eq(refusal(var t, h, config, var st, [3, 0, 0, 0xFF, 0xFF, 0]), ERR_NO_DATA_AVAILABLE)
    // The sessions are still kept and listed.
    test.assert_eq(refusal(var t, h, config, var st, [1]), 0)
