use generic_health_sensor.{ BODY_BUNDLE_ID, BODY_CLASS, BODY_FIELD, BODY_FLAGS, BODY_LENGTH, BODY_NESTED_BUNDLE, BODY_NO_TYPE, BODY_OK, BODY_STATUS, BODY_STRING, BODY_TOO_SHORT, BODY_TRAILING, BODY_VALUE, CLASS_BUNDLE, CLASS_COMPOUND, CLASS_COMPOUND_DISCRETE, CLASS_COMPOUND_STATE_EVENT, CLASS_DISCRETE, CLASS_NUMERIC, CLASS_SAMPLE_ARRAY, CLASS_STRING, CLASS_TLV, CONFIG_INVALID, CONFIG_NOT_PERMITTED, CONFIG_OK, ERR_COMMAND_NOT_SUPPORTED, FILTER_RECORD_NUMBER, FILTER_TIME, FLAGS_DEFINED, FLAG_DERIVED_FROM, FLAG_DURATION, FLAG_ID, FLAG_MEMBER_OF, FLAG_PATIENT, FLAG_STATUS, FLAG_SUPPLEMENTAL, FLAG_TIME_STAMP, FLAG_TLVS, FLAG_TYPE, GhsConfig, GhsHandles, GhsObservation, GhsPolicy, GhsRange, GhsState, GhsTlv, MASK_ALL, MASK_ALL_OPERATORS, MASK_FIRST, MASK_GREATER_OR_EQUAL, MASK_LAST, OPERATOR_ALL, OPERATOR_FIRST, OPERATOR_GREATER_OR_EQUAL, OPERATOR_LAST, OPERATOR_LESS_OR_EQUAL, OPERATOR_NULL, OPERATOR_WITHIN, OP_START, OP_STOP, PULSE, RACP_ABORT, RACP_COMBINED_REPORT, RACP_COMBINED_RESPONSE, RACP_DELETE, RACP_NUMBER_RESPONSE, RACP_REPORT_NUMBER, RACP_RESPONSE_CODE, RESULT_ABORT_UNSUCCESSFUL, RESULT_CONTROL_POINT_SUCCESS, RESULT_INVALID_OPERAND, RESULT_INVALID_OPERATOR, RESULT_NO_RECORDS_FOUND, RESULT_OPERAND_NOT_SUPPORTED, RESULT_OPERATOR_NOT_SUPPORTED, RESULT_OP_CODE_NOT_SUPPORTED, RESULT_PROCEDURE_NOT_COMPLETED, RESULT_SERVER_BUSY, RESULT_SUCCESS, SPO2, STATUS_MANUALLY_ENTERED, STATUS_TEST_DATA, STORE_DISABLED, STORE_FULL, STORE_INVALID, STORE_NO_TIME_STAMP, SUBMIT_DISABLED, SUBMIT_FULL, SUBMIT_INVALID, SUBMIT_NO_TIME_STAMP, SUBMIT_OK, UNIT_PERCENT, add_ghs_service, both_config, default_ghs_config, default_ghs_policy, full_config, ghs_body, ghs_body_error, ghs_body_patient, ghs_bundle_value, ghs_component, ghs_compound_discrete_value, ghs_compound_value, ghs_config_error, ghs_delete_records, ghs_discrete_value, ghs_features_length, ghs_features_value, ghs_format_octets, ghs_has_time_stamp, ghs_indicate_features, ghs_indicate_schedule_changed, ghs_live_count, ghs_numeric_value, ghs_observation, ghs_observation_flags, ghs_pump, ghs_range_value, ghs_receive, ghs_reset_connection, ghs_sample_array_value, ghs_segment_count, ghs_segment_header, ghs_segments, ghs_service_data, ghs_set_features, ghs_set_schedule, ghs_set_users, ghs_state_event_value, ghs_store, ghs_store_count, ghs_store_drop_oldest, ghs_string_value, ghs_submit, ghs_tlv_value, ghs_written_schedule, new_ghs_state, stored_config }

const MODALITY_SPOT = 0x00024C3C
const UNIT_BPM = 0x0AA0
const UNIT_MMHG = 0x0F20

// A server with the service of `config`, on an encrypted link of security
// level `level` whose ATT_MTU is `mtu` (23 is the default).
@tier(app)
fn rig_at(config: GhsConfig, level: Int, mtu: Int) -> (GattServer, GhsHandles)
    var s = gatt_server.new_server([], 65)
    let h = add_ghs_service(var s.db, config)!
    gatt_server.set_security(var s.link, gatt_server.link_security(true, level, 16, true))
    if mtu > 23
        gatt_server.set_mtu(var s.link, 0, mtu)
    (s, h)

@tier(app)
fn rig(config: GhsConfig) -> (GattServer, GhsHandles)
    rig_at(config, 2, 23)

// Live observations over notifications and/or indications, no stored ones.
@tier(app)
fn live_config(notify: Bool, indicate: Bool) -> GhsConfig
    var c = default_ghs_config([SPO2, PULSE])
    c.live_notify = notify
    c.live_indicate = indicate
    c

@tier(app)
fn confirm(var s: GattServer) -> [[u8]]
    gatt_server.receive(var s.db, var s.link, [0x1E], 0)

@tier(app)
fn read_of(var s: GattServer, handle: Int) -> [u8]
    gatt_server.receive(var s.db, var s.link, req(0x0A, handle, []), 0)[0]

// `ghs_receive` with the default policy, for the tests that do not look at it.
@tier(app)
fn receive_default(var s: GattServer, h: GhsHandles, config: GhsConfig, var st: GhsState, pdu: [u8], now_ms: Int) -> [[u8]]
    var policy = default_ghs_policy()
    ghs_receive(var s.db, var s.link, h, config, var st, var policy, peer(), pdu, now_ms)

@tier(app)
fn write(var s: GattServer, h: GhsHandles, config: GhsConfig, var st: GhsState, handle: Int, value: [Int]) -> [[u8]]
    receive_default(var s, h, config, var st, req(0x12, handle, value), 0)

@tier(app)
fn pump(var s: GattServer, h: GhsHandles, config: GhsConfig, var st: GhsState) -> [[u8]]
    ghs_pump(var s.db, var s.link, h, config, var st, 0)

// The error response to the request `op` for `handle` with `code`.
@tier(app)
fn error_pdu(op: Int, handle: Int, code: Int) -> [u8]
    wire.octets([0x01, op, handle & 0xFF, handle >>> 8, code])

// The values of the segments in the PDUs: the Segmentation Header and the data.
@tier(app)
fn segment_values(pdus: [[u8]]) -> [u8]
    var out: [u8] = []
    for p in pdus
        list.append(out, p[3:])
    out

// The data of the segments in the PDUs, without the Segmentation Headers.
@tier(app)
fn segment_data(pdus: [[u8]]) -> [u8]
    var out: [u8] = []
    for p in pdus
        list.append(out, p[4:])
    out

// The Elapsed Time of the examples of [GHSS] Appendix A: flags 0x22, the time
// value 0x00002 9 2B9D72, and two more octets.
@tier(app)
fn stamp() -> [u8]
    [0x22, 0x72, 0x9D, 0x2B, 0x29, 0x00, 0x00, 0x06, 0x00]

// A numeric SpO2 observation of `value` percent.
@tier(app)
fn numeric(value: Int) -> GhsObservation
    ghs_observation(CLASS_NUMERIC, SPO2, ghs_numeric_value(UNIT_PERCENT, wire.float(value, 0)))

// 15 octets: it fits one segment of the default ATT_MTU.
@tier(app)
fn live_body(value: Int) -> [u8]
    ghs_body(numeric(value))

// 24 octets with a time stamp, 25 with a patient: a record of 28 octets, which
// takes two segments of the default ATT_MTU.
@tier(app)
fn stamped_body(value: Int, patient: Int) -> [u8]
    var o = numeric(value)
    o.time_stamp = stamp()
    o.patient = patient
    ghs_body(o)

// The first observation of [GHSS] A.1: a spot-check SpO2 of 98 percent, 29
// octets, which takes two segments of the default ATT_MTU.
@tier(app)
fn spot_check() -> [u8]
    var o = numeric(98)
    o.time_stamp = stamp()
    o.supplemental = [MODALITY_SPOT]
    ghs_body(o)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_live_sensor_lists_the_features_the_live_characteristic_and_the_control_point()
    let (s, h) = rig(default_ghs_config([SPO2, PULSE]))
    test.assert_eq(h.service, 1)
    test.assert_eq(h.features, 3)
    test.assert_eq(h.features_cccd, 0)
    test.assert_eq(h.live, 5)
    test.assert_eq(h.live_cccd, 6)
    test.assert_eq(h.control_point, 8)
    test.assert_eq(h.control_point_cccd, 9)
    test.assert_eq(h.stored, 0)
    test.assert_eq(h.stored_cccd, 0)
    test.assert_eq(h.racp, 0)
    test.assert_eq(h.schedule_changed, 0)
    test.assert_eq(list.len(h.schedules), 0)
    test.assert_eq(list.len(h.ranges), 0)
    test.assert_eq(gatt_server.last_handle(s.db), 9)
    // A primary service, then the declarations of Table 3.1 with their properties:
    // Read, Indicate, and Write with Indicate for the control point (the rows of the test specification).
    test.assert_eq(s.db.attributes[0].value, [0x40, 0x18])
    test.assert_eq(s.db.attributes[1].value, [0x02, 0x03, 0x00, 0xF3, 0x2B])
    test.assert_eq(s.db.attributes[3].value, [0x20, 0x05, 0x00, 0x8B, 0x2B])
    test.assert_eq(s.db.attributes[6].value, [0x28, 0x08, 0x00, 0xF4, 0x2B])

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_full_sensor_lists_every_characteristic_and_descriptor_in_the_order_of_the_table()
    let (s, h) = rig(full_config())
    test.assert_eq(h.service, 1)
    test.assert_eq(h.features, 3)
    test.assert_eq(h.features_cccd, 4)
    test.assert_eq(h.schedules[0], 5)
    test.assert_eq(h.schedules[1], 6)
    test.assert_eq(h.ranges[0], 7)
    test.assert_eq(h.live, 9)
    test.assert_eq(h.live_cccd, 10)
    test.assert_eq(h.stored, 12)
    test.assert_eq(h.stored_cccd, 13)
    test.assert_eq(h.racp, 15)
    test.assert_eq(h.racp_cccd, 16)
    test.assert_eq(h.control_point, 18)
    test.assert_eq(h.control_point_cccd, 19)
    test.assert_eq(h.schedule_changed, 21)
    test.assert_eq(h.schedule_changed_cccd, 22)
    test.assert_eq(gatt_server.last_handle(s.db), 22)
    test.assert_eq(s.db.attributes[1].value, [0x22, 0x03, 0x00, 0xF3, 0x2B])
    test.assert_eq(s.db.attributes[7].value, [0x30, 0x09, 0x00, 0x8B, 0x2B])
    test.assert_eq(s.db.attributes[10].value, [0x30, 0x0C, 0x00, 0xDD, 0x2B])
    test.assert_eq(s.db.attributes[13].value, [0x28, 0x0F, 0x00, 0x52, 0x2A])
    test.assert_eq(s.db.attributes[16].value, [0x28, 0x12, 0x00, 0xF4, 0x2B])
    test.assert_eq(s.db.attributes[19].value, [0x20, 0x15, 0x00, 0xF1, 0x2B])
    // The descriptors of the features: two Observation Schedule (0x2910), one Valid Range and Accuracy (0x2911).
    test.assert_eq(s.db.attributes[4].type_uuid, [0x10, 0x29])
    test.assert_eq(s.db.attributes[5].type_uuid, [0x10, 0x29])
    test.assert_eq(s.db.attributes[6].type_uuid, [0x11, 0x29])

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_stored_sensor_has_the_stored_characteristic_and_the_point_but_no_live_characteristic()
    var c = stored_config(false, true)
    c.features = false
    c.observation_types = []
    let (s, h) = rig(c)
    test.assert_eq(h.features, 0)
    test.assert_eq(h.live, 0)
    test.assert_eq(h.control_point, 0)
    test.assert_eq(h.stored, 3)
    test.assert_eq(h.stored_cccd, 4)
    test.assert_eq(h.racp, 6)
    test.assert_eq(h.racp_cccd, 7)
    test.assert_eq(gatt_server.last_handle(s.db), 7)
    test.assert_eq(s.db.attributes[1].value, [0x20, 0x03, 0x00, 0xDD, 0x2B])

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_features_value_lists_the_observation_types_and_the_device_specializations()
    // [GHSS] Table 3.5: a pulse oximeter with the oxygen saturation and the pulse rate.
    var c = default_ghs_config([SPO2, PULSE])
    test.assert_eq(ghs_features_value(c), [0x00, 0x02, 0xB8, 0x4B, 0x02, 0x00, 0x1A, 0x48, 0x02, 0x00])
    // Table 3.7: the blood pressure monitor specialization 0x1007 in version 1 sets bit 0 of the Flags.
    c.specialization_codes = [0x1007]
    c.specialization_versions = [1]
    test.assert_eq(ghs_features_value(c), [0x01, 0x02, 0xB8, 0x4B, 0x02, 0x00, 0x1A, 0x48, 0x02, 0x00, 0x01, 0x07, 0x10, 0x01])
    c.specialization_codes = [0x1007, 0x1004]
    c.specialization_versions = [1, 2]
    test.assert_eq(ghs_features_value(c), [0x01, 0x02, 0xB8, 0x4B, 0x02, 0x00, 0x1A, 0x48, 0x02, 0x00, 0x02, 0x07, 0x10, 0x01, 0x04, 0x10, 0x02])
    test.assert_eq(ghs_features_length(c), 17)
    var (s, h) = rig(c)
    test.assert_eq(read_of(var s, h.features), [0x0B, 0x01, 0x02, 0xB8, 0x4B, 0x02, 0x00, 0x1A, 0x48, 0x02, 0x00, 0x02, 0x07, 0x10, 0x01, 0x04, 0x10, 0x02])
    // The value is read, not written.
    test.assert_eq(gatt_server.receive(var s.db, var s.link, req(0x12, h.features, [0]), 0)[0][4] as Int, att.ATT_ERR_WRITE_NOT_PERMITTED)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_features_value_longer_than_the_mtu_is_read_long()
    var types: [Int] = []
    for i in 0..40
        list.push(types, 0x00024000 + i)
    var (s, h) = rig(default_ghs_config(types))
    // 2 + 160 octets: the Read Response holds 22 of them at the default ATT_MTU of 23.
    let value = s.db.attributes[gatt_server.index_of(s.db, h.features)].value
    test.assert_eq(list.len(value), 162)
    let first = read_of(var s, h.features)
    test.assert_eq(list.len(first), 23)
    test.assert_eq(first[1:], value[0:22])
    let blob = gatt_server.receive(var s.db, var s.link, req(0x0C, h.features, [22, 0]), 0)[0]
    test.assert_eq(blob[0] as Int, 0x0D)
    test.assert_eq(blob[1:], value[22:44])
    let last = gatt_server.receive(var s.db, var s.link, req(0x0C, h.features, [154, 0]), 0)[0]
    test.assert_eq(last[1:], value[154:162])

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_sensor_whose_features_change_indicates_them_to_a_subscribed_client()
    var c = full_config()
    var (s, h) = rig(c)
    test.assert_eq(list.len(ghs_indicate_features(var s.db, var s.link, h, 0)), 0)
    subscribe(var s, h.features_cccd, 2)
    let first = ghs_indicate_features(var s.db, var s.link, h, 0)
    test.assert_eq(first[0], [0x1D, 0x03, 0x00, 0x01, 0x02, 0xB8, 0x4B, 0x02, 0x00, 0x1A, 0x48, 0x02, 0x00, 0x01, 0x07, 0x10, 0x01])
    let _ = confirm(var s)
    // The features changed: a third observation type and no specialization.
    c.observation_types = [SPO2, PULSE, 0x00024A04]
    c.specialization_codes = []
    c.specialization_versions = []
    test.assert(ghs_set_features(var s.db, h, c))
    let second = ghs_indicate_features(var s.db, var s.link, h, 1)
    test.assert_eq(second[0], [0x1D, 0x03, 0x00, 0x00, 0x03, 0xB8, 0x4B, 0x02, 0x00, 0x1A, 0x48, 0x02, 0x00, 0x04, 0x4A, 0x02, 0x00])
    // A value that breaks a rule leaves the old one.
    c.observation_types = []
    test.assert(not ghs_set_features(var s.db, h, c))
    // A sensor whose features cannot change has no Indicate property.
    var (u, uh) = rig(default_ghs_config([SPO2]))
    test.assert_eq(list.len(ghs_indicate_features(var u.db, var u.link, uh, 0)), 0)
    // A sensor without the Health Sensor Features characteristic has none to set.
    var plain = default_ghs_config([SPO2])
    plain.features = false
    plain.observation_types = []
    var (v, vh) = rig(plain)
    test.assert(not ghs_set_features(var v.db, vh, plain))
    test.assert_eq(list.len(ghs_indicate_features(var v.db, var v.link, vh, 0)), 0)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_schedule_and_range_descriptors_are_read_with_the_twelve_and_the_fourteen_or_eighteen_octets_of_the_tables()
    var c = full_config()
    var r2 = GhsRange { observation_type: PULSE, unit_code: UNIT_BPM, lower: wire.float(30, 0), upper: wire.float(250, 0), has_accuracy: false, accuracy: 0 }
    list.push(c.ranges, r2)
    var (s, h) = rig(c)
    // Type, period and update interval: 12 octets.
    test.assert_eq(read_of(var s, h.schedules[0]), [0x0B, 0xB8, 0x4B, 0x02, 0x00, 0x1E, 0x00, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00])
    test.assert_eq(read_of(var s, h.schedules[1]), [0x0B, 0x1A, 0x48, 0x02, 0x00, 0x1E, 0x00, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00])
    // Type, unit, lower and upper limit, and the accuracy when there is one: 18 and 14 octets.
    test.assert_eq(read_of(var s, h.ranges[0]), [0x0B, 0xB8, 0x4B, 0x02, 0x00, 0x20, 0x02, 0x00, 0x00, 0x00, 0x00, 0x64, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00])
    test.assert_eq(list.len(ghs_range_value(c.ranges[0])), 18)
    test.assert_eq(read_of(var s, h.ranges[1]), [0x0B, 0x1A, 0x48, 0x02, 0x00, 0xA0, 0x0A, 0x1E, 0x00, 0x00, 0x00, 0xFA, 0x00, 0x00, 0x00])
    test.assert_eq(list.len(ghs_range_value(r2)), 14)
    // The range is static: no client writes it.
    test.assert_eq(gatt_server.receive(var s.db, var s.link, req(0x12, h.ranges[0], [0, 0]), 0)[0][4] as Int, att.ATT_ERR_WRITE_NOT_PERMITTED)
    // A negative limit is a FLOAT: -40.
    r2.lower = wire.float(-40, 0)
    test.assert_eq(ghs_range_value(r2)[6:10], [0xD8, 0xFF, 0xFF, 0x00])

@test
@satisfies("REQ-BLE-GHS-001")
fn test_every_configuration_that_breaks_a_rule_is_refused_with_its_error()
    test.assert_eq(ghs_config_error(default_ghs_config([SPO2])), CONFIG_OK)
    test.assert_eq(ghs_config_error(full_config()), CONFIG_OK)
    // The profile asks for security level 2 or higher: an open access is refused, the others pass.
    var c = default_ghs_config([SPO2])
    c.access = gatt_server.Access.Open
    test.assert_eq(ghs_config_error(c), CONFIG_NOT_PERMITTED)
    c.access = gatt_server.Access.Denied
    test.assert_eq(ghs_config_error(c), CONFIG_NOT_PERMITTED)
    c.access = gatt_server.Access.Authenticated
    test.assert_eq(ghs_config_error(c), CONFIG_OK)
    c.access = gatt_server.Access.SecureConnections
    test.assert_eq(ghs_config_error(c), CONFIG_OK)
    // At least one of the live and the stored characteristic, each with a way to send (Table 3.1, C.2 and C.3).
    var none = default_ghs_config([SPO2])
    none.live = false
    none.live_indicate = false
    test.assert_eq(ghs_config_error(none), CONFIG_INVALID)
    var silent = default_ghs_config([SPO2])
    silent.live_indicate = false
    test.assert_eq(ghs_config_error(silent), CONFIG_INVALID)
    var orphan = stored_config(true, false)
    orphan.live_notify = true
    test.assert_eq(ghs_config_error(orphan), CONFIG_INVALID)
    var mute = stored_config(false, false)
    test.assert_eq(ghs_config_error(mute), CONFIG_INVALID)
    var stray = default_ghs_config([SPO2])
    stray.stored_indicate = true
    test.assert_eq(ghs_config_error(stray), CONFIG_INVALID)
    var no_queue = default_ghs_config([SPO2])
    no_queue.live_capacity = 0
    test.assert_eq(ghs_config_error(no_queue), CONFIG_INVALID)
    var no_store = stored_config(true, false)
    no_store.store_capacity = 0
    test.assert_eq(ghs_config_error(no_store), CONFIG_INVALID)
    // The operators of the Combined Report hold All records and Greater than or equal to; the rest are optional.
    var ops = stored_config(true, false)
    ops.report_operators = MASK_ALL | MASK_GREATER_OR_EQUAL
    test.assert_eq(ghs_config_error(ops), CONFIG_OK)
    ops.report_operators = MASK_ALL
    test.assert_eq(ghs_config_error(ops), CONFIG_INVALID)
    ops.report_operators = MASK_GREATER_OR_EQUAL | MASK_FIRST
    test.assert_eq(ghs_config_error(ops), CONFIG_INVALID)
    ops.report_operators = MASK_ALL_OPERATORS | 0x01
    test.assert_eq(ghs_config_error(ops), CONFIG_INVALID)
    ops.report_operators = MASK_ALL_OPERATORS | 0x80
    test.assert_eq(ghs_config_error(ops), CONFIG_INVALID)
    ops.report_operators = MASK_ALL_OPERATORS
    ops.delete_operators = MASK_ALL
    test.assert_eq(ghs_config_error(ops), CONFIG_OK)
    ops.delete_operators = MASK_LAST
    test.assert_eq(ghs_config_error(ops), CONFIG_INVALID)
    ops.delete_operators = MASK_ALL | 0x80
    test.assert_eq(ghs_config_error(ops), CONFIG_INVALID)
    // Without stored observations there is neither a delete nor an abort procedure.
    var live_delete = default_ghs_config([SPO2])
    live_delete.delete_operators = MASK_ALL
    test.assert_eq(ghs_config_error(live_delete), CONFIG_INVALID)
    var live_abort = default_ghs_config([SPO2])
    live_abort.abort = true
    test.assert_eq(ghs_config_error(live_abort), CONFIG_INVALID)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_features_characteristic_needs_one_to_255_codes_of_the_right_width_and_fits_an_attribute()
    var c = default_ghs_config([SPO2])
    c.observation_types = []
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    var many: [Int] = []
    for i in 0..256
        list.push(many, i)
    c.observation_types = many
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.observation_types = [-1]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.observation_types = [4294967296]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.observation_types = [4294967295]
    test.assert_eq(ghs_config_error(c), CONFIG_OK)
    // The specializations: as many versions as codes, 16-bit codes, 8-bit versions.
    c.observation_types = [SPO2]
    c.specialization_codes = [0x1007]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.specialization_versions = [1]
    test.assert_eq(ghs_config_error(c), CONFIG_OK)
    c.specialization_codes = [0x10000]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.specialization_codes = [-1]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.specialization_codes = [0xFFFF]
    c.specialization_versions = [256]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.specialization_versions = [-1]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.specialization_versions = [255]
    test.assert_eq(ghs_config_error(c), CONFIG_OK)
    // A value longer than an attribute: 100 codes and 100 specializations are 703 octets.
    var wide: [Int] = []
    var spec: [Int] = []
    var version: [Int] = []
    for i in 0..100
        list.push(wide, 0x00024000 + i)
        list.push(spec, i)
        list.push(version, 1)
    var big = default_ghs_config(wide)
    big.specialization_codes = spec
    big.specialization_versions = version
    test.assert_eq(ghs_features_length(big), 703)
    test.assert_eq(ghs_config_error(big), CONFIG_INVALID)
    big.specialization_codes = []
    big.specialization_versions = []
    test.assert_eq(ghs_config_error(big), CONFIG_OK)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_sensor_without_features_has_no_descriptors_and_no_lists()
    var c = default_ghs_config([SPO2])
    c.features = false
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.observation_types = []
    test.assert_eq(ghs_config_error(c), CONFIG_OK)
    c.features_indicate = true
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.features_indicate = false
    c.specialization_codes = [1]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.specialization_codes = []
    c.specialization_versions = [1]
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)
    c.specialization_versions = []
    c.schedule_changed = true
    test.assert_eq(ghs_config_error(c), CONFIG_INVALID)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_schedule_and_range_descriptors_obey_the_rules_of_their_tables()
    var c = full_config()
    test.assert_eq(ghs_config_error(c), CONFIG_OK)
    // A schedule is for an observation type the sensor supports, one for each type.
    var stray = full_config()
    stray.schedules[1].observation_type = 0x00024A04
    test.assert_eq(ghs_config_error(stray), CONFIG_INVALID)
    var twice = full_config()
    twice.schedules[1].observation_type = SPO2
    test.assert_eq(ghs_config_error(twice), CONFIG_INVALID)
    // The period and the interval are numbers of seconds that are not negative.
    var nan = full_config()
    nan.schedules[1].period = wire.FLOAT_NAN
    test.assert_eq(ghs_config_error(nan), CONFIG_INVALID)
    var negative = full_config()
    negative.schedules[1].interval = wire.float(-1, 0)
    test.assert_eq(ghs_config_error(negative), CONFIG_INVALID)
    // A writable schedule has limits that hold its own value, and needs the characteristic that tells of changes.
    var inverted = full_config()
    inverted.schedules[0].period_min = 5000000
    test.assert_eq(ghs_config_error(inverted), CONFIG_INVALID)
    var outside = full_config()
    outside.schedules[0].interval_max = 1000
    test.assert_eq(ghs_config_error(outside), CONFIG_INVALID)
    var silent = full_config()
    silent.schedule_changed = false
    test.assert_eq(ghs_config_error(silent), CONFIG_INVALID)
    // The characteristic with no schedule, and with only a schedule the user changes, are both there.
    var empty = full_config()
    empty.schedules = []
    test.assert_eq(ghs_config_error(empty), CONFIG_INVALID)
    var by_user = full_config()
    by_user.schedules[0].writable = false
    test.assert_eq(ghs_config_error(by_user), CONFIG_OK)
    // The ranges: one for each type, a unit of 16 bits, numbers for the limits, the lower not above the upper.
    var again = full_config()
    list.push(again.ranges, again.ranges[0])
    test.assert_eq(ghs_config_error(again), CONFIG_INVALID)
    var unit = full_config()
    unit.ranges[0].unit_code = 0x10000
    test.assert_eq(ghs_config_error(unit), CONFIG_INVALID)
    var lower = full_config()
    lower.ranges[0].lower = wire.FLOAT_NAN
    test.assert_eq(ghs_config_error(lower), CONFIG_INVALID)
    var order = full_config()
    order.ranges[0].lower = wire.float(101, 0)
    test.assert_eq(ghs_config_error(order), CONFIG_INVALID)
    var same = full_config()
    same.ranges[0].lower = wire.float(100, 0)
    test.assert_eq(ghs_config_error(same), CONFIG_OK)
    var accuracy = full_config()
    accuracy.ranges[0].accuracy = wire.FLOAT_POSITIVE_INFINITY
    test.assert_eq(ghs_config_error(accuracy), CONFIG_INVALID)
    accuracy.ranges[0].has_accuracy = false
    test.assert_eq(ghs_config_error(accuracy), CONFIG_OK)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_builder_answers_the_error_of_a_refused_configuration_and_a_full_table()
    var s = gatt_server.new_server([], 65)
    var open = default_ghs_config([SPO2])
    open.access = gatt_server.Access.Open
    match add_ghs_service(var s.db, open)
        Ok(_) => test.fail("an open access is below the profile")
        Err(e) => test.assert_eq(e, profile_builder.ProfileError.NotPermitted)
    var bad = default_ghs_config([SPO2])
    bad.live = false
    bad.live_indicate = false
    match add_ghs_service(var s.db, bad)
        Ok(_) => test.fail("a sensor with no observations")
        Err(e) => test.assert_eq(e, profile_builder.ProfileError.InvalidValue)
    test.assert_eq(gatt_server.last_handle(s.db), 0)
    // A table with no handle left.
    var t = gatt_server.new_server([], 65)
    test.assert_eq(gatt_server.add_service(var t.db, false, gatt_server.le16(0xAA00)), 1)
    t.db.attributes[0] = gatt_server.GattAttribute {
        handle: 0xFFFF, type_uuid: gatt_server.le16(gatt_server.UUID_PRIMARY_SERVICE), value: gatt_server.le16(0xAA00),
        max_len: 2, permissions: gatt_server.PERM_READ, key_size: 0, tester: false, included: 0, per_link: false }
    match add_ghs_service(var t.db, default_ghs_config([SPO2]))
        Ok(_) => test.fail("no handle is left")
        Err(e) => test.assert_eq(e, profile_builder.ProfileError.NoRoom)

// ── Tests: observations ─────────────────────────────────────────────

@tier(app)
fn cat(a: [Int], b: [Int]) -> [Int]
    var out: [Int] = []
    list.append(out, a)
    list.append(out, b)
    out

@tier(app)
fn ints(b: [u8]) -> [Int]
    var out: [Int] = []
    for x in b
        list.push(out, x as Int)
    out

// The octets of the Observation Type 0x00024BB8 and of the Numeric value of 98 percent.
@tier(app)
fn type_bytes() -> [Int]
    [0xB8, 0x4B, 0x02, 0x00]

@tier(app)
fn num_bytes() -> [Int]
    [0x20, 0x02, 0x62, 0x00, 0x00, 0x00]

// A body of the class and Flags with `rest` after the Flags and the Length it
// has: for the bodies a test breaks on purpose.
@tier(app)
fn raw_body(class_type: Int, flags: Int, rest: [Int]) -> [u8]
    var out = wire.octets([class_type, 0, 0, flags & 0xFF, flags >>> 8])
    list.append(out, wire.octets(rest))
    let n = list.len(out)
    out[1] = (n & 0xFF) as u8
    out[2] = (n >>> 8) as u8
    out

// A typed body of the class with the Observation Value `value`.
@tier(app)
fn typed(class_type: Int, value: [Int]) -> [u8]
    raw_body(class_type, FLAG_TYPE, cat(type_bytes(), value))

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_numeric_observation_of_the_first_example_has_its_29_octets()
    // [GHSS] A.1.  The example prints the Flags as 0x0023 but lists the Supplemental Information bit (6)
    // and not the Patient bit (5); Table 3.12 puts the Supplemental Information at bit 6, so 0x0043.
    let body = spot_check()
    test.assert_eq(list.len(body), 29)
    test.assert(body == [
        0x01, 0x1D, 0x00, 0x43, 0x00, 0xB8, 0x4B, 0x02, 0x00,
        0x22, 0x72, 0x9D, 0x2B, 0x29, 0x00, 0x00, 0x06, 0x00,
        0x01, 0x3C, 0x4C, 0x02, 0x00, 0x20, 0x02, 0x62, 0x00, 0x00, 0x00])
    test.assert_eq(ghs_body_error(body), BODY_OK)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_compound_observation_of_the_second_example_carries_three_numeric_components_and_an_id()
    // [GHSS] A.2: a blood pressure of 100, 60 and 80 mmHg.  The example gives the Length as 53 and a
    // component 13 octets; the fields it lists add up to 11 octets for a component and 56 for the body.
    var o = ghs_observation(CLASS_COMPOUND, 0x00024A04, ghs_compound_value([
        ghs_component(0x00024A05, 1, ghs_numeric_value(UNIT_MMHG, wire.float(100, 0))),
        ghs_component(0x00024A06, 1, ghs_numeric_value(UNIT_MMHG, wire.float(60, 0))),
        ghs_component(0x00024A07, 1, ghs_numeric_value(UNIT_MMHG, wire.float(80, 0)))]))
    o.time_stamp = stamp()
    o.observation_id = 123456
    let body = ghs_body(o)
    test.assert_eq(ghs_observation_flags(o), 0x0013)
    test.assert(body == [
        0x07, 0x38, 0x00, 0x13, 0x00, 0x04, 0x4A, 0x02, 0x00,
        0x22, 0x72, 0x9D, 0x2B, 0x29, 0x00, 0x00, 0x06, 0x00,
        0x40, 0xE2, 0x01, 0x00, 0x03,
        0x05, 0x4A, 0x02, 0x00, 0x01, 0x20, 0x0F, 0x64, 0x00, 0x00, 0x00,
        0x06, 0x4A, 0x02, 0x00, 0x01, 0x20, 0x0F, 0x3C, 0x00, 0x00, 0x00,
        0x07, 0x4A, 0x02, 0x00, 0x01, 0x20, 0x0F, 0x50, 0x00, 0x00, 0x00])
    test.assert_eq(ghs_body_error(body), BODY_OK)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_compound_discrete_observation_of_the_third_example_derives_from_the_blood_pressure()
    // [GHSS] A.3: cuff loose and cuff improperly placed, derived from the observation 123456.
    var o = ghs_observation(CLASS_COMPOUND_DISCRETE, 0x008055F0, ghs_compound_discrete_value([0x000300F0, 0x000301AE]))
    o.derived_from = [123456]
    let body = ghs_body(o)
    test.assert_eq(list.len(body), 23)
    test.assert(body == [
        0x05, 0x17, 0x00, 0x81, 0x00, 0xF0, 0x55, 0x80, 0x00,
        0x01, 0x40, 0xE2, 0x01, 0x00,
        0x02, 0xF0, 0x00, 0x03, 0x00, 0xAE, 0x01, 0x03, 0x00])
    test.assert_eq(ghs_body_error(body), BODY_OK)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_sample_array_observation_of_the_fourth_example_scales_two_octet_samples()
    // [GHSS] A.4: an ECG lead with the first four samples.  The scale factor 1.612 is the FLOAT with the
    // exponent -3 (0xFD); the example prints the exponent octet as 0x00.
    var o = ghs_observation(CLASS_SAMPLE_ARRAY, 0x00020101, ghs_sample_array_value(
        0x10B2, wire.float(1612, -3), wire.float(2048, 0), wire.float(10, -3), 1, 2, [2041, 2043, 2037, 2047]))
    o.time_stamp = stamp()
    let body = ghs_body(o)
    test.assert_eq(list.len(body), 46)
    test.assert(body == [
        0x04, 0x2E, 0x00, 0x03, 0x00, 0x01, 0x01, 0x02, 0x00,
        0x22, 0x72, 0x9D, 0x2B, 0x29, 0x00, 0x00, 0x06, 0x00,
        0xB2, 0x10, 0x4C, 0x06, 0x00, 0xFD, 0x00, 0x08, 0x00, 0x00, 0x0A, 0x00, 0x00, 0xFD,
        0x01, 0x02, 0x04, 0x00, 0x00, 0x00,
        0xF9, 0x07, 0xFB, 0x07, 0xF5, 0x07, 0xFF, 0x07])
    test.assert_eq(ghs_body_error(body), BODY_OK)
    // Four octets a sample, and three; a sample size the integers cannot hold is no value.
    test.assert_eq(list.len(ghs_sample_array_value(1, 0, 0, 0, 1, 4, [1, 2])), 28)
    test.assert_eq(list.len(ghs_sample_array_value(1, 0, 0, 0, 1, 3, [1, 2])), 26)
    test.assert_eq(list.len(ghs_sample_array_value(1, 0, 0, 0, 1, 9, [1, 2])), 0)
    test.assert_eq(list.len(ghs_sample_array_value(1, 0, 0, 0, 1, 0, [1, 2])), 0)
    // A negative sample is its two's complement.
    test.assert_eq(ghs_sample_array_value(1, 0, 0, 0, 1, 2, [-2])[20:22], [0xFE, 0xFF])

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_bundle_of_the_fifth_example_factors_out_the_time_stamp_and_the_supplemental_information()
    // [GHSS] A.5: oxygen saturation and pulse rate of one spot check.  The example gives the Length as 53;
    // the fields it lists add up to 50.
    let one = ghs_observation(CLASS_NUMERIC, SPO2, ghs_numeric_value(UNIT_PERCENT, wire.float(98, 0)))
    let two = ghs_observation(CLASS_NUMERIC, PULSE, ghs_numeric_value(UNIT_BPM, wire.float(98, 0)))
    var bundle = ghs_observation(CLASS_BUNDLE, -1, ghs_bundle_value([ghs_body(one), ghs_body(two)]))
    bundle.time_stamp = stamp()
    bundle.supplemental = [MODALITY_SPOT]
    let body = ghs_body(bundle)
    test.assert_eq(ghs_observation_flags(bundle), 0x0042)
    test.assert(body == [
        0xFF, 0x32, 0x00, 0x42, 0x00,
        0x22, 0x72, 0x9D, 0x2B, 0x29, 0x00, 0x00, 0x06, 0x00,
        0x01, 0x3C, 0x4C, 0x02, 0x00, 0x02,
        0x01, 0x0F, 0x00, 0x01, 0x00, 0xB8, 0x4B, 0x02, 0x00, 0x20, 0x02, 0x62, 0x00, 0x00, 0x00,
        0x01, 0x0F, 0x00, 0x01, 0x00, 0x1A, 0x48, 0x02, 0x00, 0xA0, 0x0A, 0x62, 0x00, 0x00, 0x00])
    test.assert_eq(ghs_body_error(body), BODY_OK)
    test.assert(ghs_has_time_stamp(body))

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_body_with_every_optional_field_lists_them_in_the_order_of_the_table()
    var o = numeric(98)
    o.time_stamp = stamp()
    o.duration = wire.float(30, 0)
    o.status = STATUS_TEST_DATA | STATUS_MANUALLY_ENTERED
    o.observation_id = 7
    o.patient = 3
    o.supplemental = [MODALITY_SPOT]
    o.derived_from = [123456]
    o.member_of = [123457]
    o.tlvs = [GhsTlv { observation_type: 0x00020001, format: 0x04, value: [5] }]
    test.assert_eq(ghs_observation_flags(o), FLAGS_DEFINED)
    let body = ghs_body(o)
    test.assert_eq(list.len(body), 59)
    test.assert(body == [
        0x01, 0x3B, 0x00, 0xFF, 0x03, 0xB8, 0x4B, 0x02, 0x00,
        0x22, 0x72, 0x9D, 0x2B, 0x29, 0x00, 0x00, 0x06, 0x00,
        0x1E, 0x00, 0x00, 0x00, 0x50, 0x00, 0x07, 0x00, 0x00, 0x00, 0x03,
        0x01, 0x3C, 0x4C, 0x02, 0x00, 0x01, 0x40, 0xE2, 0x01, 0x00, 0x01, 0x41, 0xE2, 0x01, 0x00,
        0x01, 0x01, 0x00, 0x02, 0x00, 0x01, 0x00, 0x04, 0x05,
        0x20, 0x02, 0x62, 0x00, 0x00, 0x00])
    test.assert_eq(ghs_body_error(body), BODY_OK)
    test.assert_eq(ghs_body_patient(body), 3)
    // Each field has its own bit: the Flags of one field at a time.
    var one = numeric(98)
    test.assert_eq(ghs_observation_flags(one), FLAG_TYPE)
    one.observation_type = -1
    test.assert_eq(ghs_observation_flags(one), 0)
    one.time_stamp = stamp()
    test.assert_eq(ghs_observation_flags(one), FLAG_TIME_STAMP)
    one.time_stamp = []
    one.duration = 0
    test.assert_eq(ghs_observation_flags(one), FLAG_DURATION)
    one.duration = -1
    one.status = 0
    test.assert_eq(ghs_observation_flags(one), FLAG_STATUS)
    one.status = -1
    one.observation_id = 0
    test.assert_eq(ghs_observation_flags(one), FLAG_ID)
    one.observation_id = -1
    one.patient = 0
    test.assert_eq(ghs_observation_flags(one), FLAG_PATIENT)
    one.patient = -1
    one.supplemental = [1]
    test.assert_eq(ghs_observation_flags(one), FLAG_SUPPLEMENTAL)
    one.supplemental = []
    one.derived_from = [1]
    test.assert_eq(ghs_observation_flags(one), FLAG_DERIVED_FROM)
    one.derived_from = []
    one.member_of = [1]
    test.assert_eq(ghs_observation_flags(one), FLAG_MEMBER_OF)
    one.member_of = []
    one.tlvs = [GhsTlv { observation_type: 1, format: 4, value: [1] }]
    test.assert_eq(ghs_observation_flags(one), FLAG_TLVS)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_each_class_of_observation_has_the_value_of_its_table()
    // Simple discrete: the MDC code.  String: the length and the text.  State/event: the size and three masks.
    test.assert_eq(ghs_discrete_value(0x00030001), [0x01, 0x00, 0x03, 0x00])
    test.assert_eq(ghs_string_value(wire.text("Man")), [0x03, 0x00, 0x4D, 0x61, 0x6E])
    test.assert_eq(ghs_string_value([]), [0x00, 0x00])
    test.assert_eq(ghs_state_event_value([0xFF], [0x0F], [0x05]), [0x01, 0xFF, 0x0F, 0x05])
    test.assert_eq(ghs_state_event_value([0xFF, 0x01], [0x0F, 0x00], [0x05, 0x01]), [0x02, 0xFF, 0x01, 0x0F, 0x00, 0x05, 0x01])
    // The three masks are of one size.
    test.assert_eq(list.len(ghs_state_event_value([0xFF], [0x0F, 0x00], [0x05])), 0)
    test.assert_eq(list.len(ghs_state_event_value([0xFF], [0x0F], [])), 0)
    // The TLV value: the count and each attribute with its length and Format Type.
    test.assert_eq(ghs_tlv_value([GhsTlv { observation_type: 0x00020001, format: 0x19, value: wire.text("ab") }]), [0x01, 0x01, 0x00, 0x02, 0x00, 0x02, 0x00, 0x19, 0x61, 0x62])
    test.assert_eq(ghs_tlv_value([]), [0x00])
    // Every class makes a body that passes the check.
    let words = ghs_observation(CLASS_STRING, SPO2, ghs_string_value(wire.text("Man")))
    test.assert_eq(ghs_body_error(ghs_body(words)), BODY_OK)
    let discrete = ghs_observation(CLASS_DISCRETE, SPO2, ghs_discrete_value(0x00030001))
    test.assert_eq(ghs_body_error(ghs_body(discrete)), BODY_OK)
    let masks = ghs_observation(CLASS_COMPOUND_STATE_EVENT, SPO2, ghs_state_event_value([0xFF], [0x0F], [0x05]))
    test.assert_eq(ghs_body_error(ghs_body(masks)), BODY_OK)
    let events = ghs_observation(CLASS_COMPOUND_DISCRETE, SPO2, ghs_compound_discrete_value([1, 2, 3]))
    test.assert_eq(ghs_body_error(ghs_body(events)), BODY_OK)
    let attributes = ghs_observation(CLASS_TLV, SPO2, ghs_tlv_value([GhsTlv { observation_type: 1, format: 0x08, value: [1, 0, 0, 0] }]))
    test.assert_eq(ghs_body_error(ghs_body(attributes)), BODY_OK)
    // A compound observation of one component of each value type.
    let components = [
        ghs_component(1, 1, ghs_numeric_value(UNIT_PERCENT, wire.float(1, 0))),
        ghs_component(2, 2, ghs_discrete_value(5)),
        ghs_component(3, 3, ghs_string_value(wire.text("ok"))),
        ghs_component(4, 4, ghs_sample_array_value(1, 0, 0, 0, 1, 1, [1, 2])),
        ghs_component(5, 5, ghs_compound_discrete_value([9])),
        ghs_component(6, 6, ghs_state_event_value([1], [1], [1]))]
    let compound = ghs_observation(CLASS_COMPOUND, SPO2, ghs_compound_value(components))
    test.assert_eq(ghs_body_error(ghs_body(compound)), BODY_OK)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_body_that_breaks_the_fixed_part_is_refused_with_its_error()
    let good = typed(CLASS_NUMERIC, num_bytes())
    test.assert_eq(ghs_body_error(good), BODY_OK)
    // Fewer than the five octets of the class, the Length and the Flags.
    test.assert_eq(ghs_body_error([]), BODY_TOO_SHORT)
    test.assert_eq(ghs_body_error([1, 4, 0, 0]), BODY_TOO_SHORT)
    // The Observation Class Type: 0 and 9 to 254 are RFU.
    for c in [0, 9, 10, 100, 254]
        test.assert_eq(ghs_body_error(typed(c, num_bytes())), BODY_CLASS)
    for c in [1, 2, 3, 4, 5, 6, 7, 8, 255]
        test.assert(ghs_body_error(typed(c, num_bytes())) != BODY_CLASS)
    // The Length is the octets of the body.
    var longer = typed(CLASS_NUMERIC, num_bytes())
    longer[1] = 0x20
    test.assert_eq(ghs_body_error(longer), BODY_LENGTH)
    var shorter = typed(CLASS_NUMERIC, num_bytes())
    shorter[1] = 0x05
    test.assert_eq(ghs_body_error(shorter), BODY_LENGTH)
    var high = typed(CLASS_NUMERIC, num_bytes())
    high[2] = 0x01
    test.assert_eq(ghs_body_error(high), BODY_LENGTH)
    // Flags 10 to 15 are RFU.
    for f in [0x0401, 0x0801, 0x1001, 0x2001, 0x4001, 0x8001]
        test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, f, cat(type_bytes(), num_bytes()))), BODY_FLAGS)
    // A single observation has its Observation Type.
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0, num_bytes())), BODY_NO_TYPE)
    test.assert_eq(ghs_body_error(raw_body(CLASS_DISCRETE, 0, [1, 2, 3, 4])), BODY_NO_TYPE)
    // Octets after the value.
    test.assert_eq(ghs_body_error(typed(CLASS_NUMERIC, cat(num_bytes(), [0]))), BODY_TRAILING)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_optional_fields_are_checked_for_their_size_and_their_rules()
    // The Time Stamp is nine octets.
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0003, cat(type_bytes(), [1, 2, 3]))), BODY_FIELD)
    // The Measurement Duration is a FLOAT that is not the reserved value; NaN is allowed.
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0005, cat(cat(type_bytes(), [0x01, 0x00, 0x80, 0x00]), num_bytes()))), BODY_FIELD)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0005, cat(cat(type_bytes(), [0xFF, 0xFF, 0x7F, 0x00]), num_bytes()))), BODY_OK)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0005, cat(type_bytes(), [0x01, 0x00]))), BODY_FIELD)
    // The Measurement Status: the bits 8 to 13 are RFU and the two threshold bits are not both set.
    for s in [[0x00, 0x01], [0x00, 0x02], [0x00, 0x04], [0x00, 0x08], [0x00, 0x10], [0x00, 0x20], [0x00, 0xC0], [0x00, 0xFF]]
        test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0009, cat(cat(type_bytes(), s), num_bytes()))), BODY_STATUS)
    for s in [[0x00, 0x00], [0xFF, 0x00], [0x00, 0x40], [0x00, 0x80], [0xFF, 0x40], [0xFF, 0x80]]
        test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0009, cat(cat(type_bytes(), s), num_bytes()))), BODY_OK)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0009, cat(type_bytes(), [0x00]))), BODY_FIELD)
    // The Observation Id is four octets, the Patient one.
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0011, cat(type_bytes(), [1, 2]))), BODY_FIELD)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0021, type_bytes())), BODY_FIELD)
    // The lists hold the number of codes their count says.
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0041, cat(type_bytes(), [5, 1, 2, 3, 4]))), BODY_FIELD)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0081, cat(type_bytes(), []))), BODY_FIELD)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0101, cat(type_bytes(), [2, 1, 2, 3, 4]))), BODY_FIELD)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0041, cat(cat(type_bytes(), [1, 1, 2, 3, 4]), num_bytes()))), BODY_OK)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, 0x0041, cat(cat(type_bytes(), [0]), num_bytes()))), BODY_OK)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_tlv_attributes_are_checked_for_their_format_and_size()
    let flags = 0x0201
    // A uint8 of one octet, a UTF-8 string of three, an ASN.1 structure of two, and two attributes at once.
    for tlv in [[1, 1, 0, 2, 0, 1, 0, 0x04, 5], [1, 1, 0, 2, 0, 3, 0, 0x19, 0x61, 0x62, 0x63], [1, 1, 0, 2, 0, 2, 0, 0x1C, 0xAA, 0xBB],
        [2, 1, 0, 2, 0, 1, 0, 0x04, 5, 2, 0, 2, 0, 2, 0, 0x06, 7, 0], [0]]
        test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, flags, cat(cat(type_bytes(), tlv), num_bytes()))), BODY_OK)
    // The Format Type 0 and the values above 0x1C are not in the table of the Assigned Numbers.
    for tlv in [[1, 1, 0, 2, 0, 1, 0, 0x00, 5], [1, 1, 0, 2, 0, 1, 0, 0x1D, 5], [1, 1, 0, 2, 0, 1, 0, 0xFF, 5]]
        test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, flags, cat(cat(type_bytes(), tlv), num_bytes()))), BODY_FIELD)
    // A fixed-size format has a value of its size: uint8 of two octets, uint16 of one, uint32 of three.
    for tlv in [[1, 1, 0, 2, 0, 2, 0, 0x04, 5, 6], [1, 1, 0, 2, 0, 1, 0, 0x06, 5], [1, 1, 0, 2, 0, 3, 0, 0x08, 1, 2, 3]]
        test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, flags, cat(cat(type_bytes(), tlv), num_bytes()))), BODY_FIELD)
    // A value that runs past the body, and a header that does.
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, flags, cat(type_bytes(), [1, 1, 0, 2, 0, 9, 0, 0x19, 1, 2]))), BODY_FIELD)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, flags, cat(type_bytes(), [1, 1, 0, 2]))), BODY_FIELD)
    test.assert_eq(ghs_body_error(raw_body(CLASS_NUMERIC, flags, type_bytes())), BODY_FIELD)
    // The sizes of the fixed formats.
    for (kind, size) in [(0x01, 1), (0x04, 1), (0x05, 2), (0x07, 3), (0x08, 4), (0x09, 6), (0x0A, 8), (0x0B, 16), (0x14, 4), (0x15, 8), (0x16, 2), (0x17, 4), (0x18, 4), (0x19, 0), (0x1A, 0), (0x1B, 0), (0x1C, 0), (0x00, -1), (0x1D, -1)]
        test.assert_eq(ghs_format_octets(kind), size)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_values_of_the_classes_are_checked_for_their_size_and_their_rules()
    // Numeric: six octets with a FLOAT that is not the reserved value.
    test.assert_eq(ghs_body_error(typed(CLASS_NUMERIC, [0x20, 0x02, 0x62, 0x00, 0x00])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_NUMERIC, [0x20, 0x02, 0x01, 0x00, 0x80, 0x00])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_NUMERIC, [0x20, 0x02, 0xFF, 0xFF, 0x7F, 0x00])), BODY_OK)
    // Simple discrete: four octets.
    test.assert_eq(ghs_body_error(typed(CLASS_DISCRETE, [1, 2, 3])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_DISCRETE, [1, 2, 3, 4])), BODY_OK)
    // String: the length, the text, UTF-8.
    test.assert_eq(ghs_body_error(typed(CLASS_STRING, [3, 0, 0x61, 0x62])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_STRING, [1])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_STRING, [0, 0])), BODY_OK)
    test.assert_eq(ghs_body_error(typed(CLASS_STRING, [2, 0, 0xC3, 0xA9])), BODY_OK)
    test.assert_eq(ghs_body_error(typed(CLASS_STRING, [4, 0, 0xF0, 0x9F, 0x98, 0x80])), BODY_OK)
    test.assert_eq(ghs_body_error(typed(CLASS_STRING, [2, 0, 0xC0, 0x80])), BODY_STRING)
    test.assert_eq(ghs_body_error(typed(CLASS_STRING, [3, 0, 0xED, 0xA0, 0x80])), BODY_STRING)
    test.assert_eq(ghs_body_error(typed(CLASS_STRING, [2, 0, 0xC3, 0x28])), BODY_STRING)
    // Sample array: a header of 20 octets, one or more samples per period and octets per sample, the samples.
    let head = [0xB2, 0x10, 0x4C, 0x06, 0x00, 0xFD, 0x00, 0x08, 0x00, 0x00, 0x0A, 0x00, 0x00, 0xFD]
    test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, cat(head, [1, 2, 3, 0, 0, 0, 1, 2, 3, 4, 5, 6]))), BODY_OK)
    test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, cat(head, [0, 2, 3, 0, 0, 0, 1, 2, 3, 4, 5, 6]))), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, cat(head, [1, 0, 3, 0, 0, 0, 1, 2, 3, 4, 5, 6]))), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, cat(head, [1, 2, 4, 0, 0, 0, 1, 2, 3, 4, 5, 6]))), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, cat(head, [1, 2, 3, 0, 0, 0, 1, 2, 3, 4, 5]))), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, cat(head, [1, 2]))), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, cat(head, [1, 2, 0, 0, 0, 0]))), BODY_OK)
    // A reserved FLOAT in the scale factor, the offset or the period.
    for at in [2, 6, 10]
        var reserved = cat(head, [1, 2, 3, 0, 0, 0, 1, 2, 3, 4, 5, 6])
        reserved[at] = 0x01
        reserved[at + 1] = 0x00
        reserved[at + 2] = 0x80
        reserved[at + 3] = 0x00
        test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, reserved)), BODY_VALUE)
    // A count of samples that the octets cannot hold, however large.
    test.assert_eq(ghs_body_error(typed(CLASS_SAMPLE_ARRAY, cat(head, [1, 255, 0xFF, 0xFF, 0xFF, 0xFF, 1, 2]))), BODY_VALUE)
    // Compound discrete event: the count of four-octet codes.
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND_DISCRETE, [2, 1, 2, 3, 4])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND_DISCRETE, [1, 1, 2, 3, 4])), BODY_OK)
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND_DISCRETE, [])), BODY_VALUE)
    // Compound state/event: the size and three masks of it.
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND_STATE_EVENT, [2, 1, 2, 3, 4, 5])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND_STATE_EVENT, [2, 1, 2, 3, 4, 5, 6])), BODY_OK)
    // TLV-encoded: the list of attributes.
    test.assert_eq(ghs_body_error(typed(CLASS_TLV, [1, 1, 0, 2, 0, 5, 0, 0x04, 5])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_TLV, [1, 1, 0, 2, 0, 1, 0, 0x04, 5])), BODY_OK)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_components_of_a_compound_observation_have_the_types_of_the_table()
    let good = ghs_component(1, 1, ghs_numeric_value(UNIT_PERCENT, wire.float(1, 0)))
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND, ghs_compound_value([good]))), BODY_OK)
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND, ghs_compound_value([]))), BODY_OK)
    // The Component Value Type 0 and 7 to 255 are RFU.
    for t in [0, 7, 8, 255]
        test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND, ghs_compound_value([ghs_component(1, t, ghs_discrete_value(1))]))), BODY_VALUE)
    // A component cut short, a count that promises more, and a bad value inside a component.
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND, [1, 1, 2, 3, 4])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND, [2, 1, 0, 0, 0, 1, 0x20, 0x02, 0x62, 0, 0, 0])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND, [1, 1, 0, 0, 0, 1, 0x20, 0x02, 0x62, 0, 0])), BODY_VALUE)
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND, ghs_compound_value([ghs_component(1, 3, ghs_string_value([0xC0, 0x80]))]))), BODY_STRING)
    // Octets after the last component.
    test.assert_eq(ghs_body_error(typed(CLASS_COMPOUND, cat(ghs_compound_value([good]), [0]))), BODY_TRAILING)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_bundle_holds_bodies_that_are_not_bundles_and_names_the_type_once_or_each_time()
    let one = typed(CLASS_NUMERIC, num_bytes())
    let untyped = raw_body(CLASS_NUMERIC, 0, num_bytes())
    // A bundle with no observation is allowed; a bundle has no Observation Id.
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, [0])), BODY_OK)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, FLAG_ID, [1, 0, 0, 0, 0])), BODY_BUNDLE_ID)
    // Each observation names its type, or the bundle does for all.
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, cat([1], ints(one)))), BODY_OK)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, cat([1], ints(untyped)))), BODY_NO_TYPE)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, FLAG_TYPE, cat(type_bytes(), cat([1], ints(untyped))))), BODY_OK)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, FLAG_TYPE, cat(type_bytes(), cat([1], ints(one))))), BODY_OK)
    // A bundle in a bundle.
    let inner = raw_body(CLASS_BUNDLE, 0, [0])
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, cat([1], ints(inner)))), BODY_NESTED_BUNDLE)
    // A count that promises more bodies, a body whose Length runs past the bundle, a body shorter than its header,
    // a bad observation inside, and octets after the last.
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, cat([2], ints(one)))), BODY_VALUE)
    var past = one[:]
    past[1] = 0x40
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, cat([1], ints(past)))), BODY_VALUE)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, [1, 1, 3, 0, 0, 0])), BODY_VALUE)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, cat([1], ints(typed(CLASS_NUMERIC, [1, 2]))))), BODY_VALUE)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, cat(cat([1], ints(one)), [0]))), BODY_TRAILING)
    // The bundle takes the same optional fields: here a time stamp.
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, FLAG_TIME_STAMP, cat(ints(stamp()), cat([1], ints(one))))), BODY_OK)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, FLAG_TIME_STAMP, [1, 2, 3])), BODY_FIELD)
    test.assert_eq(ghs_body_error(raw_body(CLASS_BUNDLE, 0, [])), BODY_VALUE)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_patient_and_the_time_stamp_are_found_in_a_body_and_in_a_bundle()
    test.assert_eq(ghs_body_patient(live_body(98)), -1)
    test.assert_eq(ghs_body_patient(stamped_body(98, 5)), 5)
    test.assert_eq(ghs_body_patient(stamped_body(98, 0)), 0)
    test.assert_eq(ghs_body_patient(stamped_body(98, 255)), 255)
    test.assert_eq(ghs_body_patient([]), -1)
    test.assert_eq(ghs_body_patient([1, 5, 0, 0x20, 0x00]), -1)
    test.assert(ghs_has_time_stamp(spot_check()))
    test.assert(not ghs_has_time_stamp(live_body(98)))
    test.assert(not ghs_has_time_stamp([]))
    // A bundle has a time stamp of its own or one in each bundled observation.
    var stamped = numeric(98)
    stamped.time_stamp = stamp()
    let with_stamp = ghs_body(stamped)
    let without = live_body(98)
    var own = ghs_observation(CLASS_BUNDLE, -1, ghs_bundle_value([without]))
    own.time_stamp = stamp()
    test.assert(ghs_has_time_stamp(ghs_body(own)))
    test.assert(ghs_has_time_stamp(ghs_body(ghs_observation(CLASS_BUNDLE, -1, ghs_bundle_value([with_stamp, with_stamp])))))
    test.assert(not ghs_has_time_stamp(ghs_body(ghs_observation(CLASS_BUNDLE, -1, ghs_bundle_value([with_stamp, without])))))
    test.assert(not ghs_has_time_stamp(ghs_body(ghs_observation(CLASS_BUNDLE, -1, ghs_bundle_value([])))))

@test
@satisfies("REQ-BLE-GHS-001")
fn test_a_body_is_cut_into_segments_of_the_mtu_less_four_with_a_header_and_a_rolling_counter()
    test.assert_eq(ghs_segment_count(0, 19), 0)
    test.assert_eq(ghs_segment_count(1, 19), 1)
    test.assert_eq(ghs_segment_count(19, 19), 1)
    test.assert_eq(ghs_segment_count(20, 19), 2)
    test.assert_eq(ghs_segment_count(38, 19), 2)
    test.assert_eq(ghs_segment_count(39, 19), 3)
    test.assert_eq(ghs_segment_count(5, 0), 0)
    // One segment is first and last; the counter is in bits 2 to 7.
    test.assert_eq(ghs_segment_header(0, 1, 0), 0x03)
    test.assert_eq(ghs_segment_header(0, 1, 5), 0x17)
    // Several: the first has bit 0, the last bit 1, the ones between neither, the counter goes up by one.
    test.assert_eq(ghs_segment_header(0, 3, 10), 0x29)
    test.assert_eq(ghs_segment_header(1, 3, 10), 0x2C)
    test.assert_eq(ghs_segment_header(2, 3, 10), 0x32)
    // From 63 to 0.
    test.assert_eq(ghs_segment_header(0, 3, 62), 0xF9)
    test.assert_eq(ghs_segment_header(1, 3, 62), 0xFC)
    test.assert_eq(ghs_segment_header(2, 3, 62), 0x02)
    test.assert_eq(ghs_segment_header(0, 2, 63), 0xFD)
    test.assert_eq(ghs_segment_header(1, 2, 63), 0x02)
    // 45 octets in segments of 19: three, the last one short.
    var data: [u8] = []
    for i in 0..45
        list.push(data, i as u8)
    let segments = ghs_segments(data, 19, 62)
    test.assert_eq(list.len(segments), 3)
    test.assert_eq(list.len(segments[0]), 20)
    test.assert_eq(list.len(segments[1]), 20)
    test.assert_eq(list.len(segments[2]), 8)
    test.assert_eq(segments[0][0] as Int, 0xF9)
    test.assert_eq(segments[1][0] as Int, 0xFC)
    test.assert_eq(segments[2][0] as Int, 0x02)
    var joined: [u8] = []
    for segment in segments
        list.append(joined, segment[1:])
    test.assert_eq(joined, data)
    test.assert_eq(list.len(ghs_segments(data, 0, 0)), 0)
    test.assert_eq(list.len(ghs_segments([], 19, 0)), 0)

// ── Tests: live observations ────────────────────────────────────────

// A notification (0x1B) or indication (0x1D) of `handle` with the Segmentation
// Header `header` and the data.
@tier(app)
fn segment_pdu(op: Int, handle: Int, header: Int, data: [u8]) -> [u8]
    var out = wire.octets([op, handle & 0xFF, handle >>> 8, header])
    list.append(out, data)
    out

// The collector enables the control point, writes Start sending live
// observations and gets the success indication, which it confirms.
@tier(app)
fn start_live(var s: GattServer, h: GhsHandles, config: GhsConfig, var st: GhsState)
    subscribe(var s, h.control_point_cccd, 2)
    let out = write(var s, h, config, var st, h.control_point, [OP_START])
    test.assert_eq(list.len(out), 2)
    test.assert_eq(out[0], [0x13])
    test.assert_eq(out[1], wire.octets([0x1D, h.control_point & 0xFF, h.control_point >>> 8, RESULT_CONTROL_POINT_SUCCESS]))
    test.assert(st.live_started)
    let _ = confirm(var s)

// A numeric SpO2 observation of `value` percent for the user `patient`, with no time stamp.
@tier(app)
fn patient_body(value: Int, patient: Int) -> [u8]
    var o = numeric(value)
    o.patient = patient
    ghs_body(o)

@test
@satisfies("REQ-BLE-GHS-001")
fn test_live_observations_go_out_as_notifications_only_after_the_start_command()
    let c = live_config(true, false)
    var (s, h) = rig(c)
    var st = new_ghs_state()
    subscribe(var s, h.live_cccd, 1)
    let body = spot_check()
    test.assert_eq(ghs_submit(var st, c, body, false), SUBMIT_OK)
    // The collector has not started the observations: none goes out, and the queue keeps it.
    test.assert_eq(list.len(pump(var s, h, c, var st)), 0)
    test.assert_eq(ghs_live_count(st), 1)
    start_live(var s, h, c, var st)
    // 29 octets in segments of ATT_MTU - 4 = 19 octets: the first, then the last, the counter 0 and 1.
    let out = pump(var s, h, c, var st)
    test.assert_eq(list.len(out), 2)
    test.assert_eq(out[0], segment_pdu(0x1B, h.live, 0x01, body[0:19]))
    test.assert_eq(out[1], segment_pdu(0x1B, h.live, 0x06, body[19:29]))
    test.assert_eq(segment_data(out), body)
    // Nothing else goes out; the observation leaves the queue at the next call.
    test.assert_eq(list.len(pump(var s, h, c, var st)), 0)
    test.assert_eq(ghs_live_count(st), 0)
    // The Rolling Segment Counter goes on from 2: a body of one segment is first and last.
    test.assert_eq(ghs_submit(var st, c, live_body(97), false), SUBMIT_OK)
    let next = pump(var s, h, c, var st)
    test.assert_eq(list.len(next), 1)
    test.assert_eq(next[0], segment_pdu(0x1B, h.live, 0x0B, live_body(97)))

@test
@satisfies("REQ-BLE-GHS-001")
fn test_the_stop_command_ends_the_live_observations_until_the_next_start()
    let c = live_config(true, false)
    var (s, h) = rig(c)
    var st = new_ghs_state()
    subscribe(var s, h.live_cccd, 1)
    start_live(var s, h, c, var st)
    let stop = write(var s, h, c, var st, h.control_point, [OP_STOP])
    test.assert_eq(stop[0], [0x13])
    test.assert_eq(stop[1], wire.octets([0x1D, h.control_point, 0, RESULT_CONTROL_POINT_SUCCESS]))
    test.assert(not st.live_started)
    let _ = confirm(var s)
    // An observation generated now stays in the queue.
    test.assert_eq(ghs_submit(var st, c, live_body(96), false), SUBMIT_OK)
    test.assert_eq(list.len(pump(var s, h, c, var st)), 0)
    test.assert_eq(ghs_live_count(st), 1)
    // Start again: it goes out.
    let again = write(var s, h, c, var st, h.control_point, [OP_START])
    test.assert_eq(again[1], wire.octets([0x1D, h.control_point, 0, RESULT_CONTROL_POINT_SUCCESS]))
    let _ = confirm(var s)
    let out = pump(var s, h, c, var st)
    test.assert_eq(list.len(out), 1)
    test.assert_eq(out[0], segment_pdu(0x1B, h.live, 0x03, live_body(96)))

@test
@satisfies("REQ-BLE-GHS-001")
fn test_live_observations_over_indications_wait_for_each_confirmation_and_leave_the_queue_after_the_last()
    let c = live_config(false, true)
    var (s, h) = rig(c)
    var st = new_ghs_state()
    subscribe(var s, h.live_cccd, 2)
    start_live(var s, h, c, var st)
    let body = spot_check()
    test.assert_eq(ghs_submit(var st, c, body, false), SUBMIT_OK)
    test.assert_eq(ghs_submit(var st, c, live_body(95), false), SUBMIT_OK)
    // The first segment is indicated, the second waits behind it for the confirmation.
    let first = pump(var s, h, c, var st)
    test.assert_eq(list.len(first), 1)
    test.assert_eq(first[0], segment_pdu(0x1D, h.live, 0x01, body[0:19]))
    test.assert_eq(list.len(pump(var s, h, c, var st)), 0)
    let second = confirm(var s)
    test.assert_eq(list.len(second), 1)
    test.assert_eq(second[0], segment_pdu(0x1D, h.live, 0x06, body[19:29]))
    test.assert_eq(list.len(pump(var s, h, c, var st)), 0)
    test.assert_eq(ghs_live_count(st), 2)
    test.assert_eq(list.len(confirm(var s)), 0)
    // The last segment is confirmed: the observation is gone and the next one goes out.
    let next = pump(var s, h, c, var st)
    test.assert_eq(list.len(next), 1)
    test.assert_eq(next[0], segment_pdu(0x1D, h.live, 0x0B, live_body(95)))
    test.assert_eq(ghs_live_count(st), 1)
    test.assert_eq(list.len(confirm(var s)), 0)
    test.assert_eq(list.len(pump(var s, h, c, var st)), 0)
    test.assert_eq(ghs_live_count(st), 0)

