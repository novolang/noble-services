// tests/insulin_delivery_command_tests.nv — the unit tests of src/insulin_delivery_command.nv.
//
//   novo test tests/insulin_delivery_command_tests.nv

use std.test
use gatt_server
use fixtures.{ req, subscribe, read }
use insulin_delivery
use profile_builder
use wire
use insulin_delivery_command.{ ALL_FEATURES, AVAILABLE_FAST, AVAILABLE_MULTIWAVE, CMD_CANCEL_BOLUS, CMD_CANCEL_TBR_ADJUSTMENT, CMD_CONFIRM_ANNUNCIATION, CMD_GET_AVAILABLE_BOLUSES, CMD_GET_MAX_BOLUS_AMOUNT, CMD_RESET_RESERVOIR_INSULIN_OPERATION_TIME, CMD_SET_BOLUS, CMD_SET_FLIGHT_MODE, CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, CMD_SET_MAX_BOLUS_AMOUNT, CMD_SET_TBR_ADJUSTMENT, CMD_SET_THERAPY_CONTROL_STATE, CMD_SNOOZE_ANNUNCIATION, CMD_START_PRIMING, CMD_STOP_PRIMING, IdsCommand, IdsCommandConfig, IdsCommandHandles, add_ids_command, fresh_command, ids_annunciation_snooze_over, ids_command_offered, ids_command_receive, ids_command_set_available, setup }

// A pump with every feature and the three bolus types free; the config of the limits.
@tier(app)
fn rig(features: Int, dev: insulin_delivery.IdsDevice) -> (GattServer, insulin_delivery.IdsHandles, IdsCommandHandles, insulin_delivery.IdsConfig)
    let config = insulin_delivery.IdsConfig {
        access: gatt_server.Access.Authenticated, features: features, concentration: wire.sfloat(100, 0), features_indicate: false,
        get_counter: false, get_delivered: false }
    var built = insulin_delivery.server(config, dev)
    var s = built.0
    var d = dev
    let ch = add_ids_command(var s.db, config, var d)!
    subscribe(var s, built.1.reader_cccd as Int, 2)
    subscribe(var s, ch.control_cccd as Int, 2)
    subscribe(var s, ch.data_cccd as Int, 1)
    (s, built.1, ch, config)

@tier(app)
fn command(op: Int, operand: [Int]) -> [u8]
    insulin_delivery.request(0, op, operand, 0)

@tier(app)
fn write_command(var s: GattServer, var dev: insulin_delivery.IdsDevice, var cmd: IdsCommand, hs: insulin_delivery.IdsHandles, ch: IdsCommandHandles, config: insulin_delivery.IdsConfig, value: [u8]) -> [[u8]]
    var pdu: [u8] = [0x12, (ch.control & 0xFF) as u8, (ch.control >>> 8) as u8]
    list.append(pdu, value)
    ids_command_receive(var s.db, var s.link, hs, ch, config, var dev, var cmd, pdu, 0)

@tier(app)
fn confirm(var s: GattServer)
    let _ = gatt_server.receive(var s.db, var s.link, [0x1E], 0)

// The value indicated in answer to a write: the Write Response, then the indication.
@tier(app)
fn indicated(answer: [[u8]]) -> [u8]
    test.assert_eq(answer[0], [0x13])
    test.assert_eq(answer[1][0] as Int, 0x1D)
    answer[1][3:]

// The Response Code record of `op` with `code`.
@tier(app)
fn code_of(op: Int, code: Int) -> [u8]
    wire.octets([0x55, 0x0F, op & 0xFF, op >>> 8, code])

@test
@satisfies("REQ-BLE-IDS-003")
fn test_the_command_characteristics_follow_the_status_reader()
    let dev = setup()
    let (s, hs, ch, config) = rig(ALL_FEATURES, dev)
    test.assert_eq(hs.reader, 14)
    test.assert_eq(ch.control, 17)
    test.assert_eq(ch.control_cccd, 18)
    test.assert_eq(ch.data, 20)
    test.assert_eq(ch.data_cccd, 21)
    test.assert_eq(gatt_server.last_handle(s.db), 21)
    // Write, Indicate: 0x28; Notify: 0x10.
    test.assert_eq(s.db.attributes[15].value, [0x28, 17, 0, 0x25, 0x2B])
    test.assert_eq(s.db.attributes[18].value, [0x10, 20, 0, 0x26, 0x2B])

@test
@satisfies("REQ-BLE-IDS-003")
fn test_set_therapy_control_state_takes_stop_pause_and_run_with_a_reservoir()
    // IDS/SEN/CCP/BV-01-C and CCPE/BI-02-C.
    var dev = setup()
    var cmd = fresh_command()
    let (s0, hs, ch, config) = rig(ALL_FEATURES, dev)
    var s = s0
    var out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_THERAPY_CONTROL_STATE, [0x55]))
    test.assert_eq(indicated(out), code_of(CMD_SET_THERAPY_CONTROL_STATE, 0x0F))
    test.assert_eq(dev.therapy, insulin_delivery.THERAPY_RUN)
    test.assert_eq(dev.changed & insulin_delivery.CHANGED_THERAPY_CONTROL_STATE, insulin_delivery.CHANGED_THERAPY_CONTROL_STATE)
    // Undetermined and a reserved value are invalid; the wrong size is too.
    let no_operand: [Int] = []
    let operands = [[0x0F], [0x01], no_operand]
    for operand in operands
        confirm(var s)
        out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_THERAPY_CONTROL_STATE, operand))
        test.assert_eq(indicated(out), code_of(CMD_SET_THERAPY_CONTROL_STATE, 0x71))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_THERAPY_CONTROL_STATE, [0x3C]))
    test.assert_eq(dev.therapy, insulin_delivery.THERAPY_PAUSE)
    // Run without a reservoir does not apply.
    test.assert(insulin_delivery.ids_set_reservoir(var dev, false, 0))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_THERAPY_CONTROL_STATE, [0x55]))
    test.assert_eq(indicated(out), code_of(CMD_SET_THERAPY_CONTROL_STATE, 0x74))
    test.assert_eq(dev.therapy, insulin_delivery.THERAPY_PAUSE)

@test
@satisfies("REQ-BLE-IDS-003")
fn test_flight_mode_and_the_op_codes_the_pump_does_not_offer()
    // IDS/SEN/CCP/BV-02-C and CCPE/BI-01-C.
    var dev = setup()
    var cmd = fresh_command()
    let (s0, hs, ch, config) = rig(ALL_FEATURES, dev)
    var s = s0
    var out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_FLIGHT_MODE, []))
    test.assert_eq(indicated(out), code_of(CMD_SET_FLIGHT_MODE, 0x0F))
    test.assert(cmd.flight_mode)
    // A template procedure, a response Op Code and a value outside the code are not supported.
    for op in [0x0FAA, 0x0FCC, 0x118E, 0x1212, 0x0F55, 0x1177, 0x0000, 0x1B7D]
        confirm(var s)
        out = write_command(var s, var dev, var cmd, hs, ch, config, command(op, []))
        test.assert_eq(indicated(out), code_of(op, 0x70))
    // A pump without TBR or bolus features lacks those Op Codes, and one without the optional procedures lacks them.
    var bare_dev = insulin_delivery.new_ids_device(0)
    var bare = fresh_command()
    let (bs0, bhs, bch, bconfig) = rig(0, bare_dev)
    var bs = bs0
    for op in [CMD_SET_TBR_ADJUSTMENT, CMD_CANCEL_TBR_ADJUSTMENT, CMD_SET_BOLUS, CMD_CANCEL_BOLUS, CMD_GET_AVAILABLE_BOLUSES]
        confirm(var bs)
        out = write_command(var bs, var bare_dev, var bare, bhs, bch, bconfig, command(op, []))
        test.assert_eq(indicated(out), code_of(op, 0x70))
    let none = IdsCommandConfig {
        priming: false, fill_level: false, operation_time: false, max_bolus: false, tbr_value_max: 0, tbr_duration_max: 0, bolus_amount_max: 0,
        bolus_duration_max: 0, bolus_delay_max: 0, fill_level_max: 0, priming_max: 0, operation_time_default: 0 }
    test.assert(not ids_command_offered(ALL_FEATURES, none, CMD_START_PRIMING))
    test.assert(not ids_command_offered(ALL_FEATURES, none, CMD_STOP_PRIMING))
    test.assert(not ids_command_offered(ALL_FEATURES, none, CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL))
    test.assert(not ids_command_offered(ALL_FEATURES, none, CMD_RESET_RESERVOIR_INSULIN_OPERATION_TIME))
    test.assert(not ids_command_offered(ALL_FEATURES, none, CMD_GET_MAX_BOLUS_AMOUNT))
    test.assert(not ids_command_offered(ALL_FEATURES, none, CMD_SET_MAX_BOLUS_AMOUNT))

@test
@satisfies("REQ-BLE-IDS-003")
fn test_snooze_and_confirm_change_the_status_of_the_annunciation_they_name()
    // IDS/SEN/CCP/BV-03-C, BV-04-C, BV-05-C.
    var dev = setup()
    var cmd = fresh_command()
    let (s0, hs, ch, config) = rig(ALL_FEATURES, dev)
    var s = s0
    test.assert(insulin_delivery.ids_set_annunciation(var dev, insulin_delivery.ids_annunciation(0x0102, 0x0066, insulin_delivery.ANNUNCIATION_PENDING)))
    // An annunciation that does not exist does not apply.
    var out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SNOOZE_ANNUNCIATION, [0x07, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_SNOOZE_ANNUNCIATION, 0x74))
    confirm(var s)
    dev.changed = 0
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SNOOZE_ANNUNCIATION, [0x02, 0x01]))
    test.assert_eq(indicated(out), wire.octets([0x96, 0x0F, 0x02, 0x01]))
    test.assert_eq(dev.annunciation.status, insulin_delivery.ANNUNCIATION_SNOOZED)
    test.assert_eq(dev.changed, insulin_delivery.CHANGED_ANNUNCIATION_STATUS)
    // The snoozing time is over: Pending again.
    test.assert(ids_annunciation_snooze_over(var dev))
    test.assert_eq(dev.annunciation.status, insulin_delivery.ANNUNCIATION_PENDING)
    test.assert(not ids_annunciation_snooze_over(var dev))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_CONFIRM_ANNUNCIATION, [0x02, 0x01]))
    test.assert_eq(indicated(out), wire.octets([0xA5, 0x0F, 0x02, 0x01]))
    test.assert(not dev.annunciation.present)
    // A confirmed annunciation is no longer there to confirm or snooze.
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_CONFIRM_ANNUNCIATION, [0x02, 0x01]))
    test.assert_eq(indicated(out), code_of(CMD_CONFIRM_ANNUNCIATION, 0x74))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SNOOZE_ANNUNCIATION, [0x02]))
    test.assert_eq(indicated(out), code_of(CMD_SNOOZE_ANNUNCIATION, 0x71))

@test
@satisfies("REQ-BLE-IDS-003")
fn test_a_tbr_is_set_changed_and_cancelled_inside_the_limits()
    // IDS/SEN/CCP/BV-14-C and BV-16-C.
    var dev = setup()
    var cmd = fresh_command()
    let (s0, hs, ch, config) = rig(ALL_FEATURES, dev)
    var s = s0
    let absolute = [0x02, 0x33, 0x0C, 0xF0, 60, 0, 0x3C]
    var out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_CANCEL_TBR_ADJUSTMENT, []))
    test.assert_eq(indicated(out), code_of(CMD_CANCEL_TBR_ADJUSTMENT, 0x74))
    confirm(var s)
    // Change TBR with no TBR active does not apply; a new TBR does.
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_TBR_ADJUSTMENT, [0x06, 0x33, 0x0C, 0xF0, 60, 0, 0x3C]))
    test.assert_eq(indicated(out), code_of(CMD_SET_TBR_ADJUSTMENT, 0x74))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_TBR_ADJUSTMENT, absolute))
    test.assert_eq(indicated(out), code_of(CMD_SET_TBR_ADJUSTMENT, 0x0F))
    test.assert(dev.basal.tbr_present)
    test.assert_eq(dev.basal.tbr_type, insulin_delivery.TBR_ABSOLUTE)
    test.assert_eq(dev.basal.tbr_programmed, 60)
    test.assert_eq(dev.basal.tbr_remaining, 60)
    test.assert_eq(dev.basal.context, 0x3C)
    // A new TBR over an active one does not apply; changing it does.
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_TBR_ADJUSTMENT, absolute))
    test.assert_eq(indicated(out), code_of(CMD_SET_TBR_ADJUSTMENT, 0x74))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_TBR_ADJUSTMENT, [0x06, 0x3C, 0x02, 0x00, 30, 0, 0x33]))
    test.assert_eq(indicated(out), code_of(CMD_SET_TBR_ADJUSTMENT, 0x0F))
    test.assert_eq(dev.basal.tbr_type, insulin_delivery.TBR_RELATIVE)
    test.assert_eq(dev.basal.tbr_programmed, 30)
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_CANCEL_TBR_ADJUSTMENT, []))
    test.assert_eq(indicated(out), code_of(CMD_CANCEL_TBR_ADJUSTMENT, 0x0F))
    test.assert(not dev.basal.tbr_present)
    // Invalid: Undetermined, a type the Features lack, a template, the wrong size, an RFU flag, a bad context.
    let invalid = [
        [0x00, 0x0F, 0x0C, 0xF0, 60, 0], [0x00, 0x55, 0x0C, 0xF0, 60, 0], [0x00, 0x33, 0x0C, 0xF0, 60], [0x08, 0x33, 0x0C, 0xF0, 60, 0],
        [0x02, 0x33, 0x0C, 0xF0, 60, 0, 0x34], [0x00, 0x33, 0xFF, 0x07, 60, 0]]
    for operand in invalid
        confirm(var s)
        out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_TBR_ADJUSTMENT, operand))
        test.assert_eq(indicated(out), code_of(CMD_SET_TBR_ADJUSTMENT, 0x71))
    // Out of range: a duration of 0 or past 1440, a value past the limit (5.000 IU/h).
    for operand in [[0x00, 0x33, 0x0C, 0xF0, 0, 0], [0x00, 0x33, 0x0C, 0xF0, 0xA1, 0x05], [0x00, 0x33, 0x06, 0x00, 60, 0]]
        confirm(var s)
        out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_TBR_ADJUSTMENT, operand))
        test.assert_eq(indicated(out), code_of(CMD_SET_TBR_ADJUSTMENT, 0x73))
    // A template that is not configured (none is) does not apply.
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_TBR_ADJUSTMENT, [0x01, 0x33, 0x0C, 0xF0, 60, 0, 2]))
    test.assert_eq(indicated(out), code_of(CMD_SET_TBR_ADJUSTMENT, 0x74))

@test
@satisfies("REQ-BLE-IDS-003")
fn test_a_bolus_is_set_with_a_new_id_cancelled_and_limited_by_the_types_available()
    // IDS/SEN/CCP/BV-19-C, BV-21-C, BV-22-C and CCPE/BI-07-C.
    var dev = setup()
    var cmd = fresh_command()
    let (s0, hs, ch, config) = rig(ALL_FEATURES, dev)
    var s = s0
    var out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_GET_AVAILABLE_BOLUSES, []))
    test.assert_eq(indicated(out), wire.octets([0xB4, 0x11, 0x07]))
    confirm(var s)
    // A fast bolus of 2.0 IU: Flags 0, Fast, fast amount 2, extended 0, duration 0.
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_BOLUS, [0x00, 0x33, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00]))
    test.assert_eq(indicated(out), wire.octets([0x77, 0x11, 0x01, 0x00]))
    test.assert_eq(list.len(dev.boluses), 1)
    test.assert_eq(dev.boluses[0].id, 1)
    test.assert_eq(dev.boluses[0].bolus_type, insulin_delivery.BOLUS_TYPE_FAST)
    test.assert_eq(dev.boluses[0].remaining.fast, wire.sfloat(2, 0))
    test.assert_eq(dev.changed & insulin_delivery.CHANGED_ACTIVE_BOLUS_STATUS, insulin_delivery.CHANGED_ACTIVE_BOLUS_STATUS)
    // The next bolus has the next ID; an extended bolus with a delay, a template-less activation type.
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_BOLUS, [0x05, 0x3C, 0x00, 0x00, 0x03, 0x00, 60, 0, 10, 0, 0x33]))
    test.assert_eq(indicated(out), wire.octets([0x77, 0x11, 0x02, 0x00]))
    test.assert_eq(dev.boluses[1].programmed.delay, 10)
    test.assert_eq(dev.boluses[1].activation, 0x33)
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_CANCEL_BOLUS, [0x01, 0x00]))
    test.assert_eq(indicated(out), wire.octets([0x87, 0x11, 0x01, 0x00]))
    test.assert_eq(list.len(dev.boluses), 1)
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_CANCEL_BOLUS, [0x01, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_CANCEL_BOLUS, 0x74))
    // A type that is not available is Maximum Bolus Number reached; the three types are the product's.
    ids_command_set_available(var cmd, AVAILABLE_FAST | AVAILABLE_MULTIWAVE)
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_BOLUS, [0x00, 0x3C, 0x00, 0x00, 0x03, 0x00, 60, 0]))
    test.assert_eq(indicated(out), code_of(CMD_SET_BOLUS, 0x76))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_GET_AVAILABLE_BOLUSES, []))
    test.assert_eq(indicated(out), wire.octets([0xB4, 0x11, 0x05]))

@test
@satisfies("REQ-BLE-IDS-003")
fn test_a_bolus_that_breaks_a_rule_is_refused_with_the_code_of_the_rule()
    var dev = setup()
    var cmd = fresh_command()
    let (s0, hs, ch, config) = rig(ALL_FEATURES, dev)
    var s = s0
    // Invalid Operand: Undetermined or reserved type, an extended part on a fast bolus, a fast part on an extended
    // one, a duration on a fast bolus, the wrong size, a reserved Flag and an activation type that is not defined.
    let invalid = [
        [0x00, 0x0F, 0x02, 0x00, 0, 0, 0, 0], [0x00, 0x34, 0x02, 0x00, 0, 0, 0, 0], [0x00, 0x33, 0x02, 0x00, 0x01, 0x00, 0, 0],
        [0x00, 0x3C, 0x02, 0x00, 0x01, 0x00, 60, 0], [0x00, 0x33, 0x02, 0x00, 0, 0, 5, 0], [0x00, 0x33, 0x02, 0x00, 0, 0, 0],
        [0x20, 0x33, 0x02, 0x00, 0, 0, 0, 0], [0x04, 0x33, 0x02, 0x00, 0, 0, 0, 0, 0x34], [0x00, 0x33, 0xFF, 0x07, 0, 0, 0, 0]]
    for operand in invalid
        confirm(var s)
        let out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_BOLUS, operand))
        test.assert_eq(indicated(out), code_of(CMD_SET_BOLUS, 0x71))
    // Out of range: more than the maximum bolus (10 IU), a duration past 480, a delay past 60.
    for operand in [[0x00, 0x33, 0x0B, 0x00, 0, 0, 0, 0], [0x00, 0x3C, 0x00, 0x00, 0x01, 0x00, 0xE1, 0x01], [0x01, 0x33, 0x01, 0x00, 0, 0, 0, 0, 61, 0]]
        confirm(var s)
        let out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_BOLUS, operand))
        test.assert_eq(indicated(out), code_of(CMD_SET_BOLUS, 0x73))
    // A bolus template that is not configured does not apply.
    confirm(var s)
    let templated = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_BOLUS, [0x02, 0x33, 0x01, 0x00, 0, 0, 0, 0, 3]))
    test.assert_eq(indicated(templated), code_of(CMD_SET_BOLUS, 0x74))
    test.assert_eq(list.len(dev.boluses), 0)
    // A pump without the delay, the template or the activation type takes none of them.
    let thin_features = insulin_delivery.FEATURE_FAST_BOLUS
    var thin_dev = insulin_delivery.new_ids_device(thin_features)
    var thin = fresh_command()
    let (ts0, ths, tch, tconfig) = rig(thin_features, thin_dev)
    var ts = ts0
    for operand in [[0x01, 0x33, 0x01, 0x00, 0, 0, 0, 0, 1, 0], [0x02, 0x33, 0x01, 0x00, 0, 0, 0, 0, 1], [0x04, 0x33, 0x01, 0x00, 0, 0, 0, 0, 0x33], [0x00, 0x3C, 0x00, 0x00, 0x01, 0x00, 1, 0]]
        confirm(var ts)
        let out = write_command(var ts, var thin_dev, var thin, ths, tch, tconfig, command(CMD_SET_BOLUS, operand))
        test.assert_eq(indicated(out), code_of(CMD_SET_BOLUS, 0x71))

@test
@satisfies("REQ-BLE-IDS-003")
fn test_priming_the_fill_level_the_operation_time_and_the_maximum_bolus()
    // IDS/SEN/CCP/BV-29-C to BV-33-C and CCPE/BI-04-C.
    var dev = setup()
    var cmd = fresh_command()
    let (s0, hs, ch, config) = rig(ALL_FEATURES, dev)
    var s = s0
    var out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_STOP_PRIMING, []))
    test.assert_eq(indicated(out), code_of(CMD_STOP_PRIMING, 0x74))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_START_PRIMING, [0x05, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_START_PRIMING, 0x0F))
    test.assert_eq(dev.operational, insulin_delivery.OPERATIONAL_PRIMING)
    test.assert(cmd.priming)
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_START_PRIMING, [0x05, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_START_PRIMING, 0x74))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_STOP_PRIMING, []))
    test.assert_eq(indicated(out), code_of(CMD_STOP_PRIMING, 0x0F))
    test.assert(not cmd.priming)
    // Priming is out of range at 0 and past the limit, and does not apply while the therapy runs.
    for operand in [[0x00, 0x00], [0x0B, 0x00]]
        confirm(var s)
        out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_START_PRIMING, operand))
        test.assert_eq(indicated(out), code_of(CMD_START_PRIMING, 0x73))
    test.assert(insulin_delivery.ids_set_therapy_control_state(var dev, insulin_delivery.THERAPY_RUN))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_START_PRIMING, [0x05, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_START_PRIMING, 0x74))
    // The fill level: 200 IU, past the limit, and with no reservoir.
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, [0xC8, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, 0x0F))
    test.assert_eq(dev.reservoir, 0x00C8)
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, [0xFF, 0x07]))
    test.assert_eq(indicated(out), code_of(CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, 0x71))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, [0x00, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, 0x0F))
    test.assert(insulin_delivery.ids_set_reservoir(var dev, false, 0))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, [0xC8, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_SET_INITIAL_RESERVOIR_FILL_LEVEL, 0x74))
    // Reset Reservoir Insulin Operation Time: Remaining to the default, Elapsed to 0.
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_RESET_RESERVOIR_INSULIN_OPERATION_TIME, []))
    test.assert_eq(indicated(out), code_of(CMD_RESET_RESERVOIR_INSULIN_OPERATION_TIME, 0x0F))
    test.assert_eq(dev.counter_values[7], 0)
    test.assert_eq(dev.counter_values[6], 10080)
    // The maximum bolus is read and set; 0 and a value past the limit are out of range.
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_GET_MAX_BOLUS_AMOUNT, []))
    test.assert_eq(indicated(out), wire.octets([0x82, 0x14, 0x0A, 0x00]))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_MAX_BOLUS_AMOUNT, [0x14, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_SET_MAX_BOLUS_AMOUNT, 0x0F))
    test.assert_eq(cmd.max_bolus, 20)
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_MAX_BOLUS_AMOUNT, [0x1A, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_SET_MAX_BOLUS_AMOUNT, 0x73))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_MAX_BOLUS_AMOUNT, [0x00, 0x00]))
    test.assert_eq(indicated(out), code_of(CMD_SET_MAX_BOLUS_AMOUNT, 0x73))
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, command(CMD_SET_MAX_BOLUS_AMOUNT, [0xFF, 0x07]))
    test.assert_eq(indicated(out), code_of(CMD_SET_MAX_BOLUS_AMOUNT, 0x71))

@test
@satisfies("REQ-BLE-IDS-003")
fn test_a_write_is_refused_before_it_is_accepted_without_the_descriptor_during_a_procedure_and_with_a_bad_counter()
    // IDS/SEN/CBE/BI-01-C, BI-03-C, BI-05-C, BI-06-C for the Command Control Point.
    let features = ALL_FEATURES | 1
    var dev = insulin_delivery.new_ids_device(features)
    var cmd = fresh_command()
    let config = insulin_delivery.IdsConfig {
        access: gatt_server.Access.Authenticated, features: features, concentration: wire.sfloat(100, 0), features_indicate: false,
        get_counter: false, get_delivered: false }
    var built = insulin_delivery.server(config, dev)
    var s = built.0
    let hs = built.1
    let ch = add_ids_command(var s.db, config, var dev)!
    let op = CMD_SET_FLIGHT_MODE
    var out = write_command(var s, var dev, var cmd, hs, ch, config, insulin_delivery.request(features, op, [], 1))
    test.assert_eq(out[0][4], 0xFD)
    subscribe(var s, ch.control_cccd as Int, 2)
    out = write_command(var s, var dev, var cmd, hs, ch, config, insulin_delivery.request(features, op, [], 2))
    test.assert_eq(out[0][4], insulin_delivery.ERR_INVALID_COUNTER)
    var bad = insulin_delivery.request(features, op, [], 1)
    bad[list.len(bad) - 1] = 0
    out = write_command(var s, var dev, var cmd, hs, ch, config, bad)
    test.assert_eq(out[0][4], insulin_delivery.ERR_INVALID_CRC)
    out = write_command(var s, var dev, var cmd, hs, ch, config, insulin_delivery.request(features, op, [], 1))
    test.assert_eq(out[0], [0x13])
    // The response has the counter and the CRC; until it is confirmed a second procedure is refused, on either control point.
    let reply = out[1][3:]
    test.assert_eq(reply[0:5], code_of(op, 0x0F)[0:5])
    test.assert_eq(reply[5], 1)
    out = write_command(var s, var dev, var cmd, hs, ch, config, insulin_delivery.request(features, op, [], 2))
    test.assert_eq(out[0][4], 0xFE)
    subscribe(var s, hs.reader_cccd as Int, 2)
    out = insulin_delivery.write_reader(var s, var dev, hs, config, insulin_delivery.request(features, insulin_delivery.SR_GET_TOTAL_DAILY_INSULIN_STATUS, [], 1))
    test.assert_eq(out[0][4], 0xFE)
    confirm(var s)
    out = write_command(var s, var dev, var cmd, hs, ch, config, insulin_delivery.request(features, op, [], 2))
    test.assert_eq(out[0], [0x13])
    // A write without an Op Code is a bad attribute length (no E2E here).
    var plain_dev = setup()
    var plain_cmd = fresh_command()
    let (ps0, phs, pch, pconfig) = rig(ALL_FEATURES, plain_dev)
    var ps = ps0
    out = write_command(var ps, var plain_dev, var plain_cmd, phs, pch, pconfig, [0x5A])
    test.assert_eq(out[0][4], 0x0D)

@tier(app)
fn setup_e2e(features: Int) -> insulin_delivery.IdsDevice
    insulin_delivery.new_ids_device(features)

@tier(app)
fn add_error(config: insulin_delivery.IdsConfig) -> ?profile_builder.ProfileError
    let dev = insulin_delivery.new_ids_device(config.features)
    var built = insulin_delivery.server(insulin_delivery.default_ids_config(), dev)
    var d = dev
    match add_ids_command(var built.0.db, config, var d)
        Ok(_) => None
        Err(e) => Some(e)

@test
@satisfies("REQ-BLE-IDS-003")
fn test_the_command_point_needs_authentication()
    let encrypted = insulin_delivery.IdsConfig {
        access: gatt_server.Access.Encrypted, features: 0, concentration: wire.sfloat(100, 0), features_indicate: false, get_counter: false, get_delivered: false }
    test.assert_eq(add_error(encrypted), Some(profile_builder.ProfileError.NotPermitted))
    test.assert_eq(add_error(insulin_delivery.default_ids_config()), None)
